        "custom_liquid_iq83WQ": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n    .custom-shipping-container {\n        display: flex;\n        flex-wrap: wrap; /* Zorgt ervoor dat het netjes blijft op kleine schermen */\n        padding: 5px 16px;\n        justify-content: space-between;\n        height: 38px;\n        align-items: center;\n        align-self: stretch;\n        background-color: #f6f6f6;\n        border: 1px solid #d9d9d9;\n        border-radius: 20px;\n        margin-bottom: 20px;\n        max-width: 600px; /* Max breedte op desktop */\n        margin-left: auto;\n        margin-right: auto;\n    }\n\n    .custom-shipping-item {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n    }\n\n    .custom-shipping-item:first-child {\n        justify-content: flex-start;\n        flex: 1; /* Laat de eerste item de linkerzijde vullen */\n    }\n\n    .custom-shipping-item:last-child {\n        justify-content: flex-end; /* Zet \"GRATIS verzending!\" naar rechts */\n        flex: 1; /* Laat de tweede item de rechterzijde vullen */\n        text-align: right;\n    }\n\n    .text-block-shipping {\n        font-size: 12px;\n        color: #000;\n        white-space: nowrap; /* Voorkomt dat tekst afbreekt op desktop */\n    }\n\n    .shipping-date {\n        font-weight: bold;\n    }\n\n    .countdown {\n        font-weight: bold;\n        color: #d9534f; /* Rode kleur voor urgentie */\n        animation: fade 1s ease-in-out infinite; /* Laat de tijd knipperen */\n        margin-left: 5px; /* Extra spatie tussen datum en tijd */\n    }\n\n    .free-shipping {\n        font-weight: bold;\n    }\n\n    .green-circle {\n        animation: fade 1s ease-in-out infinite;\n    }\n\n    @keyframes fade {\n        0%, 100% { opacity: 1; }\n        50% { opacity: 0.5; }\n    }\n\n    /* Media query voor kleinere schermen */\n    @media screen and (max-width: 480px) {\n        .custom-shipping-container {\n            flex-direction: column; /* Zet items onder elkaar op mobiel */\n            text-align: center;\n            padding: 8px 12px;\n            height: auto; /* Verwijder de vaste hoogte */\n            max-width: 100%; /* Zorgt ervoor dat de container past binnen het scherm */\n        }\n        \n        .custom-shipping-item {\n            justify-content: center;\n            width: 100%; /* Laat beide items de volledige breedte gebruiken */\n            margin-bottom: 5px;\n        }\n\n        .custom-shipping-item:first-child {\n            order: 1; /* Zet de datum bovenaan */\n            margin-bottom: 10px; /* Extra ruimte tussen datum en 'gratis verzending' */\n        }\n\n        .custom-shipping-item:last-child {\n            order: 2; /* Zet 'gratis verzending' onder de datum */\n            text-align: center;\n            justify-content: center;\n        }\n\n        .text-block-shipping {\n            font-size: 11px; /* Iets kleinere tekst op mobiel */\n            white-space: normal; /* Staat afbreken van de tekst toe */\n        }\n    }\n</style>\n\n<div class=\"custom-shipping-container\">\n    <div class=\"custom-shipping-item\">\n        <svg class=\"green-circle\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12\" height=\"13\" viewBox=\"0 0 12 13\" fill=\"none\">\n            <circle cx=\"6\" cy=\"6.5\" r=\"6\" fill=\"#137333\"></circle>\n        </svg>\n        <div class=\"text-block-shipping\">\n            Verzonden op:\n            <!-- Hier draai je vertaling uit voor de dynamische datum en tijd -->\n            <span id=\"shipping-date\" class=\"shipping-date\" translate=\"no\" data-wg-notranslate></span>\n            <span id=\"countdown\" class=\"countdown\" translate=\"no\" data-wg-notranslate></span>\n        </div>\n    </div>\n    <div class=\"custom-shipping-item\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-box\" viewBox=\"0 0 16 16\">\n            <path d=\"M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z\"/>\n        </svg>\n        <div class=\"text-block-shipping\">\n            <span class=\"free-shipping\">GRATIS</span> verzending!\n        </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        function updateShippingDate() {\n            var daysAfterToday = 0;\n            var now = new Date();\n\n            // Controleer of het na 12:00 uur is, dan wordt het de volgende werkdag\n            if (now.getHours() >= 12) {\n                daysAfterToday += 1;\n            }\n\n            var shipDate = new Date();\n            shipDate.setDate(shipDate.getDate() + daysAfterToday);\n\n            // Skip weekends (zaterdag = 6, zondag = 0)\n            while (shipDate.getDay() === 6 || shipDate.getDay() === 0) {\n                shipDate.setDate(shipDate.getDate() + 1);\n            }\n\n            var options = { weekday: 'short', month: 'short', day: 'numeric' };\n            var formattedDate = shipDate.toLocaleDateString('nl-NL', options);\n\n            document.getElementById('shipping-date').textContent = formattedDate;\n\n            // Start de countdown voor deze datum\n            startCountdown(shipDate);\n        }\n\n        function startCountdown(shipDate) {\n            var cutoffTime = new Date(shipDate);\n            cutoffTime.setHours(12, 0, 0, 0); // Deadline: 12:00 uur\n\n            function updateTimer() {\n                var now = new Date();\n                var timeLeft = cutoffTime - now;\n\n                if (timeLeft <= 0) {\n                    document.getElementById(\"countdown\").textContent = \"Verzending vandaag gesloten\";\n                    clearInterval(timerInterval);\n                    return;\n                }\n\n                var hours = Math.floor(timeLeft / (1000 * 60 * 60));\n                var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));\n\n                document.getElementById(\"countdown\").textContent = hours + \"u \" + minutes + \"m\";\n            }\n\n            // Start de timer en update elke seconde\n            updateTimer();\n            var timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        updateShippingDate();\n    });\n</script>"
          }
        },

            "custom_liquid": "<form id=\"uploadForm\" enctype=\"multipart/form-data\">\n  <input type=\"file\" name=\"image\" accept=\"image/*\" required />\n  <button type=\"submit\">Maak cartoon</button>\n</form>\n<img id=\"resultImage\" style=\"margin-top:20px; display:none;\" />\n\n<script>\n  document.getElementById('uploadForm').addEventListener('submit', async (e) => {\n    e.preventDefault();\n    const formData = new FormData(e.target);\n\n    const response = await fetch('https://jouw-backend-url.com/generate-cartoon', {\n      method: 'POST',\n      body: formData\n    });\n\n    const data = await response.json();\n    document.getElementById('resultImage').src = data.cartoonUrl;\n    document.getElementById('resultImage').style.display = 'block';\n  });\n</script>"

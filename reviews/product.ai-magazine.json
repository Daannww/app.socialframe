g: <span id=\"shipping-date\" class=\"shipping-date\"></span>\n            <span id=\"countdown\" class=\"countdown\"></span>\n        </div>\n    </div>\n    <div class=\"custom-shipping-item\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg>\n        <div class=\"text-block-shipping\">\n            <span class=\"free-shipping\">Gratis verzending</span>\n        </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        function updateShippingInfo() {\n            const now = new Date();\n            let shipDate = new Date();\n            \n            // Deadline: 12:00 uur\n            if (now.getHours() >= 12) shipDate.setDate(shipDate.getDate() + 1);\n\n            // Sla weekenden over\n            while (shipDate.getDay() === 0 || shipDate.getDay() === 6) {\n                shipDate.setDate(shipDate.getDate() + 1);\n            }\n\n            const options = { weekday: 'short', month: 'short', day: 'numeric' };\n            document.getElementById('shipping-date').textContent = shipDate.toLocaleDateString('nl-NL', options);\n\n            const cutoff = new Date(shipDate);\n            cutoff.setHours(12, 0, 0, 0);\n\n            function timer() {\n                const diff = cutoff - new Date();\n                if (diff <= 0) {\n                    document.getElementById(\"countdown\").textContent = \"Vandaag gesloten\";\n                    return;\n                }\n                const h = Math.floor(diff / 3600000);\n                const m = Math.floor((diff % 3600000) / 60000);\n                document.getElementById(\"countdown\").textContent = `Nog ${h}u ${m}m`;\n            }\n            setInterval(timer, 1000);\n            timer();\n        }\n        updateShippingInfo();\n    });\n</script>"
          }

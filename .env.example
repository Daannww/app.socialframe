# Kopieer dit bestand naar ".env" en vul je eigen gegevens in

# --- Shopify ---
# Jouw winkel domein, bv: mijnwinkel.myshopify.com
SHOPIFY_STORE=mijnwinkel.myshopify.com

# Admin API access token (Shopify Admin -> Apps -> App ontwikkelen -> Custom app -> Admin API access token)
# Nodig scope: read_orders
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxx

# API versie
SHOPIFY_API_VERSION=2024-10

# --- Server login ---
# Admin-account: volledige toegang, inclusief drukwerkbestanden downloaden.
AUTH_USER=admin
AUTH_PASS=verander-dit-wachtwoord

# Pakbon-account: voor bv. de computer waarop alleen pakbonnen worden geprint.
# Kan orders bekijken, pakbonnen printen en statussen wijzigen, maar NIET bij
# de drukwerkbestanden (PDF) komen — die knop is dan verborgen, en de
# bijbehorende functies zijn ook aan de serverkant geblokkeerd.
PAKBON_USER=pakbon
PAKBON_PASS=verander-dit-ook

# Optioneel: een willekeurige lange tekst voor het beveiligen van login-sessies.
# Zonder deze regel wordt er bij elke herstart van de server automatisch een
# nieuwe gegenereerd, waardoor iedereen na een herstart opnieuw moet inloggen.
# Vul je zelf iets in (bv. een lange willekeurige tekenreeks), dan blijft
# iedereen ook na een herstart tot 7 dagen ingelogd.
SESSION_SECRET=

# --- Server ---
PORT=3000

# Hoe ver terug te kijken bij de allereerste sync (in dagen)
INITIAL_SYNC_DAYS=30

# Hoeveel dagen orders bewaard blijven in de lokale database voordat ze
# automatisch worden opgeruimd (elke nacht om 03:00, en 1x bij opstarten)
ORDER_RETENTION_DAYS=30

# --- Trustpilot-review-mail ---
# Gratis account aanmaken op https://resend.com, je eigen domein verifiëren
# (paar DNS-records toevoegen), en daar een API-key aanmaken.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Van welk adres de review-mail verstuurd wordt (moet op een geverifieerd
# domein bij Resend staan)
REVIEW_EMAIL_FROM=Socialframe <info@socialframe.nl>

# De link naar jullie Trustpilot-reviewpagina, bv:
# https://nl.trustpilot.com/evaluate/socialframe.nl
TRUSTPILOT_REVIEW_URL=

# Hoeveel dagen na het op "verzonden" zetten van een order de review-mail
# verstuurd wordt (elke dag om 10:00 gecontroleerd)
REVIEW_EMAIL_DELAY_DAYS=5


<style>
  .sfr{background:#faf6ee;margin-top:40px}
  .sfr-in{max-width:1440px;margin:0 auto;padding:88px 64px;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);column-gap:72px;align-items:center}
  .sfr-sum{display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .sfr-eb{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#8a7a5f}
  .sfr-score{display:flex;align-items:baseline;gap:10px;color:#151412}
  .sfr-score b{font-size:84px;line-height:.9;font-weight:700;letter-spacing:-.05em}
  .sfr-score span{font-size:22px;font-weight:600;color:#8a7a5f}
  .sfr-stars{display:flex;gap:4px}
  .sfr-stars svg{width:22px;height:22px;fill:#e0a25a;display:block}
  .sfr-stars.sm svg{width:16px;height:16px}
  .sfr-stars svg.off{fill:#e4dccb}
  .sfr-sum p{margin:0;font-size:16px;line-height:1.6;color:#4a4238}
  .sfr-link{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 26px;border-radius:999px;background:#151412;color:#fff!important;font-size:15px;font-weight:600;text-decoration:none!important;transition:background .2s ease}
  .sfr-link:hover{background:#000}
  .sfr-ctrl{display:flex;gap:10px;margin-top:6px}
  .sfr-ctrl button{width:48px;height:48px;border-radius:50%;border:1px solid #d9c9a8;background:#fff;color:#151412;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;transition:background .2s ease,border-color .2s ease}
  .sfr-ctrl button:hover{background:#151412;border-color:#151412;color:#fff}
  .sfr-ctrl button[disabled]{opacity:.35;pointer-events:none}
  .sfr-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:4px 0 4px;margin:0;list-style:none}
  .sfr-track::-webkit-scrollbar{display:none}
  .sfr-card{flex:0 0 calc((100% - 20px) / 2);min-width:0;scroll-snap-align:start;background:#fff;border-radius:24px;padding:32px;box-sizing:border-box;display:flex;flex-direction:column;gap:16px;margin:0;min-height:340px}
  .sfr-card::before{content:none!important}
  .sfr-card h3{margin:0;font-size:20px;line-height:1.25;font-weight:700;letter-spacing:-.01em;color:#151412}
  .sfr-card p{margin:0;font-size:15px;line-height:1.65;color:#4a4238;display:-webkit-box;-webkit-line-clamp:7;-webkit-box-orient:vertical;overflow:hidden}
  .sfr-by{margin-top:auto;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600;color:#151412}
  .sfr-av{width:36px;height:36px;border-radius:50%;background:#f2c48a;color:#151412;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex:none}
  .sfr-by small{display:block;font-size:12px;font-weight:500;color:#8a7a5f;margin-top:2px}
  @media (max-width:1279px){.sfr-in{padding:72px 32px;column-gap:48px;grid-template-columns:minmax(0,280px) minmax(0,1fr)}.sfr-card{flex-basis:calc(100% - 40px)}}
  @media (max-width:989px){
    .sfr{margin-top:24px}
    .sfr-in{grid-template-columns:1fr;row-gap:32px;padding:48px 16px}
    .sfr-score b{font-size:64px}
    .sfr-ctrl{display:none}
    .sfr-track{margin:0 -16px;padding:4px 16px;scroll-padding-left:16px}
    .sfr-card{flex-basis:84%;padding:26px;min-height:300px}
  }
</style>
{%- liquid
  assign rating = section.settings.rating | default: 4.6
  assign full = rating | floor
-%}
<section class="sfr" {{ section.shopify_attributes }}>
  <div class="sfr-in">
    <div class="sfr-sum">
      {%- if section.settings.eyebrow != blank -%}<span class="sfr-eb">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <div class="sfr-score"><b>{{ rating }}</b><span>/ 5</span></div>
      <div class="sfr-stars" aria-label="{{ rating }} van 5 sterren">
        {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="{% if i > full %}off{% endif %}" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.1L12 17.6 5.8 21.3l1.6-7.1L2 9.5l7.1-.6z"/></svg>{%- endfor -%}
      </div>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="sfr-link" href="{{ section.settings.button_url }}" target="_blank" rel="noopener">{{ section.settings.button_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
      <div class="sfr-ctrl">
        <button type="button" aria-label="Vorige" data-sfr-prev><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" aria-label="Volgende" data-sfr-next><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <ul class="sfr-track" data-sfr-track>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="sfr-card" {{ block.shopify_attributes }}>
          <div class="sfr-stars sm" aria-label="{{ b.stars_count }} van 5 sterren">
            {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="{% if i > b.stars_count %}off{% endif %}" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.1L12 17.6 5.8 21.3l1.6-7.1L2 9.5l7.1-.6z"/></svg>{%- endfor -%}
          </div>
          {%- if b.heading != blank -%}<h3>{{ b.heading }}</h3>{%- endif -%}
          <p>{{ b.text }}</p>
          <div class="sfr-by"><span class="sfr-av">{{ b.author | strip | slice: 0 | upcase }}</span><span>{{ b.author }}</span></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
<script>
  (function () {
    var root = document.currentScript.previousElementSibling; if (!root) return;
    var t = root.querySelector('[data-sfr-track]'), p = root.querySelector('[data-sfr-prev]'), n = root.querySelector('[data-sfr-next]');
    if (!t) return;
    function step() { var c = t.querySelector('.sfr-card'); return c ? c.getBoundingClientRect().width + 20 : 300; }
    function upd() { if (p) p.disabled = t.scrollLeft < 8; if (n) n.disabled = t.scrollLeft + t.clientWidth >= t.scrollWidth - 8; }
    if (p) p.addEventListener('click', function () { t.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (n) n.addEventListener('click', function () { t.scrollBy({ left: step(), behavior: 'smooth' }); });
    t.addEventListener('scroll', upd, { passive: true }); window.addEventListener('resize', upd); upd();
  })();
</script>

{% schema %}
{
  "name": "SocialFrame reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Klein label", "default": "Reviews" },
    { "type": "range", "id": "rating", "min": 3, "max": 5, "step": 0.1, "label": "Score", "default": 4.6 },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Meer dan 400 klanten beoordeelden ons op Trustpilot." },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Bekijk alle reviews" },
    { "type": "url", "id": "button_url", "label": "Knoplink" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "stars_count", "min": 1, "max": 5, "step": 1, "label": "Sterren", "default": 5 },
      { "type": "text", "id": "heading", "label": "Titel" },
      { "type": "textarea", "id": "text", "label": "Tekst" },
      { "type": "text", "id": "author", "label": "Naam" }
    ] }
  ],
  "presets": [ { "name": "SocialFrame reviews" } ]
}
{% endschema %}

<style>
  .sfu{max-width:1440px;margin:0 auto;padding:56px 64px;box-sizing:border-box}
  .sfu-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-top:1px solid #ebe8e1;border-bottom:1px solid #ebe8e1}
  .sfu-item{padding:36px 32px;display:flex;flex-direction:column;gap:14px;border-left:1px solid #ebe8e1}
  .sfu-item:first-child{border-left:0;padding-left:0}
  .sfu-ic{width:48px;height:48px;border-radius:50%;background:#faf1df;display:flex;align-items:center;justify-content:center;color:#151412}
  .sfu-ic svg{width:24px;height:24px}
  .sfu-t{margin:0;font-size:17px;font-weight:700;letter-spacing:-.01em;color:#151412}
  .sfu-c{margin:0;font-size:14px;line-height:1.6;color:#4a4238}
  @media (max-width:1279px){.sfu{padding:48px 32px}.sfu-item{padding:28px 22px}}
  @media (max-width:989px){
    .sfu{padding:32px 16px}
    .sfu-grid{grid-template-columns:1fr 1fr;border-bottom:0}
    .sfu-item{padding:22px 16px;border-left:0;border-bottom:1px solid #ebe8e1}
    .sfu-item:nth-child(even){border-left:1px solid #ebe8e1}
    .sfu-item:first-child{padding-left:16px}
    .sfu-t{font-size:15px}.sfu-c{font-size:13px}
  }
</style>
<section class="sfu" {{ section.shopify_attributes }}>
  <div class="sfu-grid">
    {%- for block in section.blocks -%}
      <div class="sfu-item" {{ block.shopify_attributes }}>
        <span class="sfu-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            {%- case block.settings.icon -%}
              {%- when 'delivery' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
              {%- when 'made' -%}<path d="M3 10l9-6 9 6v9a1 1 0 01-1 1H4a1 1 0 01-1-1z"/><path d="M9 20v-6h6v6"/>
              {%- when 'pay' -%}<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/>
              {%- when 'star' -%}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
              {%- when 'heart' -%}<path d="M12 20s-7-4.4-9-9.2C1.8 7.6 4 4.5 7 4.5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3 0 5.2 3.1 4 6.3-2 4.8-9 9.2-9 9.2z"/>
              {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
            {%- endcase -%}
          </svg>
        </span>
        <h3 class="sfu-t">{{ block.settings.title }}</h3>
        <p class="sfu-c">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SocialFrame USP's",
  "blocks": [
    { "type": "usp", "name": "USP", "settings": [
      { "type": "select", "id": "icon", "label": "Icoon", "default": "check", "options": [
        { "value": "delivery", "label": "Bezorging" }, { "value": "made", "label": "Gemaakt in NL" }, { "value": "pay", "label": "Betalen" },
        { "value": "star", "label": "Ster" }, { "value": "heart", "label": "Hart" }, { "value": "check", "label": "Vinkje" } ] },
      { "type": "text", "id": "title", "label": "Titel" },
      { "type": "textarea", "id": "text", "label": "Tekst" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "SocialFrame USP's" } ]
}
{% endschema %}

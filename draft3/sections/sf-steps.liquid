{%- comment -%} Hoe werkt het — genummerde stappen {%- endcomment -%}
<style>
  .sfs{max-width:1180px;margin:0 auto;padding:72px 24px 56px;color:#151412}
  .sfs-h{text-align:center;margin:0 0 44px}
  .sfs-k{display:block;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#a07a2c;margin-bottom:10px}
  .sfs-t{font-size:clamp(26px,3.4vw,36px);font-weight:700;letter-spacing:-.01em;margin:0;line-height:1.15}
  .sfs-g{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;position:relative}
  .sfs-c{background:#faf6ee;border-radius:24px;padding:14px 14px 30px;text-align:center;position:relative}
  .sfs-im{position:relative;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#fff}
  .sfs-im img{width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block}
  .sfs-n{position:absolute;top:12px;left:12px;width:38px;height:38px;border-radius:50%;background:#151412;color:#fff;font-weight:700;font-size:16px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(0,0,0,.2)}
  .sfs-ct{font-size:19px;font-weight:700;margin:24px 18px 8px;line-height:1.25}
  .sfs-cp{font-size:15px;line-height:1.6;color:#5c574f;margin:0 22px}
  .sfs-c:not(:last-child)::after{content:"";position:absolute;right:-21px;top:34%;width:14px;height:14px;border-top:2px solid #c9b88f;border-right:2px solid #c9b88f;transform:rotate(45deg)}
  @media(max-width:800px){.sfs{padding:48px 16px 36px}.sfs-g{grid-template-columns:1fr;gap:18px}.sfs-c:not(:last-child)::after{display:none}.sfs-im{aspect-ratio:4/3}}
</style>
<section class="sfs" {{ section.shopify_attributes }}>
  <div class="sfs-h">
    {%- if section.settings.kicker != blank -%}<span class="sfs-k">{{ section.settings.kicker }}</span>{%- endif -%}
    <h2 class="sfs-t">{{ section.settings.title }}</h2>
  </div>
  <div class="sfs-g">
    {%- for block in section.blocks -%}
      <div class="sfs-c" {{ block.shopify_attributes }}>
        <div class="sfs-im">
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}
          <span class="sfs-n">{{ forloop.index }}</span>
        </div>
        <h3 class="sfs-ct">{{ block.settings.title }}</h3>
        <p class="sfs-cp">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Hoe werkt het",
  "settings": [
    {"type":"text","id":"kicker","label":"Klein label","default":"In 3 stappen"},
    {"type":"text","id":"title","label":"Titel","default":"Hoe werkt het?"}
  ],
  "blocks": [
    {"type":"step","name":"Stap","settings":[
      {"type":"image_picker","id":"image","label":"Afbeelding"},
      {"type":"text","id":"title","label":"Titel"},
      {"type":"textarea","id":"text","label":"Tekst"}
    ]}
  ],
  "presets":[{"name":"Hoe werkt het"}]
}
{% endschema %}

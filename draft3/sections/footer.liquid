{%- liquid
  assign shop_menu = linklists[section.settings.menu_shop]
  assign info_menu = linklists['footermenu']
-%}
{%- liquid
  assign lc = request.locale.iso_code
  if lc == 'de'
    assign t_news_title = 'Bleiben Sie auf dem Laufenden'
    assign t_news_text = 'Erfahren Sie als Erste/r von neuen Designs und Rabattcodes.'
    assign t_thanks = 'Vielen Dank für Ihre Anmeldung!'
    assign t_email_ph = 'Ihre E-Mail-Adresse'
    assign t_email_lbl = 'E-Mail-Adresse'
    assign t_sub = 'Anmelden'
    assign t_brand = 'Personalisierte Frames und Fliesen, mit Liebe aus Ihrer Erinnerung gemacht.'
    assign t_service = 'Kundenservice'
    assign t_faq = 'Service &amp; FAQ'
    assign t_ship = 'Versand'
    assign t_ret = 'Rückgabe'
    assign t_contact = 'Kontakt'
    assign t_about = 'Über SocialFrame'
    assign t_cookie = 'Cookie-Einstellungen'
    assign t_pay = 'Zahlungsmöglichkeiten'
  elsif lc == 'en'
    assign t_news_title = 'Stay in the loop'
    assign t_news_text = 'Be the first to get new designs and discount codes in your inbox.'
    assign t_thanks = 'Thanks for signing up!'
    assign t_email_ph = 'Enter your email address'
    assign t_email_lbl = 'Email address'
    assign t_sub = 'Subscribe'
    assign t_brand = 'Personalised frames and tiles, lovingly made from your memory.'
    assign t_service = 'Customer service'
    assign t_faq = 'Service &amp; FAQ'
    assign t_ship = 'Shipping'
    assign t_ret = 'Returns'
    assign t_contact = 'Contact'
    assign t_about = 'About SocialFrame'
    assign t_cookie = 'Cookie settings'
    assign t_pay = 'Payment methods'
  else
    assign t_news_title = section.settings.news_title
    assign t_news_text = section.settings.news_text
    assign t_thanks = '{{ t_thanks }}'
    assign t_email_ph = 'Voer je e-mailadres in'
    assign t_email_lbl = 'E-mailadres'
    assign t_sub = 'Aanmelden'
    assign t_brand = section.settings.brand_text
    assign t_service = 'Klantenservice'
    assign t_faq = 'Service &amp; faq'
    assign t_ship = 'Verzending'
    assign t_ret = 'Retourneren'
    assign t_contact = 'Contact'
    assign t_about = 'Over SocialFrame'
    assign t_cookie = 'Cookie-instellingen'
    assign t_pay = 'Betaalmogelijkheden'
  endif
  assign skip_shop = 'home,startseite,service & faq,service & faq,contact,kontakt,meer,mehr,more' | split: ','
  assign skip_info = 'verzending,retourneren,versenden,versand,widerrufsbelehrung,rückgabe,shipping,returns' | split: ','
-%}

<style>
  /* de losse nieuwsbrief-blokken uit de pagina's vervangen door de nieuwsbrief in deze footer */
  main .shopify-section:has(.card.newsletter){display:none!important}
  .sff{background:#fff;color:#151412;font-family:inherit;margin-top:56px;padding-bottom:0}
  .sff a{color:inherit;text-decoration:none}
  .sff-wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}
  .sff-news{background:#faf1df;border-radius:20px;padding:44px 56px;display:flex;align-items:center;justify-content:space-between;gap:48px}
  .sff-news h2{margin:0 0 8px;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-.01em;color:#151412}
  .sff-news p{margin:0;font-size:15px;line-height:1.5;color:#4a4238}
  .sff-form{display:flex;gap:10px;flex:1;max-width:520px;margin:0}
  .sff-form fieldset{display:flex;gap:10px;flex:1;margin:0;padding:0;border:0;min-width:0}
  .sff-form input[type=email]{flex:1;min-width:0;height:52px;box-sizing:border-box;border:1px solid #d9c9a8!important;border-radius:999px!important;padding:0 24px!important;font-size:15px;font-weight:500;font-family:inherit;background:#fff!important;color:#151412;margin:0;box-shadow:none!important}
  .sff-form button{height:52px;padding:0 30px;border:0;border-radius:999px;background:#151412;color:#fff;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;white-space:nowrap}
  .sff-form button:hover{background:#000}
  .sff-ok{font-size:15px;font-weight:600;margin:0;color:#151412}
  .sff-cols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;column-gap:48px;padding-top:56px;padding-bottom:40px}
  .sff-brand{max-width:300px;display:flex;flex-direction:column;gap:16px}
  .sf-wm{font-family:'Montserrat',system-ui,sans-serif;font-weight:700;font-size:34px;letter-spacing:-.045em;line-height:1;color:#151412;white-space:nowrap}
  .sf-wm sup{font-size:.34em;font-weight:600;letter-spacing:0;margin-left:.12em;position:relative;top:-1.43em;vertical-align:baseline;color:#e0a25a}
  .sff-lg{display:block;height:72px;color:#151412}.sff-lg svg{display:block;height:100%;width:auto}
  .sff-brand img{height:44px;width:auto;display:block;align-self:flex-start}
  .sff-brand p{margin:0;font-size:14px;line-height:1.65;color:#4a4238}
  .sff-social{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
  .sff-social a{border:1px solid #d9c9a8;border-radius:999px;padding:8px 16px;font-size:13px;font-weight:600;color:#151412}
  .sff-social a:hover{background:#faf1df}
  .sff-col{display:flex;flex-direction:column;gap:12px;font-size:14px}
  .sff-col h3{margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8a7a5f}
  .sff-col a{color:#4a4238}
  .sff-col a:hover,.sff-bot a:hover{color:#000;text-decoration:underline;text-underline-offset:4px}
  .sff-bot{border-top:1px solid #e8dcc3;padding:22px 0 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;font-size:13px;color:#6b6252}
  .sff-pay{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;align-items:center;list-style:none;margin:0;padding:0}
  .sff-pay li{display:block;height:22px;margin:0;padding:0}
  .sff-pay li::before{content:none!important}
  .sff-pay svg{display:block;height:100%;width:auto}
  .sff-right{display:flex;align-items:center;gap:20px}
  .sff-right a{color:#6b6252}
  .sff-loc{font-weight:600;color:#151412;position:static!important}
  .sff-loc *{position:static}
  @media (max-width:989px){
    .sff-wrap{padding:0 20px}
    .sff-news{flex-direction:column;align-items:flex-start;gap:24px;padding:32px 24px}
    .sff-form{max-width:none;width:100%}
    .sff-cols{grid-template-columns:1fr 1fr;row-gap:36px;padding-top:40px}
    .sff-brand{grid-column:1/-1;max-width:none}
    .sff-bot{flex-direction:column;align-items:flex-start;gap:18px}
    .sff-pay{justify-content:flex-start}
  }
  @media (max-width:560px){
    .sff-form fieldset{flex-direction:column}
    .sff-form button{width:100%}
  }
</style>

<footer class="sff" data-js-inert {{ section.shopify_attributes }}>
  <div class="sff-wrap">
    <div class="sff-news">
      <div style="max-width:520px">
        <h2>{{ t_news_title }}</h2>
        <p>{{ t_news_text }}</p>
      </div>
      {%- form 'customer', id: 'sff-newsletter', class: 'sff-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="sff-ok">{{ t_thanks }}</p>
        {%- else -%}
          <fieldset>
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="{{ t_email_ph }}" aria-label="{{ t_email_lbl }}" autocorrect="off" autocapitalize="off" required value="{% if customer %}{{ customer.email }}{% endif %}">
            <button type="submit">{{ t_sub }}</button>
          </fieldset>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="sff-cols">
      <div class="sff-brand">
        <span class="sff-lg">{% render 'sf-logo' %}</span>
        <p>{{ t_brand }}</p>
        <div class="sff-social">
          {%- assign u_ig = section.settings.instagram | default: settings.social_instagram -%}{%- if u_ig != blank -%}<a href="{{ u_ig }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- assign u_tt = section.settings.tiktok | default: settings.social_tiktok -%}{%- if u_tt != blank -%}<a href="{{ u_tt }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
          {%- assign u_wa = section.settings.whatsapp | default: settings.social_whatsapp -%}{%- if u_wa != blank -%}<a href="{{ u_wa }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
          {%- assign u_em = section.settings.email | default: 'info@socialframe.nl' -%}<a href="mailto:{{ u_em }}">E-mail</a>
        </div>
      </div>

      <nav class="sff-col" aria-label="Shop">
        <h3>Shop</h3>
        {%- for link in shop_menu.links -%}
          {%- assign t = link.title | downcase -%}
          {%- unless skip_shop contains t -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endunless -%}
        {%- endfor -%}
      </nav>

      <nav class="sff-col" aria-label="{{ t_service }}">
        <h3>{{ t_service }}</h3>
        <a href="{{ routes.root_url }}pages/verzenden">{{ t_faq }}</a>
        <a href="{{ routes.root_url }}pages/verzenden">{{ t_ship }}</a>
        <a href="{{ routes.root_url }}pages/retourneren">{{ t_ret }}</a>
        <a href="{{ routes.root_url }}pages/contact">{{ t_contact }}</a>
      </nav>

      <nav class="sff-col" aria-label="{{ t_about }}">
        <h3>{{ t_about }}</h3>
        {%- for link in info_menu.links -%}
          {%- assign t = link.title | downcase -%}
          {%- unless skip_info contains t -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endunless -%}
        {%- endfor -%}
        <a href="javascript:document.querySelector('e-kookie') && document.querySelector('e-kookie').openModal()">{{ t_cookie }}</a>
      </nav>
    </div>

    <div class="sff-bot">
      <span>© {{ 'now' | date: '%Y' }} <a href="{{ routes.root_url }}">{{ shop.name | remove: '®' | remove: '™' | strip | escape }}</a>™</span>
      <ul class="sff-pay" aria-label="{{ t_pay }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
      <div class="sff-right">
        {%- if section.settings.show_locale_selector -%}
        <div class="sff-loc">
          {%- render 'localization-form', show_country_selector: false, show_locale_selector: true, location: 'footer' -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "SocialFrame footer",
  "class": "sf-footer-section",
  "settings": [
    { "type": "header", "content": "Nieuwsbrief" },
    { "type": "text", "id": "news_title", "label": "Titel", "default": "Blijf op de hoogte" },
    { "type": "text", "id": "news_text", "label": "Tekst", "default": "Ontvang als eerste nieuwe ontwerpen en kortingscodes in je mailbox." },
    { "type": "header", "content": "Merk" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "brand_text", "label": "Korte tekst", "default": "Persoonlijke frames en tegeltjes, met liefde zelf gemaakt van jouw herinnering." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp" },
    { "type": "text", "id": "email", "label": "E-mailadres" },
    { "type": "header", "content": "Menu's" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop-menu", "default": "main-menu" },
    { "type": "select", "id": "layout", "label": "Kolommen (niet gebruikt)", "options": [ { "value": "grid-3 grid-lap-1", "label": "3" }, { "value": "grid-4 grid-portable-2 grid-lap-1", "label": "4" } ], "default": "grid-4 grid-portable-2 grid-lap-1" },
    { "type": "checkbox", "id": "show_locale_selector", "label": "Taalkiezer", "default": false },
    { "type": "checkbox", "id": "show_country_selector", "label": "Landkiezer", "default": false },
    { "type": "checkbox", "id": "remove_margin", "label": "Geen marge (niet gebruikt)", "default": false },
    { "type": "select", "id": "seo_h_tag", "label": "Kop-tag (niet gebruikt)", "options": [ { "value": "h4", "label": "H4" }, { "value": "span", "label": "span" } ], "default": "h4" }
  ],
  "max_blocks": 8,
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Snelle links" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
      { "type": "checkbox", "id": "open_in_new_window", "label": "In nieuw venster", "default": false } ] },
    { "type": "text", "name": "Tekst", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Contact" },
      { "type": "select", "id": "size", "label": "Grootte", "options": [ { "value": "h5", "label": "Klein" }, { "value": "h4", "label": "Groot" } ], "default": "h4" },
      { "type": "richtext", "id": "content", "label": "Tekst", "default": "<p>Tekst</p>" },
      { "type": "checkbox", "id": "show_social_icons", "label": "Social iconen", "default": true },
      { "type": "checkbox", "id": "enable_follow_on_shop", "label": "Follow on Shop", "default": false } ] },
    { "type": "payment", "name": "Betaalmethodes", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Betaalmogelijkheden" },
      { "type": "checkbox", "id": "only_show_custom_icons", "label": "Alleen eigen iconen", "default": false } ] }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}

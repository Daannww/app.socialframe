        "custom_liquid_iq83WQ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n    :root {\n        --lux-bg: #f9f9f9;\n        --lux-border: #eeeeee;\n        --lux-text: #1a1a1a;\n        --lux-accent-green: #4b6344;\n        --lux-accent-muted: #757575;\n    }\n\n    .custom-shipping-container {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 10px 24px;\n        background-color: var(--lux-bg);\n        border: 1px solid var(--lux-border);\n        border-radius: 50px;\n        max-width: 650px;\n        margin: 20px auto;\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    }\n\n    .custom-shipping-item { display: flex; align-items: center; gap: 10px; }\n    .text-block-shipping { font-size: 13px; color: var(--lux-text); }\n    .shipping-date { font-weight: 600; margin-left: 3px; }\n    \n    .countdown {\n        font-weight: 500;\n        color: var(--lux-accent-muted);\n        font-size: 11px;\n        background: #ececec;\n        padding: 2px 8px;\n        border-radius: 12px;\n        margin-left: 8px;\n    }\n\n    .free-shipping {\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 0.1em;\n        font-size: 10px;\n    }\n\n    .green-circle { fill: var(--lux-accent-green); animation: pulse 2.5s infinite ease-in-out; }\n    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.6; transform: scale(0.9); } }\n\n    @media (max-width: 480px) {\n        .custom-shipping-container { flex-direction: column; gap: 10px; border-radius: 15px; padding: 15px; text-align: center; }\n        .countdown { display: inline-block; margin-top: 5px; }\n    }\n</style>\n\n<div class=\"custom-shipping-container\">\n    <div class=\"custom-shipping-item\">\n        <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\"><circle class=\"green-circle\" cx=\"4\" cy=\"4\" r=\"4\" /></svg>\n        <div class=\"text-block-shipping\">\n            Verzending: <span id=\"shipping-date\" class=\"shipping-date\"></span>\n            <span id=\"countdown\" class=\"countdown\"></span>\n        </div>\n    </div>\n    <div class=\"custom-shipping-item\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg>\n        <div class=\"text-block-shipping\">\n            <span class=\"free-shipping\">Gratis verzending</span>\n        </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        function updateShippingInfo() {\n            const now = new Date();\n            let shipDate = new Date();\n            \n            // Deadline: 12:00 uur\n            if (now.getHours() >= 12) shipDate.setDate(shipDate.getDate() + 1);\n\n            // Sla weekenden over\n            while (shipDate.getDay() === 0 || shipDate.getDay() === 6) {\n                shipDate.setDate(shipDate.getDate() + 1);\n            }\n\n            const options = { weekday: 'short', month: 'short', day: 'numeric' };\n            document.getElementById('shipping-date').textContent = shipDate.toLocaleDateString('nl-NL', options);\n\n            const cutoff = new Date(shipDate);\n            cutoff.setHours(12, 0, 0, 0);\n\n            function timer() {\n                const diff = cutoff - new Date();\n                if (diff <= 0) {\n                    document.getElementById(\"countdown\").textContent = \"Vandaag gesloten\";\n                    return;\n                }\n                const h = Math.floor(diff / 3600000);\n                const m = Math.floor((diff % 3600000) / 60000);\n                document.getElementById(\"countdown\").textContent = `Nog ${h}u ${m}m`;\n            }\n            setInterval(timer, 1000);\n            timer();\n        }\n        updateShippingInfo();\n    });\n</script>"
          }
        },

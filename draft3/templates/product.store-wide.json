    "content_toggles_ek46UQ": {
      "type": "content-toggles",
      "blocks": {
        "text_Xq9EtQ": {
          "type": "text",
          "settings": {
            "title": "Product Informatie",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "{{ product.metafields.custom.product_discription_met_opmaak_ | metafield_tag }}",

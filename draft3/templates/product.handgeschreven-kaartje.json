        "sf_kaartje_tekst": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"sf-kt\" data-sf-kt>\n  <label class=\"sf-kt-l\" for=\"sf-kt-text\">Jouw boodschap voor op het kaartje</label>\n  <p class=\"sf-kt-h\">Wij schrijven jouw tekst met de hand op een mooi kaartje.</p>\n  <textarea id=\"sf-kt-text\" class=\"sf-kt-t\" data-sf-kt-text maxlength=\"300\" rows=\"5\" placeholder=\"Schrijf hier je boodschap...\" required></textarea>\n  <div class=\"sf-kt-f\"><span class=\"sf-kt-e\" data-sf-kt-err hidden>Vul eerst een boodschap in.</span><span class=\"sf-kt-c\" data-sf-kt-count>0 / 300</span></div>\n</div>\n<style>\n  .sf-kt{margin:4px 0 18px}\n  .sf-kt-l{display:block;font-size:15px;font-weight:700;color:#151412;margin:0 0 4px}\n  .sf-kt-h{margin:0 0 12px;font-size:13px;line-height:1.5;color:#6d675c}\n  .sf-kt-t{display:block;width:100%;box-sizing:border-box;border:1.5px solid #d9d4c8;border-radius:16px;padding:14px 16px;font:inherit;font-size:15px;line-height:1.5;color:#151412;background:#fff;resize:vertical;min-height:140px;transition:border-color .2s ease,box-shadow .2s ease}\n  .sf-kt-t:focus{outline:0;border-color:#151412;box-shadow:0 0 0 3px rgba(242,196,138,.45)}\n  .sf-kt-t.is-err{border-color:#c0392b}\n  .sf-kt-f{display:flex;justify-content:space-between;gap:12px;margin-top:6px;font-size:12px}\n  .sf-kt-c{margin-left:auto;color:#8a8478}\n  .sf-kt-e{color:#c0392b}\n</style>\n<script>\n(function(){\n  var w=document.currentScript.previousElementSibling.previousElementSibling; if(!w||!w.hasAttribute('data-sf-kt')) w=document.querySelector('[data-sf-kt]'); if(!w) return;\n  var ta=w.querySelector('[data-sf-kt-text]'), cnt=w.querySelector('[data-sf-kt-count]'), er=w.querySelector('[data-sf-kt-err]');\n  var NAME='properties[Boodschap voor kaartje]';\n  function forms(){ var f=document.querySelectorAll('.product-form .form'); if(f.length) return f; var a=document.querySelectorAll('form[action*=\"/cart/add\"]'); return a; }\n  function sync(){\n    var v=(ta.value||'').trim();\n    forms().forEach(function(f){\n      var h=f.querySelector('input[data-sf-kt-hidden]');\n      if(!h){ h=document.createElement('input'); h.type='hidden'; h.name=NAME; h.setAttribute('data-sf-kt-hidden',''); f.appendChild(h); }\n      h.value=v;\n    });\n    cnt.textContent=ta.value.length+' / 300';\n    if(v){ er.hidden=true; ta.classList.remove('is-err'); }\n  }\n  ta.addEventListener('input',sync);\n  function block(e){\n    if(!(ta.value||'').trim()){\n      e.preventDefault(); e.stopPropagation(); if(e.stopImmediatePropagation) e.stopImmediatePropagation();\n      er.hidden=false; ta.classList.add('is-err'); ta.focus(); ta.scrollIntoView({block:'center',behavior:'smooth'}); return true;\n    }\n    sync(); return false;\n  }\n  document.addEventListener('submit',function(e){ if(e.target.closest && e.target.closest('.product-form, form[action*=\"/cart/add\"]')) block(e); },true);\n  document.addEventListener('click',function(e){\n    var b=e.target.closest && e.target.closest('.product-form button[type=\"submit\"], .product-form [name=\"add\"], form[action*=\"/cart/add\"] button[type=\"submit\"]');\n    if(b) block(e);\n  },true);\n  sync();\n})();\n</script>"
          }
        }

function (items) { if (my === seq) showSugg(items); }).catch(function () { if (my === seq) hideSugg(); });\n      }, 300);\n    });\n    searchEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); var f = suggEl.querySelector('button'); if (f) f.click(); } });\n    document.addEventListener('click', function (e) { if (!root.contains(e.target)) hideSugg(); });\n\n    // ----- kaart starten -----\n    var start = { lng: 4.8952, lat: 52.3702 };\n    function startMap(styleObj) {\n      map = new maplibregl.Map({ container: mapEl, style: styleObj, center: [start.lng, start.lat], zoom: 13.2, attributionControl: false, cooperativeGestures: true, dragRotate: false, pitchWithRotate: false, maxZoom: 18.5, minZoom: 3, fadeDuration: 0 });\n      map.touchZoomRotate.disableRotation();\n      // Bronvermelding (verplicht bij OpenStreetMap-gegevens): staat klein onderaan de widget.\n          map.on('moveend', changed);\n      map.once('load', function () { say(''); });\n      // Standaard Amsterdam als voorbeeld, tot de klant zelf een plek kiest.\n      cityEl.value = 'Amsterdam'; countryEl.value = 'Nederland'; drawTexts();\n    }\n    addJs(MAPLIBRE_JS).then(function () { return styleFor(state); }).then(startMap, function () { say('De kaart kon niet worden geladen. Controleer je verbinding en ververs de pagina.', true); });\n\n    // ----- drukbestand maken (in de browser) en uploaden -----\n    function loadSvgImage(p) {\n      return new Promise(function (ok) {\n        var img = new Image(); img.onload = function () { ok(img); }; img.onerror = function () { ok(null); };\n        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(pinSvg(p));\n      });\n    }\n    // pin + witte fade + tekst op een canvas (voor het drukbestand én de spiegel op de productfoto)\n    function drawTop(ctx, size, W, pt, pinImg) {\n      var p = pinById(state.pin);\n          var k = size / W;\n          if (pinImg && pt) {\n            var pw = W * (p.photo ? 0.11 : 0.085) * k, ph = pw * (p.vb.split(' ')[3] / p.vb.split(' ')[2]);\n            var x = pt.x * k - pw / 2, y = p.anchor === 'bottom' ? pt.y * k - ph : pt.y * k - ph / 2;\n            ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = 3 * k; ctx.shadowOffsetY = 1 * k;\n            if (p.photo) {\n              var sc = pw / 40, dp = new Path2D(PHOTO_DROP);\n              ctx.save(); ctx.translate(x, y); ctx.scale(sc, sc);\n              ctx.fillStyle = '#fff'; ctx.fill(dp);\n              ctx.shadowColor = 'transparent'; ctx.lineWidth = 2.5; ctx.strokeStyle = '#D32F2F'; ctx.stroke(dp);\n              if (state.photoImg) { ctx.beginPath(); ctx.arc(20, 20, 13.5, 0, Math.PI * 2); ctx.clip(); ctx.drawImage(state.photoImg, 6.5, 6.5, 27, 27); }\n              ctx.restore();\n            } else ctx.drawImage(pinImg, x, y, pw, ph);\n            ctx.shadowColor = 'transparent';\n          }\n          var g = ctx.createLinearGradient(0, size * 0.64, 0, size);\n          g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.3, 'rgba(255,255,255,.35)'); g.addColorStop(0.55, 'rgba(255,255,255,.8)'); g.addColorStop(0.72, 'rgba(255,255,255,1)'); g.addColorStop(1, 'rgba(255,255,255,1)');\n          ctx.fillStyle = g; ctx.fillRect(0, size * 0.64, size, size * 0.36);\n          var city = cityEl.value.trim(), country = countryEl.value.trim(), F = FONTS[state.font];\n          var L = layoutText(city, country, W, F);\n          ctx.fillStyle = '#111'; ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'left';\n          if (city && L.cityBase != null) { ctx.font = F.cityStyle + ' ' + F.cityW + ' ' + (L.cityPx * k) + 'px ' + F.cityFam; drawSpaced(ctx, L.city, size / 2, L.cityBase * k, 0); }\n          if (country && L.countryBase != null) { ctx.font = F.ctyStyle + ' ' + F.ctyW + ' ' + (L.countryPx * k) + 'px ' + F.ctyFam; drawSpaced(ctx, L.shown, size / 2, L.countryBase * k, L.countryLs * k); }\n    }\n\n    function renderPrint() { return styleFor(state).then(renderPrintWith); }\n    function renderPrintWith(styleObj) {\n      var W = stageEl.clientWidth, size = PRINT_PX, pr = size / W;\n      var host = document.createElement('div'); host.style.cssText = 'position:fixed;left:-20000px;top:0;width:' + W + 'px;height:' + W + 'px;pointer-events:none';\n      document.body.appendChild(host);\n      var c = map.getCenter();\n      var m2 = new maplibregl.Map({ container: host, style: styleObj, center: [c.lng, c.lat], zoom: map.getZoom(), interactive: false, attributionControl: false, pixelRatio: pr, fadeDuration: 0, preserveDrawingBuffer: true });\n      return new Promise(function (ok, fail) {\n        var done = false, t = setTimeout(function () { if (!done) { done = true; m2.remove(); host.remove(); fail(new Error('De kaart laadde te langzaam, probeer het opnieuw.')); } }, 25000);\n        m2.once('idle', function () {\n          if (done) return;\n          // 'idle' kan al afgaan vóór de stijl compleet is: wacht tot alle tegels er zijn.\n          var tries = 0;\n          (function waitTiles() {\n            if (done) return;\n            if (!m2.areTilesLoaded() && tries++ < 60) return setTimeout(waitTiles, 250);\n            done = true; clearTimeout(t);\n            var cnv = document.createElement('canvas'); cnv.width = size; cnv.height = size;\n            var ctx = cnv.getContext('2d');\n            ctx.fillStyle = BG; ctx.fillRect(0, 0, size, size);\n            ctx.drawImage(m2.getCanvas(), 0, 0, size, size);\n            var p = pinById(state.pin), pt = state.loc ? m2.project([state.loc.lng, state.loc.lat]) : null;\n            var finish = function (pinImg) {\n              drawTop(ctx, size, W, pt, pinImg);\n              m2.remove(); host.remove();\n              cnv.toBlob(function (b) { b ? ok(b) : fail(new Error('Afbeelding maken mislukt.')); }, 'image/jpeg', 0.92);\n            };\n            if (p.id !== 'none' && pt && p.photo) finish(true); else if (p.id !== 'none' && pt) loadSvgImage(p).then(finish); else finish(null);\n          })();\n        });\n      });\n    }\n    function detailLabel() { return 'wegen en water' + (state.labels ? ', plaatsnamen' : '') + (state.streets ? ', straatnamen' : '') + (state.buildings ? ', gebouwen' : ''); }\n    function buildAndUpload() {\n      if (state.busy) return Promise.reject(new Error('busy'));\n      if (!map) return Promise.reject(new Error('De kaart is nog niet geladen.'));\n      if (!state.placed) return Promise.reject(new Error('Zoek eerst jouw plek.'));\n      if (state.pin === 'foto' && !state.photoImg) return Promise.reject(new Error('Kies eerst een foto voor in je pin.'));\n      state.busy = true;\n      var wait = loadFonts().catch(function () {});\n      return wait.then(renderPrint).then(function (blob) {\n        var fd = new FormData();\n        fd.append('image', blob, 'kaart.jpg'); fd.append('client_id', clientId);\n        fd.append('place', cityEl.value.trim()); fd.append('country', countryEl.value.trim()); fd.append('style', detailLabel());\n        return fetch(API + '/api/map/print', { method: 'POST', body: fd }).then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || 'Opslaan mislukt'); return j; }); });\n      }).then(function (j) {\n        state.busy = false;\n        state.result = { job_id: j.job_id, preview_url: j.preview_url, print_url: j.print_url, design: 'Landkaart – ' + detailLabel() };\n        return state.result;\n      }, function (e) { state.busy = false; throw e; });\n    }\n\n    // ----- winkelwagen -----\n    function getForms() {\n      var f = document.querySelectorAll('.product-form .form');\n      if (f.length) return f;\n      var fb = document.querySelector('form[data-type=\"add-to-cart-form\"]');\n      return fb ? [fb] : [];\n    }\n    function setProps(r) {\n      getForms().forEach(function (form) {\n        form.querySelectorAll('[data-hw-k-prop]').forEach(function (el) { el.remove(); });\n        var P = {\n          'properties[Uw personalisatie]': r.preview_url, 'properties[Stijl]': r.design,\n          'properties[Plaats]': cityEl.value.trim(), 'properties[Land]': countryEl.value.trim(),\n          'properties[_AI drukbestand]': r.print_url, 'properties[_AI job]': r.job_id\n        };\n        P['properties[Lettertype]'] = state.font === 'modern' ? 'Modern' : 'Klassiek';\n        if (state.pin !== 'none') P['properties[Pin]'] = pinById(state.pin).label;\n        Object.keys(P).forEach(function (n) { var i = document.createElement('input'); i.type = 'hidden'; i.name = n; i.value = P[n]; i.setAttribute('data-hw-k-prop', ''); form.appendChild(i); });\n      });\n    }\n    var toastEl = null, toastTimer = null;\n    function toast(anchor, msg, ms) {\n      if (!toastEl) {\n        toastEl = document.createElement('div'); toastEl.setAttribute('role', 'alert');\n        toastEl.style.cssText = 'position:fixed;z-index:99999;background:#fff;color:#444;font:500 15px/1.3 inherit;font-family:inherit;padding:14px 20px;border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.22);text-align:center;max-width:90vw;pointer-events:none;transform:translate(-50%,-50%);transition:opacity .25s';\n        document.body.appendChild(toastEl);\n      }\n      var r = anchor.getBoundingClientRect();\n      toastEl.textContent = msg; toastEl.style.left = (r.left + r.width / 2) + 'px'; toastEl.style.top = (r.top + r.height / 2) + 'px';\n      toastEl.style.opacity = '1'; toastEl.style.display = 'block';\n      clearTimeout(toastTimer);\n      toastTimer = setTimeout(function () { toastEl.style.opacity = '0'; setTimeout(function () { toastEl.style.display = 'none'; }, 260); }, ms || 2500);\n    }\n    function intercept(e, target) {\n      if (state.pass) return;\n      if (root.hidden || root.offsetParent === null) return;\n      if (!target || !target.closest || !target.closest('.product-form, form[data-type=\"add-to-cart-form\"]')) return;\n      var btn = target.matches && target.matches('button, input') ? target : (target.querySelector && target.querySelector('button[type=\"submit\"], button[name=\"add\"]')) || target;\n      if (state.result) { setProps(state.result); return; }\n      e.preventDefault(); e.stopImmediatePropagation();\n      if (state.busy) { toast(btn, 'Even geduld, je drukbestand wordt gemaakt…', 2500); return; }\n      toast(btn, 'Even geduld, je drukbestand wordt gemaakt…', 30000);\n      buildAndUpload().then(function (r) {\n        setProps(r); toast(btn, 'Klaar!', 600);\n        state.pass = true; btn.click(); setTimeout(function () { state.pass = false; }, 2000);\n      }, function (err) { if (err && err.message !== 'busy') toast(btn, err.message || 'Er ging iets mis, probeer het opnieuw.', 3500); });\n    }\n    document.addEventListener('submit', function (e) { intercept(e, e.target); }, true);\n    document.addEventListener('click', function (e) {\n      var btn = e.target.closest && e.target.closest('button[type=\"submit\"], button[name=\"add\"], input[type=\"submit\"]');\n      if (btn) intercept(e, btn);\n    }, true);\n\n    // ----- testknop (alleen op de demo-pagina) -----\n    if (root.dataset.demo) {\n      $('[data-hw-k-demo]').hidden = false;\n      $('[data-hw-k-demobtn]').addEventListener('click', function () {\n        var out = $('[data-hw-k-demoout]'); out.textContent = 'Bezig…';\n        buildAndUpload().then(function (r) { out.innerHTML = '<div>Klaar: <a target=\"_blank\" href=\"' + r.print_url + '\">drukbestand</a></div><img src=\"' + r.preview_url + '\" alt=\"\">'; }, function (err) { out.textContent = 'Fout: ' + err.message; });\n      });\n    }\n    window.__hwKaart = { state: state, buildAndUpload: buildAndUpload, getMap: function () { return map; }, pick: pick };\n  }\n  document.querySelectorAll('[data-hw-kaart]').forEach(initOne);\n})();\n</script>"

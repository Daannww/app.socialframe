        "custom_liquid_Cy7gGX": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign hw_kaart_api = 'https://ai-foto.socialframe.nl' -%}\n{%- assign hw_kaart_google_key = 'AIzaSyBIxkM6gwTkyXAdKgJ-aOL0BZOeWJoZ1TA' -%}\n{%- comment -%}  Kaartbron: 'osm' = OpenStreetMap (scherp, gratis) of 'google' = Google-kaart in dezelfde stijl (vraagt een Google-sleutel met Map Tiles API aan).  {%- endcomment -%}\n{%- assign hw_kaart_bron = 'osm' -%}\n\n<div class=\"hw-kaart\" data-hw-kaart data-api=\"{{ hw_kaart_api }}\" data-google-key=\"{{ hw_kaart_google_key }}\" data-bron=\"{{ hw_kaart_bron }}\">\n  <div class=\"hw-kaart-heading\">Personaliseren</div>\n\n  <label class=\"hw-kaart-label\" for=\"hw-kaart-search\">Zoek jouw favoriete plek.</label>\n  <div class=\"hw-kaart-searchwrap\">\n    <input type=\"text\" class=\"hw-kaart-input\" id=\"hw-kaart-search\" data-hw-k-search autocomplete=\"off\" placeholder=\"Straat, plaats of adres\">\n    <div class=\"hw-kaart-sugg\" data-hw-k-sugg hidden></div>\n  </div>\n\n  <div class=\"hw-kaart-stage\" data-hw-k-stage>\n    <div class=\"hw-kaart-map\" data-hw-k-map></div>\n    <div class=\"hw-kaart-fade\" data-hw-k-fade></div>\n    <div class=\"hw-kaart-text\" data-hw-k-textbox>\n      <div class=\"hw-kaart-city\" data-hw-k-cityview></div>\n      <div class=\"hw-kaart-country\" data-hw-k-countryview></div>\n    </div>\n  </div>\n\n  <label class=\"hw-kaart-label\" for=\"hw-kaart-city\">Typ hier jouw: Stad of Dorp of eigen tekst.</label>\n  <input type=\"text\" class=\"hw-kaart-input\" id=\"hw-kaart-city\" data-hw-k-city maxlength=\"40\" autocomplete=\"off\">\n\n  <label class=\"hw-kaart-label\" for=\"hw-kaart-country\">Typ hier jouw: Land of regio of eigen tekst.</label>\n  <input type=\"text\" class=\"hw-kaart-input\" id=\"hw-kaart-country\" data-hw-k-country maxlength=\"40\" autocomplete=\"off\">\n\n  <div class=\"hw-kaart-label\">Extra op de kaart:</div>\n  <div class=\"hw-kaart-modes\" data-hw-k-modes>\n    <button type=\"button\" class=\"hw-kaart-mode\" data-extra=\"labels\" aria-pressed=\"false\">Plaatsnamen</button>\n    <button type=\"button\" class=\"hw-kaart-mode\" data-extra=\"streets\" aria-pressed=\"true\">Straatnamen</button>\n    <button type=\"button\" class=\"hw-kaart-mode\" data-extra=\"buildings\" aria-pressed=\"true\">Gebouwen</button>\n  </div>\n\n  <div class=\"hw-kaart-label\">Lettertype:</div>\n  <div class=\"hw-kaart-modes\">\n    <button type=\"button\" class=\"hw-kaart-mode\" data-font=\"classic\" aria-pressed=\"true\">Klassiek</button>\n    <button type=\"button\" class=\"hw-kaart-mode\" data-font=\"modern\" aria-pressed=\"false\">Modern</button>\n  </div>\n\n  <div class=\"hw-kaart-label\">Pin</div>\n  <div class=\"hw-kaart-pins\" data-hw-k-pins></div>\n  <div class=\"hw-kaart-photo\" data-hw-k-photo hidden><div class=\"hw-kaart-hint\">Kies een foto voor in je pin</div><label class=\"hw-kaart-filebtn\"><span class=\"hw-kaart-filebtn-b\">Foto kiezen</span><span class=\"hw-kaart-filebtn-n\" data-hw-k-fname>Geen foto gekozen</span><input type=\"file\" accept=\"image/*\" data-hw-k-file hidden></label></div>\n\n  <div class=\"hw-kaart-status\" data-hw-k-status role=\"status\" aria-live=\"polite\"></div>\n  <div class=\"hw-kaart-demo\" data-hw-k-demo hidden>\n    <button type=\"button\" class=\"hw-kaart-demobtn\" data-hw-k-demobtn>Test: maak printbestand</button>\n    <div data-hw-k-demoout></div>\n  </div>\n</div>\n\n<style>\n  .hw-kaart{font-family:inherit;font-size:14px;color:#333;border:1.5px solid #E2E2E2;border-radius:24px;background:#fff;padding:22px 18px 20px;margin:1.75rem 0 1rem;box-sizing:border-box}\n  .hw-kaart *{box-sizing:border-box}\n  .hw-kaart-heading{font-family:inherit;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#111;margin:0 0 16px}\n  .hw-kaart-label{display:block;font-size:14px;font-weight:700;color:#121212;margin:18px 0 8px}\n  .hw-kaart-heading + .hw-kaart-label{margin-top:0}\n  .hw-kaart-input{width:100%;padding:13px 14px;border:1.5px solid #8A8A8A;border-radius:12px;font:inherit;font-size:16px;color:#222;background:#fff}\n  .hw-kaart-searchwrap{position:relative}\n  .hw-kaart-sugg{position:absolute;z-index:30;left:0;right:0;top:100%;margin-top:4px;background:#fff;border:1px solid #D0D0D0;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.14);overflow:hidden}\n  .hw-kaart-sugg button{display:block;width:100%;text-align:left;border:0;background:#fff;padding:11px 14px;font:inherit;font-size:14px;color:#222;cursor:pointer;border-bottom:1px solid #F0F0F0}\n  .hw-kaart-sugg button:last-child{border-bottom:0}\n  .hw-kaart-sugg button:hover,.hw-kaart-sugg button:focus{background:#F5F5F5;outline:0}\n  .hw-kaart-sugg small{display:block;color:#777;font-size:12px;margin-top:2px}\n  .hw-kaart-stage{position:relative;width:100%;aspect-ratio:1/1;margin-top:14px;border:1.5px solid #E2E2E2;border-radius:6px;overflow:hidden;background:#fff;touch-action:pan-y}\n  .hw-kaart-map{position:absolute !important;left:0;top:0;width:100%;height:100%}\n  .hw-kaart-fade{position:absolute;left:0;right:0;bottom:0;height:36%;pointer-events:none;background:linear-gradient(to bottom,rgba(255,255,255,0) 0%,rgba(255,255,255,.35) 30%,rgba(255,255,255,.8) 55%,#fff 72%,#fff 100%)}\n  .hw-kaart-text{position:absolute;left:0;top:0;right:0;bottom:0;text-align:center;pointer-events:none;color:#111}\n  .hw-kaart-city,.hw-kaart-country{position:absolute;left:0;right:0;white-space:nowrap}\n  .hw-kaart-attr{margin-top:6px;font-size:11px;color:#888}\n  .hw-kaart-attr a{color:#888}\n  .hw-kaart-hint{margin-top:2px;font-size:12px;color:#777}\n  .hw-kaart-modes{display:flex;flex-wrap:wrap;gap:8px}\n  .hw-kaart-mode{border:1.5px solid #D0D0D0;border-radius:999px;background:#fff !important;color:#222 !important;padding:6px 12px;font:inherit;font-size:13px;cursor:pointer}\n  .hw-kaart-mode[aria-pressed=\"true\"]{border-color:#111;background:#111 !important;color:#fff !important}\n  .hw-kaart-pins{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:6px}\n  .hw-kaart-pin{height:48px;border:1.5px solid #E2E2E2;border-radius:10px;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:5px;font:inherit;font-size:13px;color:#333;line-height:1.1}\n  .hw-kaart-photo{margin-top:10px;max-width:100%;overflow:hidden}\n  .hw-kaart-filebtn{display:flex;align-items:center;gap:8px;margin-top:6px;max-width:100%;min-width:0;cursor:pointer}\n  .hw-kaart-filebtn-b{flex:none;border:1.5px solid #D0D0D0;border-radius:999px;padding:6px 12px;font-size:13px;background:#fff;color:#222}\n  .hw-kaart-filebtn-n{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:#777}\n  .hw-kaart-pin img{height:100%;width:auto}\n  .hw-kaart-pin svg{height:100%;width:auto;max-width:100%}\n  .hw-kaart-pin[aria-pressed=\"true\"]{border-color:#111;box-shadow:0 0 0 1px #111}\n  .hw-kaart-status{margin-top:12px;font-size:13px;color:#555;min-height:18px}\n  .hw-kaart-status.err{color:#b3261e}\n  .hw-kaart-demo{margin-top:14px;padding-top:12px;border-top:1px dashed #ccc}\n  .hw-kaart-demobtn{border:1.5px solid #111;border-radius:999px;background:#fff;padding:10px 18px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}\n  .hw-kaart-demo img{max-width:100%;margin-top:10px;border:1px solid #ddd}\n  .hw-kaart .maplibregl-ctrl-group button{width:36px;height:36px}\n</style>\n\n<script>\n(function () {\n  var MAPLIBRE_JS = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.js';\n  var MAPLIBRE_CSS = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.css';\n  var FONT_CSS = 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,500&family=Montserrat:wght@500;700&display=swap';\n  var TILES = 'https://tiles.openfreemap.org/planet';\n  var GLYPHS = 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf';\n  var BG = '#FFFFFF', WATER = '#C9C9C9', ROAD_MINOR = '#4A4A4A', ROAD_MID = '#333333', ROAD_MAJOR = '#1E1E1E';\n  var PRINT_PX = 1600;\n\n  function addCss(href) { if (document.querySelector('link[href=\"' + href + '\"]')) return; var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = href; document.head.appendChild(l); }\n  function addJs(src) {\n    return new Promise(function (ok, fail) {\n      if (window.maplibregl) return ok();\n      var ex = document.querySelector('script[data-hw-maplibre]');\n      if (ex) { ex.addEventListener('load', function () { ok(); }); ex.addEventListener('error', fail); return; }\n      var s = document.createElement('script'); s.src = src; s.async = true; s.setAttribute('data-hw-maplibre', '');\n      s.onload = function () { ok(); }; s.onerror = fail; document.head.appendChild(s);\n    });\n  }\n  addCss(MAPLIBRE_CSS); addCss(FONT_CSS);\n\n  // ---- pins (zelfde tekening op de kaart en in het drukbestand) ----\n  var HEART = 'M16 28C4 19 2 12 2 9C2 5 5 2.5 8.5 2.5C11.5 2.5 14.5 4.5 16 7.5C17.5 4.5 20.5 2.5 23.5 2.5C27 2.5 30 5 30 9C30 12 28 19 16 28Z';\n  var DROP = 'M16 43C16 43 3 26 3 16A13 13 0 0 1 29 16C29 26 16 43 16 43Z';\n  var PHOTO_DROP = 'M20 53C20 53 3 33 3 20A17 17 0 0 1 37 20C37 33 20 53 20 53Z';\n  var PINS = [\n    { id: 'none', label: 'geen pin' },\n    { id: 'druppel', label: 'Druppel', vb: '0 0 32 44', anchor: 'bottom', svg: '<path d=\"' + DROP + '\" fill=\"#D32F2F\"/><circle cx=\"16\" cy=\"16\" r=\"5.5\" fill=\"#fff\"/>' },\n    { id: 'hart', label: 'Hart', vb: '0 0 32 32', anchor: 'center', svg: '<path d=\"' + HEART + '\" fill=\"#D9534F\"/>' },\n    { id: 'foto', label: 'Foto-pin', vb: '0 0 40 54', anchor: 'bottom', photo: true, svg: '<path d=\"' + PHOTO_DROP + '\" fill=\"#fff\" stroke=\"#D32F2F\" stroke-width=\"2.5\"/><circle cx=\"20\" cy=\"20\" r=\"13.5\" fill=\"#E3E3E3\"/><path d=\"M13 25l5-6 4 4 3-3 5 5z\" fill=\"#fff\"/>' }\n  ];\n  function pinSvg(p) { return '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"' + p.vb + '\">' + p.svg + '</svg>'; }\n  function pinById(id) { for (var i = 0; 
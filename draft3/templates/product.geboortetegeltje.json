          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n    .trustscore-container {\n        display: flex;\n        align-items: center; /* Centreert verticaal */\n        justify-content: center; /* Centreert horizontaal */\n        padding: 7px 20px;\n        background-color: #ffffff; /* Witte achtergrond */\n        border: 1px solid #d9d9d9;\n        border-radius: 20px;\n        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Mooie dropshadow */\n        margin-bottom: 5px;\n        max-width: 100%; /* Zorgt ervoor dat het maximaal de containerbreedte gebruikt */\n        width: fit-content;\n        margin-left: auto;\n        margin-right: auto;\n        flex-wrap: nowrap;\n    }\n\n    .trustscore-content {\n        display: flex;\n        align-items: center; /* Houdt alles netjes op dezelfde lijn */\n        gap: 12px; /* Ruimte tussen sterren en tekst */\n        white-space: nowrap; /* Voorkomt dat de tekst breekt */\n    }\n\n    .trustscore-stars {\n        display: flex;\n        gap: 6px;\n        align-items: center; /* Zorgt ervoor dat sterren verticaal gecentreerd blijven */\n    }\n\n    .star-box {\n        background: #00A650;\n        width: 18px;\n        height: 18px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        border-radius: 4px;\n    }\n\n    .star-icon {\n        width: 12px;\n        height: 12px;\n        fill: white;\n    }\n\n    .trustscore-text {\n        font-size: 14px;\n        color: #000;\n        font-weight: bold;\n        display: flex;\n        align-items: center;\n        margin: 0px; /* Zorgt ervoor dat de tekst op dezelfde lijn als de sterren blijft */\n    }\n\n    /* RESPONSIVE DESIGN */\n    @media screen and (max-width: 480px) {\n        .trustscore-container {\n            padding: 5px 12px;\n            flex-wrap: wrap;\n        }\n\n        .trustscore-content {\n            gap: 8px; /* Iets minder ruimte tussen elementen */\n        }\n\n        .star-box {\n            width: 14px;\n            height: 14px;\n        }\n\n        .star-icon {\n            width: 10px;\n            height: 10px;\n        }\n\n        .trustscore-text {\n            font-size: 12px; /* Kleinere tekst op mobiel */\n        }\n    }\n</style>\n\n<div class=\"trustscore-container\">\n    <div class=\"trustscore-content\">\n        <div class=\"trustscore-stars\">\n            <div class=\"star-box\">\n                <svg class=\"star-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M12 2L14.09 8.26H20.94L15.47 12.97L17.56 19.23L12 15.52L6.44 19.23L8.53 12.97L3.06 8.26H9.91L12 2Z\"/>\n                </svg>\n            </div>\n            <div class=\"star-box\">\n                <svg class=\"star-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M12 2L14.09 8.26H20.94L15.47 12.97L17.56 19.23L12 15.52L6.44 19.23L8.53 12.97L3.06 8.26H9.91L12 2Z\"/>\n                </svg>\n            </div>\n            <div class=\"star-box\">\n                <svg class=\"star-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M12 2L14.09 8.26H20.94L15.47 12.97L17.56 19.23L12 15.52L6.44 19.23L8.53 12.97L3.06 8.26H9.91L12 2Z\"/>\n                </svg>\n            </div>\n            <div class=\"star-box\">\n                <svg class=\"star-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M12 2L14.09 8.26H20.94L15.47 12.97L17.56 19.23L12 15.52L6.44 19.23L8.53 12.97L3.06 8.26H9.91L12 2Z\"/>\n                </svg>\n            </div>\n            <div class=\"star-box\">\n                <svg class=\"star-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M12 2L14.09 8.26H20.94L15.47 12.97L17.56 19.23L12 15.52L6.44 19.23L8.53 12.97L3.06 8.26H9.91L12 2Z\"/>\n                </svg>\n            </div>\n        </div>\n        <p class=
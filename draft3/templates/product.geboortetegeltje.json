        "custom_liquid_kEmhep": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n:root {\n    --lux-bg:#f9f9f9;\n    --lux-border:#eeeeee;\n    --lux-text:#1a1a1a;\n    --lux-accent-green:#4b6344;\n    --lux-accent-muted:#757575;\n}\n\n.custom-shipping-container{\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    padding:10px 24px;\n    background:var(--lux-bg);\n    border:1px solid var(--lux-border);\n    border-radius:50px;\n    max-width:650px;\n    margin:20px auto;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;\n}\n\n.custom-shipping-item{\n    display:flex;\n    align-items:center;\n    gap:10px;\n}\n\n.shipping-content{\n    display:flex;\n    align-items:center;\n    gap:8px;\n}\n\n.shipping-label{\n    font-size:13px;\n    color:var(--lux-text);\n    white-space:nowrap;\n}\n\n.shipping-info{\n    display:flex;\n    align-items:center;\n    gap:6px;\n}\n\n.shipping-date{\n    font-size:13px;\n    font-weight:600;\n    color:var(--lux-text);\n}\n\n.countdown{\n    font-weight:500;\n    color:var(--lux-accent-muted);\n    font-size:11px;\n    background:#ececec;\n    padding:2px 8px;\n    border-radius:12px;\n}\n\n.free-shipping{\n    font-weight:700;\n    text-transform:uppercase;\n    letter-spacing:.1em;\n    font-size:10px;\n}\n\n.green-circle{\n    fill:var(--lux-accent-green);\n    animation:pulse 2.5s infinite ease-in-out;\n}\n\n@keyframes pulse{\n0%,100%{opacity:1;transform:scale(1);}\n50%{opacity:.6;transform:scale(.9);}\n}\n\n@media(max-width:480px){\n.custom-shipping-container{\nflex-direction:column;\ngap:10px;\nborder-radius:15px;\npadding:15px;\ntext-align:center;\n}\n.shipping-content{\nflex-wrap:wrap;\njustify-content:center;\n}\n.shipping-info{\njustify-content:center;\n}\n}\n</style>\n\n<div class=\"custom-shipping-container\">\n\n<div class=\"custom-shipping-item\">\n\n<div class=\"shipping-content\">\n\n<svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\">\n<circle class=\"green-circle\" cx=\"4\" cy=\"4\" r=\"4\"></circle>\n</svg>\n\n<div id=\"shipping-label\" class=\"shipping-label\"></div>\n\n<div class=\"shipping-info\">\n\n<span id=\"shipping-date\" class=\"shipping-date\"></span>\n\n<span class=\"countdown\">\n<span id=\"countdown-prefix\"></span>\n<span id=\"countdown\"></span>\n</span>\n\n</div>\n\n</div>\n\n</div>\n\n<div class=\"custom-shipping-item\">\n\n<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n<path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path>\n<path d=\"m3.3 7 8.7 5 8.7-5\"></path>\n<path d=\"M12 22V12\"></path>\n</svg>\n\n<div id=\"free-shipping\" class=\"free-shipping\"></div>\n\n</div>\n\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n\nlet timerInterval;\n\nconst lang=(document.documentElement.lang||navigator.language||\"en\").toLowerCase();\n\nconst translations={\nnl:{\nshipping:\"Verzending\",\nremaining:\"Nog\",\nfree:\"Gratis verzending\",\nlocale:\"nl-NL\",\nhour:\"u\",\nminute:\"m\"\n},\nen:{\nshipping:\"Shipping\",\nremaining:\"Ends in\",\nfree:\"Free shipping\",\nlocale:\"en-US\",\nhour:\"h\",\nminute:\"m\"\n},\nde:{\nshipping:\"Versand\",\nremaining:\"Noch\",\nfree:\"Kostenloser Versand\",\nlocale:\"de-DE\",\nhour:\" Std.\",\nminute:\" Min.\"\n}\n};\n\nconst t=lang.startsWith(\"de\")?translations.de:\nlang.startsWith(\"nl\")?translations.nl:\ntranslations.en;\n\ndocument.getElementById(\"shipping-label\").textContent=t.shipping;\ndocument.getElementById(\"countdown-prefix\").textContent=t.remaining+\" \";\ndocument.getElementById(\"free-shipping\").textContent=t.free;\n\nfunction capitalize(str){\nreturn str.charAt(0).toUpperCase()+str.slice(1);\n}\n\nfunction easter(year){\n\nconst f=Math.floor;\nconst a=year%19;\nconst b=f(year/100);\nconst c=year%100;\nconst d=f(b/4);\nconst e=b%4;\nconst g=f((8*b+13)/25);\nconst h=(19*a+b-d-g+15)%30;\nconst i=f(c/4);\nconst k=c%4;\nconst l=(32+2*e+2*i-h-k)%7;\nconst m=f((a+11*h+22*l)/451);\n\nconst month=f((h+l-7*m+114)/31);\nconst day=((h+l-7*m+114)%31)+1;\n\nreturn new Date(year,month-1,day);\n\n}\n\nfunction sameDay(a,b){\nreturn a.getFullYear()===b.getFullYear()\n&&a.getMonth()===b.getMonth()\n&&a.getDate()===b.getDate();\n}\n\nfunction getDutchHolidays(year){\n\nconst easterDate=easter(year);\n\nconst goodFriday=new Date(easterDate);\ngoodFriday.setDate(goodFriday.getDate()-2);\n\nconst easterMonday=new Date(easterDate);\neasterMonday.setDate(easterMonday.getDate()+1);\n\nconst ascension=new Date(easterDate);\nascension.setDate(ascension.getDate()+39);\n\nconst pentecost=new Date(easterDate);\npentecost.setDate(pentecost.getDate()+49);\n\nconst pentecostMonday=new Date(easterDate);\npentecostMonday.setDate(pentecostMonday.getDate()+50);\n\nlet kingsDay=new Date(year,3,27);\n\nif(kingsDay.getDay()===0){\nkingsDay=new Date(year,3,26);\n}\n\nreturn[\nnew Date(year,0,1),\ngoodFriday,\neasterDate,\neasterMonday,\nkingsDay,\nascension,\npentecost,\npentecostMonday,\nnew Date(year,11,25),\nnew Date(year,11,26)\n];\n}\n\tfunction isHoliday(date){\n\n    const holidays = getDutchHolidays(date.getFullYear());\n\n    return holidays.some(h => sameDay(h, date));\n\n}\n\nfunction isWorkingDay(date){\n\n    const day = date.getDay();\n\n    if(day === 0 || day === 6){\n        return false;\n    }\n\n    if(isHoliday(date)){\n        return false;\n    }\n\n    return true;\n\n}\n\nfunction getShippingDate(){\n\n    const now = new Date();\n    let shipDate = new Date(now);\n\n    shipDate.setHours(0,0,0,0);\n\n    // Na 12:00 -> volgende dag\n    if(now.getHours() >= 12){\n        shipDate.setDate(shipDate.getDate() + 1);\n    }\n\n    // Zoek eerstvolgende werkdag\n    while(!isWorkingDay(shipDate)){\n        shipDate.setDate(shipDate.getDate() + 1);\n    }\n\n    return shipDate;\n\n}\n\nfunction formatShippingDate(shipDate){\n\n    const weekday = shipDate.toLocaleDateString(t.locale,{\n        weekday:\"short\"\n    }).replace(/[.,]/g,\"\");\n\n    const month = shipDate.toLocaleDateString(t.locale,{\n        month:\"short\"\n    }).replace(/[.,]/g,\"\");\n\n    return `${capitalize(weekday)} ${shipDate.getDate()} ${capitalize(month)}`;\n\n}\n\nfunction updateShippingInfo(){\n\n    const shipDate = getShippingDate();\n\n    document.getElementById(\"shipping-date\").textContent =\n        formatShippingDate(shipDate);\n\n    const cutoff = new Date(shipDate);\n    cutoff.setHours(12,0,0,0);\n\n    clearInterval(timerInterval);\n\n    function timer(){\n\n        const diff = cutoff - new Date();\n\n        if(diff <= 0){\n\n            updateShippingInfo();\n            return;\n\n        }\n\n        const h = Math.floor(diff / 3600000);\n        const m = Math.floor((diff % 3600000) / 60000);\n\n        document.getElementById(\"countdown\").textContent =\n            `${h}${t.hour} ${m}${t.minute}`;\n\n    }\n\n    timer();\n\n    timerInterval = setInterval(timer,1000);\n\n}\n\t// Bevrijdingsdag (optioneel)\n// Standaard jaarlijks actief.\n// Wil je hem alleen in lustrumjaren (2025, 2030, 2035, ...)?\n// Vervang de regel hieronder door:\n// if (year % 5 === 0) holidays.push(new Date(year,4,5));\n\nfunction addLiberationDay(holidays, year){\n    holidays.push(new Date(year,4,5));\n}\n\n// Voeg Bevrijdingsdag toe aan de lijst\nconst originalGetDutchHolidays = getDutchHolidays;\n\ngetDutchHolidays = function(year){\n\n    const holidays = originalGetDutchHolidays(year);\n\n    addLiberationDay(holidays, year);\n\n    return holidays;\n\n};\n\n// Start de widget\nupdateShippingInfo();\n\n});\n</script>"
          }
        },
        "section_store_block_tabs_Ei6r8K": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% capture sf_tx %}<p>Dit gepersonaliseerde tegeltje combineert ambachtelijke keramiek met een verfijnde lijntekening van jouw foto. Het resultaat is een tijdloos kunstwerkje dat emotie vastlegt in de meest minimalistische vorm. De handgevormde afwerking geeft elk tegeltje een uniek en authentiek karakter — iets dat je niet terugvindt bij massaproductie.</p>§§<p>Een gepersonaliseerd keramisch tegeltje waarop jouw foto wordt omgezet in een elegante lijntekening. Handgevormd, verkrijgbaar in 10×10 cm en 13×13 cm. Ideaal als cadeau voor trouw, gezin, huisdier of een dierbare herinnering.</p>§§<p><strong>Productie:</strong> <br/>Op werkdagen voor 12:00 uur besteld? Dan verzenden we jouw tegeltje nog dezelfde dag! We controleren en drukken elk tegeltje handmatig en met grote zorg.<br/><br/><strong>Verzending en bezorging:</strong></p><ul><li><strong>Nederland, België & Duitsland:</strong> 1-2 werkdagen</li><li><strong>Rest van Europa:</strong> 4 werkdagen</li><li><strong>Noord-Amerika:</strong> 5 werkdagen</li></ul><p><strong>Verpakking:</strong> Elk tegeltje wordt veilig verpakt om breuk te voorkomen.</p><p><strong>Track & Trace:</strong> Je ontvangt een e-mail met trackinggegevens zodra je bestelling is verzonden.<br/><br/>Wij verzenden de meeste bestellingen als brievenbuspakket. De ontvanger hoeft hierdoor niet thuis te blijven om het in ontvangst te nemen. Gemakkelijk, zorgeloos.<br/><br/><strong>Verzending en bezorging:</strong></p><ul><li><strong>Nederland, België & Duitsland:</strong> 1-2 werkdagen</li><li><strong>Rest van Europa:</strong> 4 werkdagen</li><li><strong>Noord-Amerika:</strong> 5 werkdagen</li></ul><p><strong>Verpakking:</strong> Elk tegeltje wordt veilig verpakt om breuk te voorkomen.</p><p><strong>Track & Trace:</strong> Je ontvangt een e-mail met trackinggegevens zodra je bestelling is verzonden.<br/><br/>Wij verzenden de meeste bestellingen als brievenbuspakket. De ontvanger hoeft hierdoor niet thuis te blijven om het in ontvangst te nemen. Gemakkelijk, zorgeloos.</p>§§<p>Keramisch tegeltje, handgevormd, minimalistisch ontwerp.</p>{% endcapture %}{% capture sf_c0 %}Expert Review{% endcapture %}{% capture sf_c1 %}Omschrijving{% endcapture %}{% capture sf_c2 %}Levering{% endcapture %}{% capture sf_c3 %}Specificaties{% endcapture %}{% capture sf_c4 %}Judith Hermans{% endcapture %}{% capture sf_c5 %}12 mei 2025{% endcapture %}{% capture sf_c6 %}Interieurstyliste & Cadeauexpert{% endcapture %}{% render 'sf-tabs', texts: sf_tx, bid: 'section_store_block_tabs_Ei6r8K', first_title: sf_c0, second_title: sf_c1, third_title: sf_c2, fourth_title: sf_c3, reviewer_name: sf_c4, review_date: sf_c5, reviewer_subtext: sf_c6, default_tab: 'first', tab_layout: 'filled', enable_fourth_tab: false, product_description_tab: 'second', review_tab: 'first', show_payment_icons: 'first', star_style: 'mild', stars_count: 0, stars_color: '#c4956a', stars_bg_half_color: '#e8ddd3', show_verified_badge: false, verified_badge_color: '#c4956a', reviewer_image: 'shopify://shop_images/ai-block-tabs-reviewer-image-4_6e999dbb-5b51-479f-8e75-6ae25d2841c1.jpg', tab_text_size: 13, tab_font_weight: 500, content_text_size: 13, light_color: '#ffffff', dark_color: '#f0ede5', tab_text_color: '#5a4636', text_color: '#212529', muted_text_color: '#7a6a5a', effect: 'none', border: 'solid', border_thickness: 0.5, border_color: '#d9cdbf', radius: 10, padding_vertical: 18, padding_horizontal: 18 %}"
          }

        "custom_liquid_eDXMp6": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.metafields.custom.ai_stijlen.value != blank -%}\n{%- assign hw_ai_api = 'https://ai-foto.socialframe.nl' -%}\n{%- assign hw_ai_profile = 'tegel' -%}\n{%- if product.metafields.custom.ai_formaat.value != blank -%}\n  {%- assign hw_ai_profile = product.metafields.custom.ai_formaat.value -%}\n{%- endif -%}\n\n<div class=\"hw-ai\" data-hw-ai data-api=\"{{ hw_ai_api }}\" data-profile=\"{{ hw_ai_profile }}\" data-product=\"{{ product.handle }}\" data-styles=\"{{ product.metafields.custom.ai_stijlen.value | escape }}\">\n  <div class=\"hw-ai-heading\">Personaliseren</div>\n\n  <div class=\"hw-ai-history\" data-hw-ai-history hidden>\n    <div class=\"hw-ai-label\">Herbestelling? Gebruik je ontwerp opnieuw</div>\n    <div class=\"hw-ai-hist-list\" data-hw-ai-histlist></div>\n  </div>\n\n  <div class=\"hw-ai-label\">Selecteer stijl:</div>\n  <div class=\"hw-ai-designs\" data-hw-ai-designs></div>\n\n  <div class=\"hw-ai-textwrap\" data-hw-ai-textwrap hidden>\n    <label class=\"hw-ai-label\"><span data-hw-ai-textlabel>Eigen tekst</span> <span class=\"hw-ai-opt\" data-hw-ai-opt>(optioneel)</span></label>\n    <input type=\"text\" class=\"hw-ai-text\" data-hw-ai-text maxlength=\"40\" autocomplete=\"off\" placeholder=\"Vul je tekst in\">\n    <div class=\"hw-ai-count\" data-hw-ai-count></div>\n  </div>\n\n  <div class=\"hw-ai-orient\" data-hw-ai-orient hidden>\n    <label><input type=\"radio\" name=\"hw-ai-orient\" value=\"landscape\" checked> Liggend</label>\n    <label><input type=\"radio\" name=\"hw-ai-orient\" value=\"portrait\"> Staand</label>\n  </div>\n\n  <label class=\"hw-ai-upload\" data-hw-ai-upload>\n    <input type=\"file\" accept=\"image/*\" data-hw-ai-file hidden>\n    <img class=\"hw-ai-thumb\" data-hw-ai-thumb alt=\"\" hidden>\n    <span class=\"hw-ai-plus\" data-hw-ai-plus>+</span>\n    <span class=\"hw-ai-uptext\" data-hw-ai-filelabel>Klik hier om je foto te uploaden</span>\n  </label>\n\n  <div class=\"hw-ai-cropstage\" data-hw-ai-cropstage hidden>\n    <div class=\"hw-ai-cropwrap\" data-hw-ai-cropwrap>\n      <img data-hw-ai-cropimg alt=\"\">\n      <div class=\"hw-ai-cropbox\" data-hw-ai-cropbox><i data-h=\"nw\"></i><i data-h=\"ne\"></i><i data-h=\"sw\"></i><i data-h=\"se\"></i><i data-h=\"n\"></i><i data-h=\"s\"></i><i data-h=\"w\"></i><i data-h=\"e\"></i></div>\n    </div>\n    <div class=\"hw-ai-croptip\">Wil je maar een deel van je foto? Sleep over de foto om dat deel te kiezen. <button type=\"button\" class=\"hw-ai-cropreset\" data-hw-ai-cropreset>Hele foto gebruiken</button></div>\n  </div>\n\n  <button type=\"button\" class=\"hw-ai-btn\" data-hw-ai-go disabled>Maak mijn tegeltje</button>\n  <div class=\"hw-ai-loader\" data-hw-ai-loader hidden><div class=\"hw-ai-bar\"><i></i></div><div class=\"hw-ai-loadtext\">Je afbeelding wordt gemaakt… dit duurt ongeveer 20 tot 60 seconden</div></div>\n  <div class=\"hw-ai-status\" data-hw-ai-status role=\"status\" aria-live=\"polite\"></div>\n  <div class=\"hw-ai-choose\" data-hw-ai-choose hidden>\n    <div class=\"hw-ai-label\">Kies je favoriet:</div>\n    <div class=\"hw-ai-choose-list\" data-hw-ai-chooselist></div>\n  </div>\n  <div class=\"hw-ai-result\" data-hw-ai-result hidden>\n    <img data-hw-ai-img alt=\"Jouw AI-afbeelding\">\n    <div class=\"hw-ai-ok\">Mooi! Deze afbeelding wordt op je product gedrukt.</div>\n  </div>\n</div>\n\n<style>\n  .hw-ai-heading{font-family:inherit;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#111;margin:0 0 16px}\n  .hw-ai{font-family:inherit;font-size:15px;color:#333;border:1.5px solid #E2E2E2;border-radius:24px;background:#fff;padding:22px 18px 20px;margin:1.75rem 0 1rem;box-sizing:border-box}\n  .hw-ai *{box-sizing:border-box}\n  .hw-ai [hidden]{display:none !important}\n  .hw-ai-label{font-size:16px;letter-spacing:.02em;color:#444;margin:0 0 10px;display:block}\n  .hw-ai-opt{font-size:14px;color:#999}\n  .hw-ai-designs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:22px;align-items:start}\n  .hw-ai-design{border:3px solid transparent;border-radius:14px;background:#fff;padding:3px;cursor:pointer;text-align:center;font:inherit;color:#333;min-width:0}\n  .hw-ai-design img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;display:block;background:#f0f0f0}\n  .hw-ai-design span{display:block;margin-top:6px;font-size:14px;line-height:1.25}\n  .hw-ai-design[aria-pressed=\"true\"]{border-color:#5B9BD5}\n  .hw-ai-history{margin-bottom:20px}\n  .hw-ai-hist-list{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px}\n  .hw-ai-histwrap{flex:0 0 96px;text-align:center}\n  .hw-ai-histwrap .hw-ai-hist{width:100%}\n  .hw-ai-histbtns{display:flex;gap:6px;justify-content:center;margin-top:6px}\n  .hw-ai-ico{min-width:34px;height:34px;padding:0 8px;border:1px solid #E2E2E2;border-radius:10px;background:#F3F4F6;color:#111;display:inline-flex;align-items:center;justify-content:center;font:inherit;font-size:12px;font-weight:600;cursor:pointer}\n  .hw-ai-ico:hover{border-color:#999}\n  .hw-ai-del{background:#FBE4E4;border-color:#F0C8C8;color:#111}\n  .hw-ai-del.sure{background:#c62828;border-color:#c62828;color:#fff}\n  .hw-ai-hist{flex:0 0 84px;border:2px solid #E2E2E2;border-radius:14px;background:#fff;padding:4px;cursor:pointer;font:inherit;color:#333;text-align:center}\n  .hw-ai-hist:hover{border-color:#5B9BD5}\n  .hw-ai-hist img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;display:block}\n  .hw-ai-hist span{display:block;font-size:11px;margin-top:4px;line-height:1.2}\n  .hw-ai-textwrap{margin-bottom:0}\n  .hw-ai-text{width:100%;padding:15px 16px;border:1.5px solid #8A8A8A;border-radius:14px;font:inherit;font-size:17px;color:#222;background:#fff}\n  .hw-ai-text::placeholder{color:#bbb}\n  .hw-ai-count{text-align:right;font-size:13px;color:#aaa;margin:4px 0 6px}\n  .hw-ai-orient{display:flex;gap:18px;margin:0 0 18px}\n  .hw-ai-upload{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:10px;min-height:48px;border:1.5px dashed #CFCFCF;border-radius:999px;padding:8px 14px;text-align:center;cursor:pointer;background:#fff;margin-bottom:12px;margin-top:6px;color:#777;overflow:hidden}\n  .hw-ai-upload:hover{border-color:#999}\n  .hw-ai-plus{font-size:22px;line-height:1;color:#999;font-weight:300}\n  .hw-ai-uptext{font-size:14px}\n  .hw-ai-uptext{display:flex;flex-direction:column;align-items:flex-start;min-width:0;text-align:left}\n  .hw-ai-fname{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#333;font-size:14px}\n  .hw-ai-change{font-size:13px;font-weight:600;color:#111;text-decoration:underline}\n  .hw-ai-thumb{width:34px;height:34px;object-fit:cover;border-radius:8px;display:block}\n  .hw-ai-btn{width:100%;border:1.5px solid #111;border-radius:999px;background:#fff;color:#111;padding:11px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}\n  .hw-ai .hw-ai-btn:hover:not(:disabled),.hw-ai .hw-ai-btn:focus-visible:not(:disabled){background:#111 !important;color:#fff !important;border-color:#111 !important}\n  .hw-ai-btn:disabled{opacity:.4;cursor:not-allowed}\n  .hw-ai-choose{margin-top:16px}\n  .hw-ai-choose-list{display:block}\n  .hw-ai-group{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:16px}\n  .hw-ai-group:first-child{margin-top:0}\n  .hw-ai-grouptitle{grid-column:1/-1;font-size:13px;opacity:.65;text-align:left}\n  .hw-ai-group:only-child .hw-ai-grouptitle{display:none}\n  .hw-ai-choicewrap{min-width:0;text-align:center}\n  .hw-ai-zoombtn{margin-top:4px;background:none;border:0;padding:4px;font:inherit;font-size:13px;font-weight:600;color:#111;text-decoration:underline;cursor:pointer}\n  .hw-ai img,.hw-ai-zoomimg{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\n  .hw-ai-result img{cursor:zoom-in}\n  .hw-ai-zoom{position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.88);display:none;align-items:center;justify-content:center;padding:16px;box-sizing:border-box;cursor:zoom-out}\n  .hw-ai-zoomimg{width:min(94vw,94vh);height:min(94vw,94vh);max-width:100%;background-size:contain;background-repeat:no-repeat;background-position:center}\n  .hw-ai-zoomclose{position:absolute;top:10px;right:14px;background:none;border:0;color:#fff;font-size:38px;line-height:1;cursor:pointer}\n  .hw-ai-choice{border:3px solid transparent;border-radius:16px;padding:3px;background:#fff;cursor:pointer;min-width:0}\n  .hw-ai-choice img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:13px;display:block;background:#f0f0f0}\n  .hw-ai-choice span{display:block;margin-top:6px;font-size:13px;color:#444}\n  .hw-ai-choice[aria-pressed=\"true\"]{border-color:#5B9BD5}\n  .hw-ai-croptoggle{display:flex;align-items:center;gap:8px;margin:2px 0 12px;font-size:14px;color:#333;cursor:pointer}\n  .hw-ai-croptoggle input{width:18px;height:18px;margin:0}\n  .hw-ai-cropstage{margin:0 0 14px;text-align:center}\n  .hw-ai-cropwrap{cursor:crosshair;position:relative;display:inline-block;max-width:100%;line-height:0;touch-action:none;-webkit-user-select:none;user-select:none}\n  .hw-ai-cropwrap img{max-width:100%;max-height:340px;display:block;border-radius:10px;-webkit-user-drag:none}\n  .hw-ai-cropbox{position:absolute;border:2px solid #fff;box-shadow:0 0 0 9999px rgba(0,0,0,.5);cursor:move;box-sizing:border-box;outline:1px solid rgba(0,0,0,.4)}\n  .hw-ai-cropbox i{position:absolute;width:20px;height:20px;background:#fff;border:2px solid #111;border-radius:50%;box-sizing:border-box}\n  .hw-ai-cropbox i[data-h=nw]{left:2px;top:2px;cursor:nwse-resize}\n  .hw-ai-cropbox i[data-h=ne]{right:2px;top:2px;cursor:nesw-resize}\n  .hw-ai-cropbox i[data-h=sw]{left:2px;bottom:2px;cursor:nesw-resize}\n  .hw-ai-cropbox i[data-h=se]{right:2px;bottom:2px;cursor:nwse-resize}\n  .hw-ai-cropbox i[data-h=n]{left:50%;top:2px;margin-left:-10px;cursor:ns-resize}\n  .hw-ai-cropbox i[data-h=s]{left:50%;bottom:2px;margin-left:-10px;cursor:ns-resize}\n  .hw-ai-cropbox i[data-h=w]{top:50%;left:2px;margin-top:-10px;cursor:ew-resize}\n  .hw-ai-cropbox i[data-h=e]{top:50%;right:2px;margin-top:-10px;cursor:ew-resize}\n  .hw-ai-cropwrap{overflow:hidden;border-radius:10px}\n  .hw-ai-cropbox{touch-action:none}\n  .hw-ai-cropreset{background:none;border:0;padding:0;font:inherit;font-weight:600;color:#111;text-decoration:underline;cursor:pointer}\n  .hw-ai-croptip{margin-top:8px;font-size:13px;color:#666}\n  .hw-ai-loader{margin-top:14px;text-align:center}\n  .hw-ai-bar{height:8px;border-radius:99px;background:#EEE;overflow:hidden;position:relative}\n  .hw-ai-bar i{position:absolute;top:0;bottom:0;width:40%;border-radius:99px;background:#222;animation:hwai 1.2s ease-in-out infinite}\n  @keyframes hwai{0%{left:-40%}100%{left:100%}}\n  .hw-ai-loadtext{margin-top:8px;font-size:14px;color:#555}\n  .hw-ai-help{margin-top:14px;padding:12px 16px;border-radius:14px;background:#F7F5F2;text-align:center;font-size:13px;line-height:1.5;color:#666}\n  .hw-ai-help-title{display:block;margin-bottom:2px;font-size:14px;font-weight:600;color:#111;letter-spacing:.01em}\n  .hw-ai-left{margin-top:8px;text-align:center;font-size:.9em;opacity:.8}\n  .hw-ai-left.out{font-size:16px;font-weight:700;padding:12px;border-radius:12px;background:#fdecea;margin-top:10px}\n  .hw-ai-left.low{color:#b00020;opacity:1}\n  .hw-ai-status{margin-top:12px;min-height:1em;text-align:center}\n  .hw-ai-status.err{color:#b00020}\n  .hw-ai-result{margin-top:16px;text-align:center}\n  .hw-ai-result img{max-width:100%;border-radius:16px;display:block;margin:0 auto 8px}\n  .hw-ai-ok{color:#666}\n  @media(max-width:480px){.hw-ai{padding:20px 14px 16px}.hw-ai-design span{font-size:13px}}\n</style>\n\n<script>\n(function () {\n  // Het thema kan dit blok twee keer op de pagina zetten (bv. een versie voor mobiel en een voor desktop).\n  // Daarom starten we elk blok apart, en slaan we blokken die al draaien over.\n  function initOne(root, idx) {\n  if (root.dataset.hwAiInit) return;\n  root.dataset.hwAiInit = '1';\n  var API = (root.dataset.api || '').replace(/\\/$/, '');\n  var PROFILE = root.dataset.profile === 'poster' ? 'poster' : 'tegel';\n  var STYLES = (root.dataset.styles || '').trim();\n  var $ = function (s) { return root.querySelector(s); };\n  var designsEl = $('[data-hw-ai-designs]'), fileEl = $('[data-hw-ai-file]'), fileLabel = $('[data-hw-ai-filelabel]');\n  var loaderEl = $('[data-hw-ai-loader]'), loadText = $('.hw-ai-loadtext');\n  var leftEl = document.createElement('div'); leftEl.hidden = true;\n  var goBtn = $('[data-hw-ai-go]'), statusEl = $('[data-hw-ai-status]'), resultEl = $('[data-hw-ai-result]');\n  var imgEl = $('[data-hw-ai-img]'), orientEl = $('[data-hw-ai-orient]');\n  var textWrap = $('[data-hw-ai-textwrap]'), textEl = $('[data-hw-ai-text]'), textLabel = $('[data-hw-ai-textlabel]');\n  var histBox = $('[data-hw-ai-history]'), histList = $('[data-hw-ai-histlist]');\n  var chooseBox = $('[data-hw-ai-choose]'), chooseList = $('[data-hw-ai-chooselist]');\n  var optEl = $('[data-hw-ai-opt]'), countEl = $('[data-hw-ai-count]'), thumbEl = $('[data-hw-ai-thumb]'), plusEl = $('[data-hw-ai-plus]');\n  // design: gekozen ontwerp; result: afbeelding die bij de bestelling hoort (nieuw of hergebruikt)\n  var state = { pending: null, design: null, designName: '', allowsText: false, textRequired: false, result: null, busy: false, left: null };\n  if (PROFILE === 'poster') orientEl.hidden = false;\n  root.querySelectorAll('input[type=\"radio\"]').forEach(function (r) { r.name = 'hw-ai-orient-' + idx; });\n\n  var clientId;\n  try { clientId = localStorage.getItem('hw_ai_client'); } catch (e) {}\n  if (!clientId) {\n    clientId = 'c' + Math.random().toString(36).slice(2) + Date.now().toString(36);\n    try { localStorage.setItem('hw_ai_client', clientId); } catch (e) {}\n  }\n\n  goBtn.parentNode.insertBefore(leftEl, goBtn.nextSibling);\n  var helpEl = document.createElement('div'); helpEl.className = 'hw-ai-help'; helpEl.hidden = true;\n  helpEl.innerHTML = '<span class=\"hw-ai-help-title\">Lukt het niet helemaal?</span>Geen zorgen, wij denken graag met je mee. Bestel het ontwerp dat je het mooiste vindt en stuur ons een berichtje via de chat met je bestelnummer, dan stellen we je ontwerp persoonlijk voor je bij.';\n  leftEl.parentNode.insertBefore(helpEl, leftEl.nextSibling);\n  function hideAll() {\n    root.hidden = true;\n  }\n  function say(t, err) { statusEl.textContent = t || ''; statusEl.className = 'hw-ai-status' + (err ? ' err' : ''); }\n  function refresh() {\n    helpEl.hidden = !(typeof state.left === 'number' && (state.left === 0 || (state.max || 0) - state.left >= 4));\n    loaderEl.hidden = !state.busy;\n    if (typeof state.left === 'number') {\n      leftEl.hidden = false;\n      leftEl.textContent = state.left > 0 ? 'Nog ' + state.left + (state.left === 1 ? ' poging' : ' pogingen') + ' beschikbaar' : 'Je credits zijn op. Probeer het morgen weer.';\n      leftEl.className = 'hw-ai-left' + (state.left <= 1 ? ' low' : '') + (state.left === 0 ? ' out' : '');\n    }\n    var needText = state.allowsText && state.textRequired && !textEl.value.trim();\n    goBtn.disabled = state.busy || !state.design || !fileEl.files[0] || state.left === 0 || needText;\n  }\n  function fmtDate(iso) {\n    var d = new Date(String(iso).replace(' ', 'T') + 'Z');\n    return isNaN(d) ? '' : d.getDate() + '-' + (d.getMonth() + 1) + '-' + d.getFullYear();\n  }\n\n  function getForms() {\n    var f = document.querySelectorAll('.product-form .form');\n    if (f.length) return f;\n    var fb = document.querySelector('form[data-type=\"add-to-cart-form\"]');\n    return fb ? [fb] : [];\n  }\n  // Gegevens die bij de bestelling komen. \"AI herbestelling\" staat er alleen bij een hergebruikte afbeelding.\n  function setProps(on) {\n    getForms().forEach(function (form) {\n      form.querySelectorAll('[data-hw-ai-prop]').forEach(function (el) { el.remove(); });\n      if (!on) return;\n      var r = state.result;\n      var props = {\n        'properties[Uw personalisatie]': r.preview_url,\n        'properties[Stijl]': r.design,\n        'properties[_AI drukbestand]': r.print_url,\n        'properties[_AI job]': r.job_id\n      };\n      if (r.text) props['properties[AI tekst]'] = r.text;\n      if (r.reused) props['properties[AI herbestelling]'] = 'Ja, bestaande afbeelding van ' + fmtDate(r.created_at) + ' (job ' + r.job_id.slice(0, 8) + ')';\n      Object.keys(props).forEach(function (name) {\n        var i = document.createElement('input');\n        i.type = 'hidden'; i.name = name; i.value = props[name];\n        i.setAttribute('data-hw-ai-prop', '');\n        form.appendChild(i);\n      });\n    });\n  }\n\n  function showResult(r) {\n    state.result = r; state.pending = null;\n    if (r.reused) { chooseBox.hidden = true; chooseList.replaceChildren(); }\n    imgEl.src = r.preview_url; resultEl.hidden = false; setProps(true);\n    resultEl.querySelector('.hw-ai-ok').textContent = r.reused\n      ? 'Deze eerder gemaakte afbeelding wordt opnieuw gebruikt. Zo krijg je precies hetzelfde tegeltje.'\n      : 'Mooi! Deze afbeelding wordt op je product gedrukt.';\n  }\n\n  function loadHistory() {\n    fetch(API + '/api/history?client_id=' + encodeURIComponent(clientId) + '&profile=' + PROFILE)\n      .then(function (r) { return r.json(); })\n      .then(function (d) {\n        histList.replaceChildren();\n        (d.items || []).forEach(function (it) {\n          var b = document.createElement('button');\n          b.type = 'button'; b.className = 'hw-ai-hist';\n          var im = document.createElement('img'); im.src = it.preview_url; im.alt = ''; im.loading = 'lazy';\n          var sp = document.createElement('span'); sp.textContent = (it.text || it.design || '') + ' · ' + fmtDate(it.created_at);\n          b.appendChild(im); b.appendChild(sp); protect(im);\n          b.addEventListener('click', function () { reuse(it.job_id); });\n          var wrap = document.createElement('div'); wrap.className = 'hw-ai-histwrap';\n          var row = document.createElement('div'); row.className = 'hw-ai-histbtns';\n          var zoom = document.createElement('button'); zoom.type = 'button'; zoom.className = 'hw-ai-ico'; zoom.setAttribute('aria-label', 'Vergroten');\n          zoom.innerHTML = '<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>';\n          zoom.addEventListener('click', function () { openZoom(it.preview_url); });\n          var del = document.createElement('button'); del.type = 'button'; del.className = 'hw-ai-ico hw-ai-del'; del.setAttribute('aria-label', 'Verwijderen');\n          var trash = '<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3\"/></svg>';\n          del.innerHTML = trash;\n          var sure = false, t = null;\n          del.addEventListener('click', function () {\n            if (!sure) { sure = true; del.classList.add('sure'); del.textContent = 'Zeker?'; clearTimeout(t); t = setTimeout(function () { sure = false; del.classList.remove('sure'); del.innerHTML = trash; }, 3000); return; }\n            clearTimeout(t); del.disabled = true;\n            fetch(API + '/api/jobs/' + it.job_id + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId }) })\n              .then(function (r) { if (!r.ok) throw new Error(); wrap.remove(); if (!histList.children.length) histBox.hidden = true; })\n              .catch(function () { del.disabled = false; sure = false; del.classList.remove('sure'); del.innerHTML = trash; say('Verwijderen is niet gelukt, probeer het opnieuw.', true); });\n          });\n          row.appendChild(zoom); row.appendChild(del);\n          wrap.appendChild(b); wrap.appendChild(row);\n          histList.appendChild(wrap);\n        });\n        histBox.hidden = !(d.items || []).length;\n      })\n      .catch(function () {});\n  }\n\n  function reuse(jobId) {\n    if (state.busy) return;\n    say('Even laden…');\n    fetch(API + '/api/reuse', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ job_id: jobId, client_id: clientId }) })\n      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })\n      .then(function (x) {\n        if (!x.ok) { say(x.j.error || 'Niet beschikbaar.', true); return; }\n        x.j.reused = true; showResult(x.j); say('');\n      })\n      .catch(function () { say('Geen verbinding, probeer het opnieuw.', true); });\n  }\n\n  var q = '?product=' + encodeURIComponent(root.dataset.product || '') + (STYLES ? '&styles=' + encodeURIComponent(STYLES) : '');\n  fetch(API + '/api/designs' + q + '&client_id=' + encodeURIComponent(clientId))\n    .then(function (r) { return r.json(); })\n    .then(function (d) {\n      if (d.attempts_left !== undefined) state.left = d.attempts_left;\n      if (d.max_attempts) state.max = d.max_attempts;\n      if (d.text_max) textEl.maxLength = d.text_max;\n      count();\n      (d.designs || []).forEach(function (x) {\n        var b = document.createElement('button');\n        b.type = 'button'; b.className = 'hw-ai-design'; b.setAttribute('aria-pressed', 'false');\n        if (x.example_url) { var im = document.createElement('img'); im.src = x.example_url; im.alt = ''; im.loading = 'lazy'; b.appendChild(im); }\n        var s = document.createElement('span'); s.textContent = x.name; b.appendChild(s);\n        b.addEventListener('click', function () {\n          designsEl.querySelectorAll('.hw-ai-design').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });\n          b.setAttribute('aria-pressed', 'true');\n          state.design = x.id; state.designName = x.name; state.allowsText = !!x.allows_text; state.textRequired = !!x.text_required;\n          optEl.textContent = x.text_required ? '(verplicht)' : '(optioneel)';\n          textWrap.hidden = !x.allows_text; textLabel.textContent = x.text_label || 'Eigen tekst';\n          if (!x.allows_text) textEl.value = '';\n          count();\n          refresh();\n        });\n        designsEl.appendChild(b);\n      });\n      if (!(d.designs || []).length) hideAll(); else { loadHistory(); loadRecent((d.designs || []).map(function (x) { return x.id; })); }\n    })\n    .catch(function () { hideAll(); });\n\n  // Uitsnede: direct na het uploaden zichtbaar. Standaard de hele foto; de klant kan overal over de foto slepen om een deel te kiezen,\n  // en het vak daarna verplaatsen of aan de randen/hoeken aanpassen. Niet aan een vaste verhouding gebonden.\n  var cropStage = $('[data-hw-ai-cropstage]'), cropReset = $('[data-hw-ai-cropreset]');\n  var cropWrap = $('[data-hw-ai-cropwrap]'), cropImg = $('[data-hw-ai-cropimg]'), cropBox = $('[data-hw-ai-cropbox]');\n  var crop = { x: 0, y: 0, w: 1, h: 1 };\n  function cropActive() { return crop.w < 0.985 || crop.h < 0.985; }\n  function drawCrop() {\n    cropBox.style.left = (crop.x * 100) + '%'; cropBox.style.top = (crop.y * 100) + '%';\n    cropBox.style.width = (crop.w * 100) + '%'; cropBox.style.height = (crop.h * 100) + '%';\n    cropReset.hidden = !cropActive();\n    cropBox.style.display = cropActive() ? 'block' : 'none';\n  }\n  var clamp01 = function (v) { return Math.min(1, Math.max(0, v)); };\n  var drag = null, MINC = 0.08;\n  function pt(e, r) { return { x: clamp01((e.clientX - r.left) / r.width), y: clamp01((e.clientY - r.top) / r.height) }; }\n  cropWrap.addEventListener('pointerdown', function (e) {\n    var h = e.target.getAttribute && e.target.getAttribute('data-h');\n    var r = cropWrap.getBoundingClientRect();\n    var onBox = e.target === cropBox;\n    if (h) drag = { mode: h, c: { x: crop.x, y: crop.y, w: crop.w, h: crop.h }, sx: e.clientX, sy: e.clientY, r: r };\n    else if (onBox && cropActive()) drag = { mode: 'move', c: { x: crop.x, y: crop.y, w: crop.w, h: crop.h }, sx: e.clientX, sy: e.clientY, r: r };\n    else { var p0 = pt(e, r); drag = { mode: 'new', p0: p0, r: r }; }\n    try { cropWrap.setPointerCapture(e.pointerId); } catch (x) {}\n    e.preventDefault();\n  });\n  cropWrap.addEventListener('pointermove', function (e) {\n    if (!drag) return;\n    var r = drag.r;\n    if (drag.mode === 'new') {\n      var p1 = pt(e, r), x0 = Math.min(drag.p0.x, p1.x), y0 = Math.min(drag.p0.y, p1.y);\n      var w = Math.abs(p1.x - drag.p0.x), h = Math.abs(p1.y - drag.p0.y);\n      if (w < 0.02 && h < 0.02) return;\n      crop = { x: x0, y: y0, w: Math.max(w, MINC), h: Math.max(h, MINC) };\n      if (crop.x + crop.w > 1) crop.x = 1 - crop.w; if (crop.y + crop.h > 1) crop.y = 1 - crop.h;\n      drawCrop(); return;\n    }\n    var dx = (e.clientX - drag.sx) / r.width, dy = (e.clientY - drag.sy) / r.height, c = drag.c;\n    var x = c.x, y = c.y, w = c.w, h = c.h, m = drag.mode;\n    if (m === 'move') {\n      x = Math.min(1 - w, Math.max(0, c.x + dx)); y = Math.min(1 - h, Math.max(0, c.y + dy));\n    } else {\n      if (m.indexOf('w') > -1) { x = Math.min(c.x + c.w - MINC, Math.max(0, c.x + dx)); w = c.x + c.w - x; }\n      if (m.indexOf('e') > -1) { w = Math.min(1 - c.x, Math.max(MINC, c.w + dx)); }\n      if (m.indexOf('n') > -1) { y = Math.min(c.y + c.h - MINC, Math.max(0, c.y + dy)); h = c.y + c.h - y; }\n      if (m.indexOf('s') > -1) { h = Math.min(1 - c.y, Math.max(MINC, c.h + dy)); }\n    }\n    crop = { x: x, y: y, w: w, h: h }; drawCrop();\n  });\n  function endDrag() { drag = null; }\n  cropWrap.addEventListener('pointerup', endDrag); cropWrap.addEventListener('pointercancel', endDrag);\n  cropReset.addEventListener('click', function () { crop = { x: 0, y: 0, w: 1, h: 1 }; drawCrop(); });\n  function resetCrop(f) {\n    crop = { x: 0, y: 0, w: 1, h: 1 };\n    cropStage.hidden = !f;\n    if (f) { try { cropImg.src = URL.createObjectURL(f); } catch (e) {} }\n    drawCrop();\n  }\n\n  fileEl.addEventListener('change', function () {\n    var f = fileEl.files[0];\n    resetCrop(f);\n    if (f) {\n      try { thumbEl.src = URL.createObjectURL(f); thumbEl.hidden = false; plusEl.hidden = true; } catch (e) {}\n      fileLabel.textContent = '';\n      var nm = document.createElement('span'); nm.className = 'hw-ai-fname'; nm.textContent = f.name;\n      var ch = document.createElement('span'); ch.className = 'hw-ai-change'; ch.textContent = 'Andere foto kiezen';\n      fileLabel.appendChild(nm); fileLabel.appendChild(ch);\n    } else {\n      thumbEl.hidden = true; plusEl.hidden = false; fileLabel.textContent = 'Klik hier om je foto te uploaden';\n    }\n    refresh();\n  });\n  function count() {\n    var left = (textEl.maxLength > 0 ? textEl.maxLength : 40) - textEl.value.length;\n    countEl.textContent = left + ' tekens over';\n  }\n  textEl.addEventListener('input', function () { count(); refresh(); });\n\n\n  // Voorbeelden: geen slepen/rechtsklik/lang indrukken. Volledig kopieerbaar voorkomen kan een website niet (printscreen), daarom staat er ook een watermerk in het voorbeeld.\n  function protect(el) {\n    el.draggable = false;\n    el.addEventListener('contextmenu', function (e) { e.preventDefault(); });\n    el.addEventListener('dragstart', function (e) { e.preventDefault(); });\n  }\n  var zoomEl = null;\n  function openZoom(url) {\n    if (!zoomEl) {\n      zoomEl = document.createElement('div');\n      zoomEl.className = 'hw-ai-zoom';\n      zoomEl.innerHTML = '<div class=\"hw-ai-zoomimg\"></div><button type=\"button\" class=\"hw-ai-zoomclose\" aria-label=\"Sluiten\">&times;</button>';\n      zoomEl.addEventListener('contextmenu', function (e) { e.preventDefault(); });\n      zoomEl.addEventListener('click', function () { zoomEl.style.display = 'none'; });\n      document.body.appendChild(zoomEl);\n      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && zoomEl) zoomEl.style.display = 'none'; });\n    }\n    zoomEl.querySelector('.hw-ai-zoomimg').style.backgroundImage = 'url(\"' + url + '\")';\n    zoomEl.style.display = 'flex';\n  }\n  imgEl.addEventListener('click', function () { if (imgEl.src) openZoom(imgEl.src); });\n  protect(imgEl);\n\n  // Meerdere varianten: de klant moet er eerst één kiezen, pas daarna kan er besteld worden.\n  function showChoices(j, restore) {\n    if (!restore) { state.pending = j.job_id; state.result = null; setProps(false); resultEl.hidden = true; }\n    chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });\n    var group = document.createElement('div'); group.className = 'hw-ai-group';\n    var gt = document.createElement('div'); gt.className = 'hw-ai-grouptitle';\n    gt.textContent = 'Poging ' + (chooseList.children.length + 1); group.appendChild(gt);\n    j.variants.forEach(function (v, idx) {\n      if (v.deleted || !v.preview_url) return;\n      var b = document.createElement('button');\n      b.type = 'button'; b.className = 'hw-ai-choice'; b.setAttribute('aria-pressed', 'false');\n      var im = document.createElement('img'); im.src = v.preview_url; im.alt = 'Variant ' + (idx + 1);\n      var sp = document.createElement('span'); sp.textContent = 'Variant ' + (idx + 1);\n      b.appendChild(im); b.appendChild(sp); protect(im);\n      var wrapB = document.createElement('div'); wrapB.className = 'hw-ai-choicewrap';\n      var zb = document.createElement('button'); zb.type = 'button'; zb.className = 'hw-ai-zoombtn'; zb.textContent = 'Vergroten';\n      zb.addEventListener('click', function () { openZoom(v.preview_url); });\n      var vrow = document.createElement('div'); vrow.className = 'hw-ai-histbtns'; zb.className = 'hw-ai-ico';\n      zb.setAttribute('aria-label', 'Vergroten');\n      zb.innerHTML = '<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>';\n      var vdel = document.createElement('button'); vdel.type = 'button'; vdel.className = 'hw-ai-ico hw-ai-del'; vdel.setAttribute('aria-label', 'Verwijderen');\n      var vtrash = '<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3\"/></svg>';\n      vdel.innerHTML = vtrash;\n      var vsure = false, vt = null;\n      vdel.addEventListener('click', function () {\n        if (state.busy) return;\n        if (!vsure) { vsure = true; vdel.classList.add('sure'); vdel.textContent = 'Zeker?'; clearTimeout(vt); vt = setTimeout(function () { vsure = false; vdel.classList.remove('sure'); vdel.innerHTML = vtrash; }, 3000); return; }\n        clearTimeout(vt); vdel.disabled = true;\n        fetch(API + '/api/jobs/' + j.job_id + '/variants/' + idx + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId }) })\n          .then(function (r) { return r.json().then(function (x) { if (!r.ok) throw new Error(); return x; }); })\n          .then(function (x) {\n            if (b.getAttribute('aria-pressed') === 'true') { state.result = null; setProps(false); resultEl.hidden = true; }\n            wrapB.remove();\n            if (!group.querySelector('.hw-ai-choicewrap')) group.remove();\n            if (!chooseList.querySelector('.hw-ai-choicewrap')) { chooseBox.hidden = true; state.pending = null; say('Ontwerp verwijderd. Maak een nieuw ontwerp om verder te gaan.'); refresh(); }\n          })\n          .catch(function () { vdel.disabled = false; vsure = false; vdel.classList.remove('sure'); vdel.innerHTML = vtrash; say('Verwijderen is niet gelukt, probeer het opnieuw.', true); });\n      });\n      vrow.appendChild(zb); if (j.chosen === undefined || j.chosen === null) vrow.appendChild(vdel);\n      b.addEventListener('click', function () {\n        if (state.busy) return;\n        state.busy = true; loadText.textContent = 'Je gekozen afbeelding wordt scherp gemaakt voor het drukken…'; refresh(); say('');\n        fetch(API + '/api/jobs/' + j.job_id + '/choose', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId, index: idx }) })\n          .then(function (r) { return r.json().then(function (x) { return { ok: r.ok, x: x }; }); })\n          .then(function (res) {\n            state.busy = false; refresh();\n            if (!res.ok) { say(res.x.error || 'Mislukt, probeer het opnieuw.', true); return; }\n            chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });\n            b.setAttribute('aria-pressed', 'true');\n            group.querySelectorAll('.hw-ai-del').forEach(function (d) { d.remove(); });\n            var keep = state.pending;\n            showResult({ job_id: res.x.job_id, design: res.x.design || state.designName, text: res.x.text || '', preview_url: res.x.preview_url, print_url: res.x.print_url, created_at: res.x.created_at, reused: false });\n            state.pending = keep; resultEl.hidden = true; loadHistory();\n            say('Mooi! Deze afbeelding wordt op je product gedrukt.' + (state.left > 0 ? ' Niet tevreden? Je kunt het nog ' + state.left + ' keer opnieuw proberen.' : ''));\n          })\n          .catch(function () { state.busy = false; refresh(); say('Geen verbinding, probeer het opnieuw.', true); });\n      });\n      wrapB.appendChild(b); wrapB.appendChild(vrow); group.appendChild(wrapB);\n    });\n    chooseList.appendChild(group);\n    chooseBox.hidden = false;\n    if (restore) return;\n    say('Kies hierboven de variant die je het mooiste vindt. Daarna kun je bestellen.');\n    group.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n  }\n\n  // Eerdere pogingen blijven ook na een refresh van de pagina staan.\n  function loadRecent(designIds) {\n    fetch(API + '/api/recent?client_id=' + encodeURIComponent(clientId) + '&profile=' + PROFILE)\n      .then(function (r) { return r.json(); })\n      .then(function (d) {\n        if (state.busy || chooseList.children.length) return;\n        (d.items || []).forEach(function (it) {\n          if (designIds.indexOf(it.design_id) < 0) return;\n          showChoices(it, true);\n        });\n        if (chooseList.children.length) { chooseBox.hidden = false; say('Kies hierboven de variant die je het mooiste vindt. Daarna kun je bestellen.'); }\n      })\n      .catch(function () {});\n  }\n\n  function poll(id) {\n    fetch(API + '/api/jobs/' + id).then(function (r) { return r.json(); }).then(function (j) {\n      if (j.attempts_left !== undefined) state.left = j.attempts_left;\n      if (j.status === 'done') {\n        state.busy = false;\n        if (j.variants && j.variants.length > 1) {\n          showChoices(j);\n        } else {\n          showResult({ job_id: j.job_id, design: state.designName, text: j.text || '', preview_url: j.preview_url, print_url: j.print_url, reused: false });\n          say(state.left > 0 ? 'Niet tevreden? Je kunt het nog ' + state.left + ' keer opnieuw proberen.' : '');\n        }\n        refresh(); loadHistory();\n      } else if (j.status === 'error') {\n        state.busy = false; say(j.error || 'Mislukt, probeer het opnieuw.', true); refresh();\n      } else { setTimeout(function () { poll(id); }, 2000); }\n    }).catch(function (err) { if (window.console) console.error('[hw-ai poll]', err); setTimeout(function () { poll(id); }, 3000); });\n  }\n\n  goBtn.addEventListener('click', function () {\n    if (state.busy || !fileEl.files[0] || !state.design) return;\n    if (state.allowsText && state.textRequired && !textEl.value.trim()) { say('Vul eerst een tekst in.', true); textEl.focus(); return; }\n    loadText.textContent = 'Je afbeelding wordt gemaakt… dit duurt ongeveer 20 tot 60 seconden';\n    state.busy = true; state.result = null; state.pending = null; resultEl.hidden = true; setProps(false); refresh();\n    chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });\n    var o = root.querySelector('input[type=\"radio\"]:checked');\n    var fd = new FormData();\n    fd.append('photo', fileEl.files[0]); fd.append('design_id', state.design);\n    fd.append('profile', PROFILE); fd.append('orientation', o ? o.value : 'landscape'); fd.append('client_id', clientId);\n    if (state.allowsText) fd.append('text', textEl.value);\n    if (cropActive()) { fd.append('crop_x', crop.x); fd.append('crop_y', crop.y); fd.append('crop_w', crop.w); fd.append('crop_h', crop.h); }\n    fetch(API + '/api/generate', { method: 'POST', body: fd })\n      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })\n      .then(function (x) {\n        if (!x.ok) { state.busy = false; if (x.j.attempts_left === 0) state.left = 0; say(x.j.error || 'Mislukt', true); refresh(); return; }\n        state.left = x.j.attempts_left; refresh(); poll(x.j.job_id);\n      })\n      .catch(function () { state.busy = false; say('Geen verbinding, probeer het opnieuw.', true); refresh(); });\n  });\n\n  // Zonder gekozen afbeelding niet in de winkelwagen: anders krijgen we een bestelling zonder afbeelding.\n  function blockIfNoResult(e, target) {\n    if (root.hidden || root.offsetParent === null || state.result) return;\n    if (!target || !target.closest || !target.closest('.product-form, form[data-type=\"add-to-cart-form\"]')) return;\n    e.preventDefault(); e.stopImmediatePropagation();\n    var msg = (state.pending || chooseList.children.length) ? 'Kies eerst een van de varianten' : (!fileEl.files[0] ? 'Upload en selecteer eerst een afbeelding' : 'Klik eerst op \"' + goBtn.textContent.trim() + '\"');\n    var anchor = target.matches && target.matches('button, input') ? target : (target.querySelector && target.querySelector('button[type=\"submit\"], button[name=\"add\"]')) || target;\n    toast(anchor, msg);\n  }\n  var toastEl = null, toastTimer = null;\n  function toast(anchor, msg) {\n    if (!toastEl) {\n      toastEl = document.createElement('div');\n      toastEl.setAttribute('role', 'alert');\n      toastEl.style.cssText = 'position:fixed;z-index:99999;background:#fff;color:#444;font:500 15px/1.3 inherit;font-family:inherit;padding:14px 20px;border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.22);text-align:center;max-width:90vw;pointer-events:none;transform:translate(-50%,-50%);transition:opacity .25s';\n      document.body.appendChild(toastEl);\n    }\n    var r = anchor.getBoundingClientRect();\n    toastEl.textContent = msg;\n    toastEl.style.left = (r.left + r.width / 2) + 'px';\n    toastEl.style.top = (r.top + r.height / 2) + 'px';\n    toastEl.style.opacity = '1'; toastEl.style.display = 'block';\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(function () {\n      toastEl.style.opacity = '0';\n      setTimeout(function () { toastEl.style.display = 'none'; }, 260);\n    }, 2500);\n  }\n  document.addEventListener('submit', function (e) { blockIfNoResult(e, e.target); }, true);\n  // Veel thema's versturen via een klik op de knop (zonder gewone submit); die vangen we ook af.\n  document.addEventListener('click', function (e) {\n    var btn = e.target.closest && e.target.closest('button[type=\"submit\"], button[name=\"add\"], input[type=\"submit\"]');\n    if (btn) blockIfNoResult(e, btn);\n  }, true);\n  }\n  document.querySelectorAll('[data-hw-ai]').forEach(function (r, i) { initOne(r, i); });\n})();\n</script>\n{%- endif -%}"
          }

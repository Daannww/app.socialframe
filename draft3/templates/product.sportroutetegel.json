ground-size:12px 8px !important;padding-right:40px;text-overflow:ellipsis}\n  .hw-route-or{margin:12px 0 4px;font-size:13px;color:#777}\n  .hw-route-hint{margin-top:8px;font-size:12px;color:#777}\n  .hw-route-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n  .hw-route-stage{position:relative;width:100%;aspect-ratio:1/1;margin-top:18px;border:1.5px solid #E2E2E2;border-radius:6px;overflow:hidden;background:#fff;touch-action:pan-y}\n  .hw-route-map{position:absolute !important;left:0;top:0;width:100%;height:100%}\n  .hw-route-fade{position:absolute;left:0;right:0;bottom:0;height:46%;pointer-events:none;background:linear-gradient(to bottom,rgba(255,255,255,0) 0%,rgba(255,255,255,.35) 30%,rgba(255,255,255,.8) 55%,#fff 72%,#fff 100%)}\n  .hw-route-text{position:absolute;left:0;top:0;right:0;bottom:0;text-align:center;pointer-events:none;color:#111}\n  .hw-route-text div{position:absolute;left:0;right:0;white-space:nowrap}\n  .hw-route-modes{display:flex;flex-wrap:wrap;gap:8px}\n  .hw-route-mode{border:1.5px solid #D0D0D0;border-radius:999px;background:#fff !important;color:#222 !important;padding:6px 12px;font:inherit;font-size:13px;cursor:pointer}\n  .hw-route-mode[aria-pressed=\"true\"]{border-color:#111;background:#111 !important;color:#fff !important}\n  .hw-route-custom{display:inline-flex;align-items:center;gap:8px;position:relative;overflow:hidden}\n  .hw-route-custom input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;border:0;padding:0}\n  .hw-route-swatch{display:inline-block;width:16px;height:16px;border-radius:50%;border:1.5px solid #999;background:conic-gradient(#e53935,#fdd835,#43a047,#1e88e5,#8e24aa,#e53935)}\n  .hw-route-filebtn{display:flex;align-items:center;gap:8px;margin-top:6px;max-width:100%;min-width:0;cursor:pointer}\n  .hw-route-filebtn-b{flex:none;border:1.5px solid #D0D0D0;border-radius:999px;padding:6px 12px;font-size:13px;background:#fff;color:#222}\n  .hw-route-filebtn-n{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:#777}\n  .hw-route-status{margin-top:12px;font-size:13px;color:#555;min-height:18px}\n  .hw-route-status.err{color:#b3261e}\n  .hw-route-demo{margin-top:14px;padding-top:12px;border-top:1px dashed #ccc}\n  .hw-route-demobtn{border:1.5px solid #111;border-radius:999px;background:#fff;padding:10px 18px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}\n  .hw-route-demo img{max-width:100%;margin-top:10px;border:1px solid #ddd}\n  .hw-route .maplibregl-ctrl-group button{width:36px;height:36px}\n</style>\n\n<script>\n(function () {\n  var MAPLIBRE_JS = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.js';\n  var MAPLIBRE_CSS = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.css';\n  var FONT_CSS = 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,500&family=Montserrat:wght@500;700&display=swap';\n  var TILES = 'https://tiles.openfreemap.org/planet';\n  var GLYPHS = 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf';\n  var BG = '#FFFFFF', WATER = '#C9C9C9', ROAD_MINOR = '#4A4A4A', ROAD_MID = '#333333', ROAD_MAJOR = '#1E1E1E';\n  var PRINT_PX = 2000;   // wordt overschreven door de resolutie-instelling uit de admin\n\n  function addCss(href) { if (document.querySelector('link[href=\"' + href + '\"]')) return; var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = href; document.head.appendChild(l); }\n  function addJs(src) {\n    return new Promise(function (ok, fail) {\n      if (window.maplibregl) return ok();\n      var ex = document.querySelector('script[data-hw-maplibre]');\n      if (ex) { ex.addEventListener('load', function () { ok(); }); ex.addEventListener('error', fail); return; }\n      var s = document.createElement('script'); s.src = src; s.async = true; s.setAttribute('data-hw-maplibre', '');\n      s.onload = function () { ok(); }; s.onerror = fail; document.head.appendChild(s);\n    });\n  }\n  addCss(MAPLIBRE_CSS); addCss(FONT_CSS);\n\n  // ---- kaartstijl (OpenStreetMap-data via OpenFreeMap): zelfde stijl als het landkaart-tegeltje ----\n  function roadW(a, b, c, d) { return ['interpolate', ['linear'], ['zoom'], 10, a, 13, b, 16, c, 20, d]; }\n  function buildStyle(o) {\n    var vis = function (on) { return { visibility: on ? 'visible' : 'none' }; };\n    var inList = function (list) { return ['match', ['get', 'class'], list, true, false]; };\n    var notTunnel = ['!=', ['get', 'brunnel'], 'tunnel'];\n    var nameField = ['coalesce', ['get', 'name:nl'], ['get', 'name']];\n    var lbl = function (id, classes, minzoom, sizes) {\n      return { id: id, type: 'symbol', source: 'omt', 'source-layer': 'place', minzoom: minzoom, layout: Object.assign(vis(o.labels), { 'text-field': nameField, 'text-font': ['Noto Sans Regular'], 'text-size': sizes, 'text-max-width': 7, 'text-padding': 6 }),\n        filter: inList(classes), paint: { 'text-color': '#3A3A3A', 'text-halo-color': 'rgba(255,255,255,.9)', 'text-halo-width': 1.5 } };\n    };\n    return {\n      version: 8, glyphs: GLYPHS,\n      sources: { omt: { type: 'vector', url: TILES } },\n      layers: [\n        { id: 'bg', type: 'background', paint: { 'background-color': BG } },\n        { id: 'water', type: 'fill', source: 'omt', 'source-layer': 'water', paint: { 'fill-color': WATER } },\n        { id: 'waterway', type: 'line', source: 'omt', 'source-layer': 'waterway', paint: { 'line-color': WATER, 'line-width': roadW(0.4, 0.8, 1.6, 6) } },\n        { id: 'building', type: 'fill', source: 'omt', 'source-layer': 'building', minzoom: 13, layout: vis(o.buildings), paint: { 'fill-color': '#E4E4E4', 'fill-outline-color': '#CFCFCF' } },\n        { id: 'r_minor', type: 'line', source: 'omt', 'source-layer': 'transportation', minzoom: 11, layout: { 'line-cap': 'butt', 'line-join': 'round' },\n          filter: ['all', notTunnel, inList(['minor', 'service', 'track'])], paint: { 'line-color': ROAD_MINOR, 'line-width': roadW(0.6, 0.8, 2.0, 7) } },\n        { id: 'r_mid', type: 'line', source: 'omt', 'source-layer': 'transportation', layout: { 'line-join': 'round' },\n          filter: ['all', notTunnel, inList(['tertiary', 'secondary'])], paint: { 'line-color': ROAD_MID, 'line-width': roadW(1.0, 1.5, 3.4, 11) } },\n        { id: 'r_major', type: 'line', source: 'omt', 'source-layer': 'transportation', layout: { 'line-join': 'round' },\n          filter: ['all', notTunnel, inList(['primary', 'trunk', 'motorway'])], paint: { 'line-color': ROAD_MAJOR, 'line-width': roadW(1.6, 2.3, 5.2, 15) } },\n        { id: 'l_street', type: 'symbol', source: 'omt', 'source-layer': 'transportation_name', minzoom: 14.5, layout: Object.assign(vis(o.streets), { 'symbol-placement': 'line', 'text-field': nameField, 'text-font': ['Noto Sans Regular'], 'text-size': ['interpolate', ['linear'], ['zoom'], 14.5, 9, 18, 13], 'text-letter-spacing': 0.02 }),\n          paint: { 'text-color': '#3A3A3A', 'text-halo-color': 'rgba(255,255,255,.95)', 'text-halo-width': 1.6 } },\n        lbl('l_city', ['city'], 4, ['interpolate', ['linear'], ['zoom'], 4, 12, 12, 20]),\n        lbl('l_town', ['town'], 6, ['interpolate', ['linear'], ['zoom'], 6, 11, 13, 17]),\n        lbl('l_village', ['village', 'suburb'], 9, ['interpolate', ['linear'], ['zoom'], 9, 10, 14, 15]),\n        lbl('l_small', ['hamlet', 'neighbourhood', 'quarter'], 12, ['interpolate', ['linear'], ['zoom'], 12, 9.5, 16, 13])\n      ]\n    };\n  }\n\n  // ---- tekst onderaan: maten en posities volgen het ontwerp (tegel van 10 cm) ----\n  // Lettertypes: Peyton Display (Bold/Light/ExtraLight) en Helvetica Neue Medium. Staan de bestanden niet op de server, dan valt het terug op een vergelijkbaar lettertype.\n  var FONT_BASE = 'https://ai-foto.socialframe.nl/fonts/', FONT_V = '?v=2';\n  var SERIF = '\"HW Peyton\", \"Playfair Display\", Georgia, serif', SANS = '\"HW Helvetica\", \"Helvetica Neue\", Helvetica, Arial, sans-serif';\n  var LINES = {\n
usy'));\n      if (!map || !mapReady) return Promise.reject(new Error('De kaart is nog niet geladen.'));\n      if (!state.route) return Promise.reject(new Error('Kies eerst een route.'));\n      state.busy = true;\n      return loadFonts().catch(function () {}).then(renderPrint).then(function (blob) {\n        var fd = new FormData();\n        fd.append('image', blob, 'route.jpg'); fd.append('client_id', clientId);\n        fd.append('place', [F.sport.value.trim(), F.place.value.trim()].filter(Boolean).join(' ')); fd.append('country', F.country.value.trim()); fd.append('style', 'route');\n        return fetch(API + '/api/map/print', { method: 'POST', body: fd }).then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || 'Opslaan mislukt'); return j; }); });\n      }).then(function (j) {\n        state.busy = false;\n        state.result = { job_id: j.job_id, preview_url: j.preview_url, print_url: j.print_url, design: 'Route – ' + (state.routeName || 'eigen route') };\n        return state.result;\n      }, function (e) { state.busy = false; throw e; });\n    }\n\n    // ----- winkelwagen -----\n    function getForms() {\n      var f = document.querySelectorAll('.product-form .form');\n      if (f.length) return f;\n      var fb = document.querySelector('form[data-type=\"add-to-cart-form\"]');\n      return fb ? [fb] : [];\n    }\n    function setProps(r) {\n      getForms().forEach(function (form) {\n        form.querySelectorAll('[data-hw-r-prop]').forEach(function (el) { el.remove(); });\n        var P = {\n          'properties[Uw personalisatie]': r.preview_url, 'properties[Stijl]': r.design,\n          'properties[Route]': state.source, 'properties[Soort]': F.sport.value.trim(), 'properties[Plaats]': F.place.value.trim(), 'properties[Land]': F.country.value.trim(), 'properties[Jaar]': F.year.value.trim(),\n          'properties[Startnummer]': F.nr.value.trim(), 'properties[Naam]': F.name.value.trim(), 'properties[Tijd]': F.time.value.trim(), 'properties[Tempo]': F.pace.value.trim(),\n          'properties[_AI drukbestand]': r.print_url, 'properties[_AI job]': r.job_id\n        };\n        Object.keys(P).forEach(function (n) { if (!P[n]) return; var i = document.createElement('input'); i.type = 'hidden'; i.name = n; i.value = P[n]; i.setAttribute('data-hw-r-prop', ''); form.appendChild(i); });\n      });\n    }\n    var toastEl = null, toastTimer = null;\n    function toast(anchor, msg, ms) {\n      if (!toastEl) {\n        toastEl = document.createElement('div'); toastEl.setAttribute('role', 'alert');\n        toastEl.style.cssText = 'position:fixed;z-index:99999;background:#fff;color:#444;font:500 15px/1.3 inherit;font-family:inherit;padding:14px 20px;border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.22);text-align:center;max-width:90vw;pointer-events:none;transform:translate(-50%,-50%);transition:opacity .25s';\n        document.body.appendChild(toastEl);\n      }\n      var r = anchor.getBoundingClientRect();\n      toastEl.textContent = msg; toastEl.style.left = (r.left + r.width / 2) + 'px'; toastEl.style.top = (r.top + r.height / 2) + 'px';\n      toastEl.style.opacity = '1'; toastEl.style.display = 'block';\n      clearTimeout(toastTimer);\n      toastTimer = setTimeout(function () { toastEl.style.opacity = '0'; setTimeout(function () { toastEl.style.display = 'none'; }, 260); }, ms || 2500);\n    }\n    function intercept(e, target) {\n      if (state.pass) return;\n      if (root.hidden || root.offsetParent === null) return;\n      if (!target || !target.closest || !target.closest('.product-form, form[data-type=\"add-to-cart-form\"]')) return;\n      var btn = target.matches && target.matches('button, input') ? target : (target.querySelector && target.querySelector('button[type=\"submit\"], button[name=\"add\"]')) || target;\n      if (state.result) { setProps(state.result); return; }\n      e.preventDefault(); e.stopImmediatePropagation();\n      if (state.busy) { toast(btn, 'Even geduld, je drukbestand wordt gemaakt…', 2500); return; }\n      if (!state.route) { toast(btn, 'Kies eerst een route.', 3000); return; }\n      toast(btn, 'Even geduld, je drukbestand wordt gemaakt…', 30000);\n      buildAndUpload().then(function (r) {\n        setProps(r); toast(btn, 'Klaar!', 600);\n        state.pass = true; btn.click(); setTimeout(function () { state.pass = false; }, 2000);\n      }, function (err) { if (err && err.message !== 'busy') toast(btn, err.message || 'Er ging iets mis, probeer het opnieuw.', 3500); });\n    }\n    document.addEventListener('submit', function (e) { intercept(e, e.target); }, true);\n    document.addEventListener('click', function (e) {\n      var btn = e.target.closest && e.target.closest('button[type=\"submit\"], button[name=\"add\"], input[type=\"submit\"]');\n      if (btn) intercept(e, btn);\n    }, true);\n\n    // ----- testknop (alleen op de demo-pagina) -----\n    if (root.dataset.demo) {\n      $('[data-hw-r-demo]').hidden = false;\n      $('[data-hw-r-demobtn]').addEventListener('click', function () {\n        var out = $('[data-hw-r-demoout]'); out.textContent = 'Bezig…';\n        buildAndUpload().then(function (r) { out.innerHTML = '<div>Klaar: <a target=\"_blank\" href=\"' + r.print_url + '\">drukbestand</a></div><img src=\"' + r.preview_url + '\" alt=\"\">'; }, function (err) { out.textContent = 'Fout: ' + err.message; });\n      });\n    }\n    window.__hwRoute = { state: state, buildAndUpload: buildAndUpload, getMap: function () { return map; }, setRoute: setRoute };\n  }\n  document.querySelectorAll('[data-hw-route]').forEach(initOne);\n})();\n</script>"

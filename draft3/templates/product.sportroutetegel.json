 data-color=\"#1E6FD9\" aria-pressed=\"false\">Blauw</button>\n    <label class=\"hw-route-mode hw-route-custom\" data-hw-r-customwrap aria-pressed=\"false\"><span class=\"hw-route-swatch\" data-hw-r-swatch></span>Eigen kleur<input type=\"color\" value=\"#1E6FD9\" data-hw-r-custom aria-label=\"Kies een eigen kleur voor de route\"></label>\n  </div>\n\n  <label class=\"hw-route-label\" for=\"hw-route-sport\">Soort wedstrijd</label>\n  <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-sport\" data-hw-r-sport maxlength=\"24\" autocomplete=\"off\" placeholder=\"Bijvoorbeeld: Marathon\">\n\n  <label class=\"hw-route-label\" for=\"hw-route-place\">Plaats</label>\n  <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-place\" data-hw-r-place maxlength=\"24\" autocomplete=\"off\" placeholder=\"Bijvoorbeeld: Enschede\">\n\n  <div class=\"hw-route-row\">\n    <div>\n      <label class=\"hw-route-label\" for=\"hw-route-country\">Land</label>\n      <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-country\" data-hw-r-country maxlength=\"24\" autocomplete=\"off\" placeholder=\"Bijvoorbeeld: Netherlands\">\n    </div>\n    <div>\n      <label class=\"hw-route-label\" for=\"hw-route-year\">Jaar</label>\n      <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-year\" data-hw-r-year inputmode=\"numeric\" maxlength=\"4\" autocomplete=\"off\" placeholder=\"2026\">\n    </div>\n  </div>\n\n  <div class=\"hw-route-row\">\n    <div>\n      <label class=\"hw-route-label\" for=\"hw-route-nr\">Startnummer</label>\n      <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-nr\" data-hw-r-nr maxlength=\"8\" autocomplete=\"off\" placeholder=\"5440\">\n    </div>\n    <div>\n      <label class=\"hw-route-label\" for=\"hw-route-name\">Naam</label>\n      <input type=\"text\" class=\"hw-route-input\" id=\"hw-route-name\" data-hw-r-name maxlength=\"24\" autocomplete=\"off\" placeholder=\"Jan Vliet\">\n    </div>\n  </div>\n\n  <div class=\"hw-route-row\"
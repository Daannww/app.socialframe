{%- comment -%} Eigen reviews-slider (vervangt Section Store block-comments). Params: names, texts, avatars (gescheiden door §§), bid, + stijl-instellingen {%- endcomment -%}
{%- assign names_a = names | split: '§§' -%}{%- assign texts_a = texts | split: '§§' -%}{%- assign avatars_a = avatars | split: '§§' -%}
{%- assign uid = 'sfcm' | append: bid -%}
{%- assign nr = 0 -%}
<div class="sf-cm" id="{{ uid }}" data-autoplay="{{ autoplay | default: 0 }}" style="--cm-bg:{{ item_bg_color | default: '#fff' }};--cm-bw:{{ item_border_width | default: 0.5 }}px;--cm-bc:{{ item_border_color | default: '#ddd' }};--cm-bs:{{ item_border_style | default: 'solid' }};--cm-br:{{ item_border_radius | default: 10 }}px;--cm-py:{{ item_padding_vertical | default: 14 }}px;--cm-px:{{ item_padding_horizontal | default: 18 }}px;--cm-as:{{ avatar_size | default: 44 }}px;--cm-ar:{{ avatar_border_radius | default: 50 }}px;--cm-fs:{{ author_font_size | default: 13 }}px;--cm-fw:{{ author_font_weight | default: 600 }};--cm-fc:{{ author_font_color | default: '#212529' }};--cm-star:{{ star_color | default: '#c4956a' }};--cm-ss:{{ star_size | default: 13 }}px;--cm-badge:{{ verified_badge_color | default: '#f0ede5' }}">
  <div class="sf-cm-wrap">
    <div class="sf-cm-track">
      {%- for txt in texts_a -%}
        {%- assign ix = forloop.index0 -%}
        {%- if txt != blank -%}
        {%- assign nr = nr | plus: 1 -%}
        <div class="sf-cm-item">
          <div class="sf-cm-avatar">
            {%- assign av = avatars_a[ix] -%}{%- if av contains 'shopify://shop_images/' -%}{%- assign av = av | remove: 'shopify://shop_images/' | file_url -%}{%- endif -%}{%- if av != blank -%}<img src="{{ av }}" alt="" loading="lazy" width="88" height="88">{%- endif -%}
            <svg class="sf-cm-badge" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.21 2.13965L13.5602 4.2273L16.0435 4.35159L16.169 6.83451L18.2578 8.18354L17.1247 10.3971L18.259 12.6094L16.1713 13.9596L16.047 16.4429L13.5641 16.5684L12.2151 18.6572L10.0016 17.5241L7.78924 18.6584L6.43903 16.5707L3.95571 16.4464L3.83025 13.9635L1.74141 12.6145L2.87452 10.401L1.74023 8.18865L3.82789 6.83844L3.95217 4.35513L6.4351 4.22966L7.78413 2.14083L9.99764 3.27393L12.21 2.13965Z" fill="currentColor"/><path d="M8.97521 13.2526L6.41992 10.6981L7.25451 9.86391L8.9878 11.5972L12.7509 7.94971L13.5721 8.79688L8.97521 13.2526Z" fill="white"/></svg>
          </div>
          <div class="sf-cm-content">
            <div class="sf-cm-head">
              <span class="sf-cm-author">{{ names_a[ix] }}</span>
              <span class="sf-cm-stars" aria-label="5 / 5">
                {%- for s in (1..5) -%}
                <span class="sf-cm-star"><svg viewBox="0 0 12 13" width="100%" height="100%" fill="none" aria-hidden="true"><path d="M6.86447 2.11566L7.74447 3.87566C7.86447 4.12066 8.18447 4.35566 8.45447 4.40066L10.0495 4.66566C11.0695 4.83566 11.3095 5.57566 10.5745 6.30566L9.33447 7.54566C9.12446 7.75566 9.00947 8.16066 9.07446 8.45066L9.42947 9.98566C9.70947 11.2007 9.06447 11.6707 7.98947 11.0357L6.49447 10.1507C6.22447 9.99066 5.77947 9.99066 5.50447 10.1507L4.00947 11.0357C2.93947 11.6707 2.28947 11.1957 2.56947 9.98566L2.92447 8.45066C2.98947 8.16066 2.87447 7.75566 2.66447 7.54566L1.42447 6.30566C0.694466 5.57566 0.929466 4.83566 1.94947 4.66566L3.54447 4.40066C3.80947 4.35566 4.12947 4.12066 4.24947 3.87566L5.12947 2.11566C5.60947 1.16066 6.38947 1.16066 6.86447 2.11566Z" fill="currentColor"/></svg></span>
                {%- endfor -%}
              </span>
            </div>
            <div class="sf-cm-desc">{{ txt }}</div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if slide_style == 'arrows' and nr > 1 -%}
    <div class="sf-cm-nav">
      <button type="button" class="sf-cm-prev" aria-label="Vorige review"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M14.5 6.5L9 12l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="sf-cm-next" aria-label="Volgende review"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M9.5 6.5L15 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    {%- endif -%}
  </div>
</div>
<style>
.sf-cm{font-family:inherit;width:100%}
.sf-cm-wrap{position:relative}
.sf-cm-track{display:grid;grid-auto-flow:column;grid-auto-columns:100%;gap:15px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-block:10px}
.sf-cm-track::-webkit-scrollbar{display:none}
.sf-cm-item{scroll-snap-align:start;box-sizing:border-box;display:flex;align-items:center;gap:10px;min-width:0;background:var(--cm-bg);border:var(--cm-bw) var(--cm-bs) var(--cm-bc);border-radius:var(--cm-br);padding:var(--cm-py) var(--cm-px)}
.sf-cm-avatar{position:relative;flex:0 0 auto;width:var(--cm-as);height:var(--cm-as)}
.sf-cm-avatar img{display:block;width:100%;height:100%;object-fit:cover;border-radius:var(--cm-ar)}
.sf-cm-badge{position:absolute;right:-6px;bottom:-6px;width:19px;height:19px;color:var(--cm-badge)}
.sf-cm-content{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:5px}
.sf-cm-head{display:flex;align-items:center;flex-wrap:wrap;gap:6px}
.sf-cm-author{font-size:var(--cm-fs);font-weight:var(--cm-fw);color:var(--cm-fc);line-height:1.3}
.sf-cm-stars{display:flex;align-items:center;color:var(--cm-star)}
.sf-cm-star{display:block;width:var(--cm-ss);height:var(--cm-ss)}
.sf-cm-desc,.sf-cm-desc *{font-size:11px;line-height:150%;color:var(--cm-fc);margin:0;overflow-wrap:anywhere}
.sf-cm-nav{position:absolute;inset:0;display:flex;justify-content:space-between;align-items:center;pointer-events:none}
.sf-cm-nav button{pointer-events:auto;background:#fff;border:1px solid #d7d7d7;cursor:pointer;width:20px;height:20px;border-radius:50%;display:flex;justify-content:center;align-items:center;padding:0;color:#333;z-index:11;transition:background-color .18s,border-color .18s}
.sf-cm-nav button svg{width:16px;height:16px}
.sf-cm-nav .sf-cm-prev{margin-left:-10px}.sf-cm-nav .sf-cm-next{margin-right:-10px}
.sf-cm-nav button:hover{background:#f7f7f7;border-color:#c8c8c8}
@media(max-width:1023px){.sf-cm-desc,.sf-cm-desc *{font-size:10px}.sf-cm-author{font-size:12px}}
</style>
<script>
(function(){
  var root=document.getElementById('{{ uid }}'); if(!root)return;
  var tr=root.querySelector('.sf-cm-track'); if(!tr)return;
  function step(dir){var w=tr.clientWidth+15;var max=tr.scrollWidth-tr.clientWidth;var n=tr.scrollLeft+dir*w;if(n>max+5)n=0;if(n<0)n=max;tr.scrollTo({left:n,behavior:'smooth'});}
  var p=root.querySelector('.sf-cm-prev'),n=root.querySelector('.sf-cm-next');
  if(p)p.addEventListener('click',function(){step(-1)});
  if(n)n.addEventListener('click',function(){step(1)});
  var a=parseFloat(root.getAttribute('data-autoplay'))||0;
  if(a>0){var t=setInterval(function(){if(!document.body.contains(root)){clearInterval(t);return;}step(1)},a*1000);root.addEventListener('mouseenter',function(){clearInterval(t)},{once:true});}
})();
</script>

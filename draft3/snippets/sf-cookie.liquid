{%- comment -%}
  SocialFrame cookiebanner — eigen code, geen app.
  Gebruikt de Customer Privacy API van Shopify (bron van waarheid voor Google & YouTube / Google Ads,
  Clarity, Meta enz.) en stuurt daarnaast Google Consent Mode v2 signalen (gtag consent update).
  Render: mode: 'head' (in <head>, vóór content_for_header) en mode: 'body' (vóór </body>).
{%- endcomment -%}
{%- assign sfck_lc = request.locale.iso_code | slice: 0, 2 -%}
{%- if mode == 'head' -%}
<script>
(function(){
  window.dataLayer=window.dataLayer||[];
  function gtag(){dataLayer.push(arguments);}
  var s=null;
  try{s=JSON.parse(localStorage.getItem('sf_consent')||'null');}catch(e){}
  if(!s){var c=document.cookie.match(/(?:^|; )sf_consent=([01])([01])/);if(c)s={a:c[1]==='1',m:c[2]==='1'};}
  var a=s&&s.a?'granted':'denied',m=s&&s.m?'granted':'denied';
  gtag('consent','default',{
    ad_storage:m,ad_user_data:m,ad_personalization:m,
    analytics_storage:a,functionality_storage:'granted',security_storage:'granted',
    wait_for_update:500
  });
  gtag('set','ads_data_redaction',true);
  gtag('set','url_passthrough',true);
})();
</script>
{%- elsif mode == 'head2' -%}
<script>
(function(){
  /* Zet de Shopify-toestemming zo vroeg mogelijk op de keuze van de bezoeker, of op "geweigerd" zolang er nog geen keuze is.
     Zo starten Google Ads, Meta en Clarity niet met standaard "ja". */
  var s=null;
  try{s=JSON.parse(localStorage.getItem('sf_consent')||'null');}catch(e){}
  if(!s){var c=document.cookie.match(/(?:^|; )sf_consent=([01])([01])/);if(c)s={a:c[1]==='1',m:c[2]==='1'};}
  var a=!!(s&&s.a),m=!!(s&&s.m),tries=0;
  function go(){
    if(!(window.Shopify&&Shopify.loadFeatures)){if(tries++<300)setTimeout(go,10);return;}
    Shopify.loadFeatures([{name:'consent-tracking-api',version:'0.1'}],function(err){
      if(err||!Shopify.customerPrivacy)return;
      try{Shopify.customerPrivacy.setTrackingConsent({analytics:a,marketing:m,preferences:a,sale_of_data:m},function(){});}catch(e){}
    });
  }
  go();
})();
</script>
{%- elsif mode == 'body' -%}
<style>
  #sfck{position:fixed;left:16px;bottom:16px;z-index:2147483000;width:min(440px,calc(100vw - 32px));background:#fff;color:#151412;border:1px solid #e8dcc3;border-radius:18px;box-shadow:0 18px 50px rgba(21,20,18,.18);padding:22px 22px 18px;font:14px/1.55 inherit;font-family:inherit;opacity:0;transform:translateY(12px);pointer-events:none;transition:opacity .3s ease,transform .3s ease}
  #sfck.on{opacity:1;transform:none;pointer-events:auto}
  #sfck[hidden]{display:none}
  #sfck h2{margin:0 0 6px;font-size:16px;font-weight:700;letter-spacing:-.005em;line-height:1.3;text-transform:none}
  #sfck p{margin:0;color:#4a4238;font-size:13.5px}
  #sfck p a{color:#151412;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#e0a25a}
  #sfck .sfck-b{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
  #sfck button{font:inherit;font-size:13.5px;font-weight:700;cursor:pointer;border-radius:999px;padding:11px 18px;border:1.5px solid #151412;background:#fff;color:#151412;line-height:1.1;transition:background .2s ease,color .2s ease,border-color .2s ease;-webkit-tap-highlight-color:transparent;text-transform:none;letter-spacing:0;min-height:0}
  #sfck button:hover{background:#faf6ee}
  #sfck button.p{background:#151412;color:#fff}
  #sfck button.p:hover{background:#000}
  #sfck button.l{border-color:transparent;background:transparent;text-decoration:underline;text-underline-offset:3px;padding:11px 6px;margin-left:auto}
  #sfck button:focus-visible{outline:2px solid #151412;outline-offset:2px}
  #sfck .sfck-b button{flex:1 1 auto}
  #sfck .sfck-b button.l{flex:0 0 auto}
  #sfck .sfck-s{display:none;margin-top:14px;border-top:1px solid #efe6d2;padding-top:6px}
  #sfck.set .sfck-s{display:block}
  #sfck.set .sfck-b.m{display:none}
  #sfck .sfck-r{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid #efe6d2}
  #sfck .sfck-r:last-of-type{border-bottom:0}
  #sfck .sfck-r strong{display:block;font-size:13.5px}
  #sfck .sfck-r span{display:block;font-size:12.5px;color:#6b6252;line-height:1.45}
  #sfck .sfck-sw{position:relative;flex:none;width:44px;height:26px;margin-top:2px}
  #sfck .sfck-sw input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer;z-index:1}
  #sfck .sfck-sw i{position:absolute;inset:0;border-radius:999px;background:#d9d0bd;transition:background .2s ease}
  #sfck .sfck-sw i::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s ease}
  #sfck .sfck-sw input:checked+i{background:#151412}
  #sfck .sfck-sw input:checked+i::after{transform:translateX(18px)}
  #sfck .sfck-sw input:disabled{cursor:not-allowed}
  #sfck .sfck-sw input:disabled+i{opacity:.55}
  #sfck .sfck-sw input:focus-visible+i{outline:2px solid #151412;outline-offset:2px}
  body.sfck-open .whatsapp-floating-button{display:none!important}
  [data-sf-cookie-open]{cursor:pointer}
  @media(max-width:560px){#sfck{left:8px;right:8px;bottom:8px;width:auto;padding:18px 16px 14px;border-radius:16px}#sfck .sfck-b button{flex:1 1 100%}#sfck .sfck-b button.l{margin:0 auto}}
  @media(prefers-reduced-motion:reduce){#sfck,#sfck *{transition:none!important}}
</style>
<div id="sfck" role="dialog" aria-modal="false" aria-labelledby="sfck-t" aria-describedby="sfck-d" hidden>
  <h2 id="sfck-t"></h2>
  <p id="sfck-d"></p>
  <div class="sfck-s" id="sfck-s">
    <div class="sfck-r"><div><strong data-k="n_t"></strong><span data-k="n_d"></span></div><label class="sfck-sw"><input type="checkbox" checked disabled aria-label="Noodzakelijk"><i></i></label></div>
    <div class="sfck-r"><div><strong data-k="a_t"></strong><span data-k="a_d"></span></div><label class="sfck-sw"><input type="checkbox" id="sfck-a" aria-label="Statistiek"><i></i></label></div>
    <div class="sfck-r"><div><strong data-k="m_t"></strong><span data-k="m_d"></span></div><label class="sfck-sw"><input type="checkbox" id="sfck-m" aria-label="Marketing"><i></i></label></div>
  </div>
  <div class="sfck-b m" id="sfck-b1">
    <button type="button" class="p" id="sfck-ok"></button>
    <button type="button" id="sfck-no"></button>
    <button type="button" class="l" id="sfck-cf"></button>
  </div>
  <div class="sfck-b" id="sfck-b2" style="display:none">
    <button type="button" class="p" id="sfck-sv"></button>
    <button type="button" id="sfck-ok2"></button>
  </div>
</div>
<script>
(function(){
  var LC={{ sfck_lc | json }};
  var TX={
    nl:{t:'Cookies bij SocialFrame',d:'We gebruiken cookies om de shop te laten werken en – alleen met jouw toestemming – om te meten hoe de site wordt gebruikt en om onze advertenties (o.a. Google Ads en Meta) relevanter te maken. Je kunt je keuze altijd wijzigen. <a href="{{ routes.root_url }}policies/privacy-policy">Privacybeleid</a>',ok:'Alles accepteren',no:'Alleen noodzakelijk',cf:'Instellen',sv:'Keuze opslaan',
      n_t:'Noodzakelijk',n_d:'Winkelwagen, afrekenen en beveiliging. Altijd aan.',a_t:'Statistiek',a_d:'Anonieme statistieken over bezoek en gebruik, zodat we de site kunnen verbeteren.',m_t:'Marketing',m_d:'Advertenties meten en personaliseren, o.a. via Google Ads en Meta.',fl:'Cookie-instellingen'},
    de:{t:'Cookies bei SocialFrame',d:'Wir verwenden Cookies, damit der Shop funktioniert und – nur mit deiner Einwilligung – um die Nutzung zu messen und unsere Werbung (u. a. Google Ads und Meta) relevanter zu machen. Du kannst deine Auswahl jederzeit ändern. <a href="{{ routes.root_url }}policies/privacy-policy">Datenschutzerklärung</a>',ok:'Alle akzeptieren',no:'Nur notwendige',cf:'Einstellen',sv:'Auswahl speichern',
      n_t:'Notwendig',n_d:'Warenkorb, Kasse und Sicherheit. Immer aktiv.',a_t:'Statistik',a_d:'Anonyme Statistiken zu Besuch und Nutzung, damit wir die Seite verbessern können.',m_t:'Marketing',m_d:'Werbung messen und personalisieren, u. a. über Google Ads und Meta.',fl:'Cookie-Einstellungen'},
    en:{t:'Cookies at SocialFrame',d:'We use cookies to make the shop work and – only with your consent – to measure how the site is used and to make our ads (including Google Ads and Meta) more relevant. You can change your choice at any time. <a href="{{ routes.root_url }}policies/privacy-policy">Privacy policy</a>',ok:'Accept all',no:'Necessary only',cf:'Customise',sv:'Save choice',
      n_t:'Necessary',n_d:'Cart, checkout and security. Always on.',a_t:'Statistics',a_d:'Anonymous statistics about visits and usage so we can improve the site.',m_t:'Marketing',m_d:'Measure and personalise ads, including via Google Ads and Meta.',fl:'Cookie settings'}
  };
  var T=TX[LC]||TX.en;
  var $=function(i){return document.getElementById(i)};
  var box=$('sfck');
  if(!box)return;
  $('sfck-t').textContent=T.t;$('sfck-d').innerHTML=T.d;
  $('sfck-ok').textContent=T.ok;$('sfck-ok2').textContent=T.ok;$('sfck-no').textContent=T.no;$('sfck-cf').textContent=T.cf;$('sfck-sv').textContent=T.sv;
  [].forEach.call(box.querySelectorAll('[data-k]'),function(e){e.textContent=T[e.getAttribute('data-k')]});
  [].forEach.call(document.querySelectorAll('[data-sf-cookie-open]'),function(e){e.textContent=T.fl});

  function gtag(){window.dataLayer=window.dataLayer||[];dataLayer.push(arguments);}
  function store(a,m){
    var v=JSON.stringify({a:a,m:m,t:Date.now()});
    try{localStorage.setItem('sf_consent',v);}catch(e){}
    try{document.cookie='sf_consent='+(a?1:0)+(m?1:0)+';max-age=31536000;path=/;SameSite=Lax'+(location.protocol==='https:'?';Secure':'');}catch(e){}
  }
  function read(){
    try{var j=JSON.parse(localStorage.getItem('sf_consent')||'null');if(j)return j;}catch(e){}
    var c=document.cookie.match(/(?:^|; )sf_consent=([01])([01])/);
    return c?{a:c[1]==='1',m:c[2]==='1'}:null;
  }

  function apply(a,m){
    store(a,m);
    var g=function(v){return v?'granted':'denied'};
    gtag('consent','update',{ad_storage:g(m),ad_user_data:g(m),ad_personalization:g(m),analytics_storage:g(a)});
    try{
      var cp=window.Shopify&&Shopify.customerPrivacy;
      if(cp&&cp.setTrackingConsent){
        cp.setTrackingConsent({analytics:a,marketing:m,preferences:a,sale_of_data:m},function(){});
      }
    }catch(e){}
    try{window.dispatchEvent(new CustomEvent('sf:consent',{detail:{analytics:a,marketing:m}}));}catch(e){}
    close();
  }
  function open(settings){
    box.hidden=false;
    var s=read();
    $('sfck-a').checked=!!(s&&s.a);$('sfck-m').checked=!!(s&&s.m);
    if(settings){box.classList.add('set');$('sfck-b1').style.display='none';$('sfck-b2').style.display='flex';}
    else{box.classList.remove('set');$('sfck-b1').style.display='';$('sfck-b2').style.display='none';}
    document.body.classList.add('sfck-open');
    requestAnimationFrame(function(){requestAnimationFrame(function(){box.classList.add('on')})});
  }
  function close(){
    box.classList.remove('on');document.body.classList.remove('sfck-open');
    setTimeout(function(){box.hidden=true},320);
  }
  $('sfck-ok').onclick=$('sfck-ok2').onclick=function(){apply(true,true)};
  $('sfck-no').onclick=function(){apply(false,false)};
  $('sfck-cf').onclick=function(){open(true);$('sfck-a').focus()};
  $('sfck-sv').onclick=function(){apply($('sfck-a').checked,$('sfck-m').checked)};
  document.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-sf-cookie-open]');
    if(t){e.preventDefault();open(true);}
  });
  window.sfCookie={open:function(){open(true)}};

  // Toon de banner zolang de bezoeker nog niets gekozen heeft
  var decided=!!read();
  function boot(){
    if(!decided){open(false);return;}
    // Keuze bestaat lokaal: Shopify heeft hem al ontvangen via het head-script
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
{%- endif -%}

{%- comment -%}
  Muziekframe live-generator: klant kiest een foto en een nummer (Spotify-zoeken), past tekst/kleuren aan en ziet de plaat live
  met Spotify-code of QR-code. Schrijft dezelfde eigenschappen als de Zepto-personalizer, de orderapp blijft ongewijzigd.
  Zet dit in een Custom Liquid-blok op de productpagina van het muziekframe (en haal daar de Zepto-personalizer weg).
{%- endcomment -%}
{%- assign hw_mz_api = 'https://ai-foto.socialframe.nl' -%}

<div class="hw-mz" data-hw-mz data-api="{{ hw_mz_api }}">
  <div class="hw-mz-heading">Personaliseren</div>

  <div class="hw-mz-slot" data-mz-slot>
  <div class="hw-mz-sticky" data-mz-sticky>
  <div class="hw-mz-scene" data-mz-scene>
  <button type="button" class="hw-mz-zoom" data-mz-lbopen aria-label="Voorbeeld vergroten" title="Vergroten (of tik twee keer op het voorbeeld)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8M10.5 8v5M8 10.5h5"/></svg></button>
  <div class="hw-mz-ground"></div>
  <div class="hw-mz-plate">
  <div class="hw-mz-stage" data-mz-stage>
    <canvas class="hw-mz-canvas" data-mz-canvas width="800" height="1200"></canvas>
    <div class="hw-mz-glow" data-mz-glow></div>
    <div class="hw-mz-drag" data-mz-drag title="Sleep om de foto te verplaatsen"></div>
  </div>
  <img class="hw-mz-stand" data-mz-stand alt="" hidden>
  <img class="hw-mz-stand hw-mz-stand-front" data-mz-stand-front alt="" aria-hidden="true" hidden>
  <img class="hw-mz-cable" data-mz-cable alt="" hidden>
  </div>
  </div>
  <div class="hw-mz-hint">Sleep over de foto om hem te verplaatsen.</div>
  </div>
  </div>

  <div class="hw-mz-label">1. Kies je foto <span class="hw-mz-req">(verplicht)</span></div>
  <label class="hw-mz-filebtn"><span class="hw-mz-b">Foto kiezen</span><span class="hw-mz-n" data-mz-fname>Geen foto gekozen</span><input type="file" accept="image/*" data-mz-file hidden></label>
  <div class="hw-mz-phone" data-mz-phone>
    <button type="button" class="hw-mz-phonebtn" data-mz-phonebtn aria-expanded="false">Foto vanaf je telefoon of tablet?</button>
    <div class="hw-mz-phonebox" data-mz-phonebox hidden>
      <div class="hw-mz-phonetext">Scan de QR-code en upload je foto.</div>
      <img class="hw-mz-qr" data-mz-qr alt="QR-code om een foto vanaf je telefoon te uploaden" width="180" height="180">
      <div class="hw-mz-phonestatus" data-mz-phonestatus role="status" aria-live="polite"></div>
    </div>
  </div>
  <div class="hw-mz-row" data-mz-zoomrow hidden><span class="hw-mz-small">Inzoomen</span><input type="range" min="100" max="300" value="100" data-mz-zoom></div>
  <div class="hw-mz-modes">
    <button type="button" class="hw-mz-mode" data-mz-set="filter" data-v="Kleur" aria-pressed="true">Kleur</button>
    <button type="button" class="hw-mz-mode" data-mz-set="filter" data-v="Zwart-wit" aria-pressed="false">Zwart-wit</button>
  </div>

  <div class="hw-mz-label">2. Kies je code</div>
  <div class="hw-mz-modes">
    <button type="button" class="hw-mz-mode" data-mz-set="code" data-v="geen" aria-pressed="true">Geen code</button>
    <button type="button" class="hw-mz-mode" data-mz-set="code" data-v="qr" aria-pressed="false">QR-code</button>
    <button type="button" class="hw-mz-mode" data-mz-set="code" data-v="spotify" aria-pressed="false">Spotify-code</button>
  </div>
  <div data-mz-qrwrap hidden>
    <div class="hw-mz-small">De QR-code opent standaard je nummer. Eigen link? Vul die hier in:</div>
    <input type="text" class="hw-mz-input" data-mz-qrlink autocomplete="off" placeholder="Eigen link (optioneel)">
  </div>


  <div data-mz-songwrap hidden>
  <div class="hw-mz-label">3. Zoek je nummer</div>
  <div class="hw-mz-searchwrap">
    <input type="text" class="hw-mz-input" data-mz-search autocomplete="off" placeholder="Titel of artiest">
    <div class="hw-mz-sugg" data-mz-sugg hidden></div>
  </div>
  <div class="hw-mz-small" data-mz-tracknote></div>
  <button type="button" class="hw-mz-linkbtn" data-mz-linktoggle aria-expanded="false">Lukt zoeken niet? Plak een Spotify-link &#9662;</button>
  <div data-mz-linkwrap hidden>
    <div class="hw-mz-small">In Spotify: Delen &gt; Link kopiëren.</div>
    <input type="text" class="hw-mz-input" data-mz-link autocomplete="off" placeholder="https://open.spotify.com/track/…">
  </div>

  </div>

  <div class="hw-mz-label">4. Tekst <span class="hw-mz-req">(Regel 1 is verplicht)</span></div>
  <input type="text" class="hw-mz-input" data-mz-r1 maxlength="60" autocomplete="off" value="LOVE YOU!" placeholder="Regel 1 (verplicht)">
  <input type="text" class="hw-mz-input hw-mz-gap" data-mz-r2 maxlength="60" autocomplete="off" placeholder="Regel 2 (bijv. de artiest, optioneel)">
  <div class="hw-mz-two">
    <div><div class="hw-mz-small">Begintijd</div><input type="text" class="hw-mz-input" data-mz-t0 maxlength="12" autocomplete="off" value="0:00"></div>
    <div><div class="hw-mz-small">Eindtijd</div><input type="text" class="hw-mz-input" data-mz-t1 maxlength="12" autocomplete="off" placeholder="3:45"></div>
  </div>
  <div class="hw-mz-row"><span class="hw-mz-small">Bolletje</span><input type="range" min="0" max="100" value="20" data-mz-dot></div>

  <div class="hw-mz-label">5. Stijl</div>
  <div class="hw-mz-small">Tekstkleur</div>
  <div class="hw-mz-modes">
    <button type="button" class="hw-mz-mode" data-mz-set="tekst" data-v="Zwarte tekst" aria-pressed="true">Zwarte tekst</button>
    <button type="button" class="hw-mz-mode" data-mz-set="tekst" data-v="Witte tekst" aria-pressed="false">Witte tekst</button>
  </div>
  <div class="hw-mz-small">Achtergrond</div>
  <div class="hw-mz-modes">
    <button type="button" class="hw-mz-mode" data-mz-set="bg" data-v="Transparant" aria-pressed="true">Transparant</button>
    <button type="button" class="hw-mz-mode" data-mz-set="bg" data-v="Wit" aria-pressed="false">Wit</button>
    <button type="button" class="hw-mz-mode" data-mz-set="bg" data-v="Zwart" aria-pressed="false">Zwart</button>
    <button type="button" class="hw-mz-mode" data-mz-set="bg" data-v="Marmerwit" aria-pressed="false">Marmer wit</button>
    <button type="button" class="hw-mz-mode" data-mz-set="bg" data-v="Marmerzwart" aria-pressed="false">Marmer zwart</button>
  </div>
  <div class="hw-mz-small">Hartje</div>
  <div class="hw-mz-modes">
    <button type="button" class="hw-mz-mode" data-mz-set="heart" data-v="Rood" aria-pressed="true">Rood</button>
    <button type="button" class="hw-mz-mode" data-mz-set="heart" data-v="Tekst" aria-pressed="false">Zelfde kleur als de tekst</button>
  </div>

  <div data-mz-sizewrap hidden>
    <div class="hw-mz-label">6. Kies je formaat</div>
    <div class="hw-mz-holders hw-mz-sizes" data-mz-sizes></div>
  </div>

  <div data-mz-holderwrap hidden>
    <div class="hw-mz-label">7. Kies een houder</div>
    <div class="hw-mz-holders" data-mz-holders></div>
  </div>

  <div class="hw-mz-status" data-mz-status role="status" aria-live="polite"></div>
</div>

<style>
  .hw-mz{position:relative;font-family:inherit;font-size:14px;color:#333;border:1.5px solid #E2E2E2;border-radius:24px;background:#fff;padding:22px 18px 20px;margin:1.75rem 0 1rem;box-sizing:border-box}
  .hw-mz *{box-sizing:border-box}
  .hw-mz-heading{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#111;margin:0 0 16px}
  .hw-mz-slot{margin-bottom:130px}
  .hw-mz-zoom{position:absolute;top:6px;right:6px;z-index:8;width:26px;height:26px;border-radius:50%;border:0 !important;background:rgba(255,255,255,.7) !important;box-shadow:0 1px 4px rgba(0,0,0,.14);opacity:.85;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0 !important;margin:0}
  .hw-mz-lb{position:fixed;inset:0;z-index:2147483000;background:rgba(21,20,18,.94);display:flex;align-items:center;justify-content:center;padding:12px;box-sizing:border-box}
  .hw-mz-lb .hw-mz-scene{margin:0;border-radius:10px;touch-action:none}
  .hw-mz-lb .hw-mz-zoom{display:none}
  .hw-mz-scene{container-type:inline-size}
  @container (max-width:150px){.hw-mz-zoom{display:none}}
  @container (max-width:300px){.hw-mz-zoom{top:4px;right:4px;width:24px;height:24px}}
  .hw-mz-lb-x{position:absolute;top:max(12px,env(safe-area-inset-top));right:12px;width:44px;height:44px;border-radius:50%;border:0 !important;background:#fff !important;color:#111 !important;font-size:26px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0 !important;z-index:3}
  .hw-mz-lb-h{position:absolute;left:0;right:0;bottom:max(14px,env(safe-area-inset-bottom));text-align:center;font-size:12px;color:rgba(255,255,255,.7);pointer-events:none}
  .hw-mz-sticky{z-index:20;box-sizing:border-box;background:#fff;padding:6px 0 8px;text-align:center;box-shadow:-16px 0 0 #fff,16px 0 0 #fff,0 12px 0 #fff}
  .hw-mz-scene{position:relative;width:min(100%,520px);aspect-ratio:41/50;margin:0 auto;overflow:hidden;border-radius:6px;background:#ece7df center top/cover no-repeat}
  .hw-mz-ground{position:absolute;left:14%;width:72%;top:86.6%;height:5.7%;background:radial-gradient(ellipse at center,rgba(60,45,30,.38),rgba(60,45,30,0) 70%);filter:blur(3px)}
  .hw-mz-plate{position:absolute;left:17%;width:66%;top:8%}
  .hw-mz-stage{position:relative;z-index:2;width:100%;aspect-ratio:2/3;overflow:hidden;background:#fff;box-shadow:0 0 0 1px rgba(110,130,140,.3),0 14px 12px -4px rgba(40,25,10,.5),8px 8px 18px rgba(60,45,30,.25)}
  .hw-mz-stage.is-clear{background:linear-gradient(135deg,rgba(255,255,255,.20),rgba(255,255,255,.10) 55%,rgba(255,255,255,.16));-webkit-backdrop-filter:blur(.6px);backdrop-filter:blur(.6px);box-shadow:0 0 0 .75px rgba(255,255,255,.88),3px 5px 12px rgba(60,45,30,.10)}
  .hw-mz-canvas{position:absolute;left:0;top:0;width:100%;height:100%;display:block}
  .hw-mz-drag{z-index:4}
  .hw-mz-stand{display:block;position:relative;z-index:1;width:110%;margin:-6% 0 0 -5%;height:auto;background:transparent !important;border:0 !important;box-shadow:none !important;padding:0 !important;filter:drop-shadow(0 5px 5px rgba(40,25,10,.38)) drop-shadow(0 12px 12px rgba(40,25,10,.22))}
  /* ledverlichting: donkerdere kamer, licht uit de sleuf, kabel naast de houder */
  .hw-mz-scene::before,.hw-mz-scene::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .5s ease}
  .hw-mz-scene::before{background:linear-gradient(180deg,rgba(6,6,10,.80),rgba(6,6,10,.88))}
  .hw-mz-scene::after{background:radial-gradient(ellipse 46% 15% at 50% 89.5%,rgba(255,238,210,.38),rgba(255,238,210,0) 100%);mix-blend-mode:screen}
  .hw-mz-scene.is-led::before,.hw-mz-scene.is-led::after{opacity:1}
  .hw-mz-glow{position:absolute;left:0;right:0;bottom:0;height:34%;z-index:3;pointer-events:none;opacity:0;transition:opacity .5s ease;mix-blend-mode:screen;background:linear-gradient(to top,rgba(255,250,240,.85) 0,rgba(255,246,230,.38) 7%,rgba(255,244,225,.12) 28%,rgba(255,244,225,0) 100%)}
  .hw-mz-scene.is-led .hw-mz-glow{opacity:1}
  /* verlichte randen van het acrylaat + donkere plaat zoals in het echt */
  .hw-mz-scene.is-led .hw-mz-stage.is-clear{background:linear-gradient(135deg,rgba(0,0,0,.28),rgba(0,0,0,.18));-webkit-backdrop-filter:none;backdrop-filter:none;box-shadow:0 0 0 .75px rgba(255,255,255,.96),0 0 9px 2px rgba(255,255,255,.6),0 0 26px 4px rgba(255,255,255,.22),inset 0 0 12px rgba(255,255,255,.4)}
  .hw-mz-scene.is-led .hw-mz-stage:not(.is-clear){box-shadow:0 0 0 1px rgba(255,255,255,.7),0 0 14px 2px rgba(255,255,255,.3)}
  .hw-mz-scene.is-led .hw-mz-canvas{filter:brightness(.82) contrast(1.05)}
  .hw-mz-scene.is-led .hw-mz-stand:not(.is-feet){filter:brightness(.55) drop-shadow(0 5px 5px rgba(0,0,0,.6))}
  .hw-mz-cable{position:absolute;z-index:0;left:100%;top:96%;width:34%;height:auto;transform:translateY(-15%);pointer-events:none;filter:brightness(.85) drop-shadow(0 2px 2px rgba(0,0,0,.35))}
  .hw-mz-cable[hidden]{display:none}
  .hw-mz-stand[hidden]{display:none}
  /* gekleurde plaat: alleen de voorste rand van de houder voor de plaat, zodat de plaat in de sleuf lijkt te staan */
  .hw-mz-stand.hw-mz-stand-front{z-index:5;margin-top:-16.2%;clip-path:inset(17.7% 0 0 0);filter:none;pointer-events:none}
  .hw-mz-scene.is-led .hw-mz-stand.hw-mz-stand-front{filter:brightness(.55)}
  /* kunststof pootjes: voorste helft altijd voor de plaat, voetjes aan de rand van de plaat */
  .hw-mz-stand.is-feet{z-index:5;width:75.1%;margin:-13% 0 0 14%;filter:none}
  /* transparante plaat: houder volledig zichtbaar, ervoor; gekleurd of marmer: halve houder achter de plaat */
  .hw-mz-stage.is-clear ~ .hw-mz-stand{z-index:5}
  .hw-mz-drag{position:absolute;left:10%;top:5.2%;width:80%;height:53.333%;touch-action:none;cursor:grab}
  .hw-mz-drag:active{cursor:grabbing}
  .hw-mz-phone{margin:10px 0 0;text-align:left}
  .hw-mz-phonebtn{background:none !important;border:0;padding:4px 0;font:inherit;font-size:13px;font-weight:600;color:#111 !important;text-decoration:underline;cursor:pointer}
  .hw-mz-phonebox{margin-top:8px;padding:14px;border:1.5px solid #E2E2E2;border-radius:16px;background:#fff;text-align:center}
  .hw-mz-phonetext{font-size:14px;color:#555;margin-bottom:10px}
  .hw-mz-qr{display:block;margin:0 auto;width:180px;height:180px;border:1px solid #E2E2E2;border-radius:10px;background:#fff}
  .hw-mz-phonestatus{margin-top:10px;font-size:13px;color:#777;min-height:18px}
  .hw-mz-phonestatus.ok{color:#1b6e2f;font-weight:600}
  .hw-mz-hint{text-align:center;font-size:12px;color:#777;margin-top:6px}
  .hw-mz-sticky.is-stuck{box-shadow:-16px 0 0 #fff,16px 0 0 #fff,0 12px 0 #fff}
  .hw-mz-label{display:block;font-size:14px;font-weight:700;color:#121212;margin:20px 0 8px}
  .hw-mz-req{font-weight:400;font-size:12px;color:#b3261e}
  .hw-mz-small{font-size:12px;color:#666;margin:10px 0 4px}
  .hw-mz-input{width:100%;padding:12px 14px;border:1.5px solid #8A8A8A;border-radius:12px;font:inherit;font-size:16px;color:#222;background:#fff}
  .hw-mz-gap{margin-top:8px}
  .hw-mz-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .hw-mz-row{display:flex;align-items:center;gap:12px;margin-top:10px}
  .hw-mz-row input{flex:1}
  .hw-mz-row .hw-mz-small{margin:0;min-width:64px}
  .hw-mz-filebtn{display:flex;align-items:center;gap:8px;max-width:100%;min-width:0;cursor:pointer}
  .hw-mz-b{flex:none;border:1.5px solid #D0D0D0;border-radius:999px;padding:7px 14px;font-size:13px;background:#fff;color:#222}
  .hw-mz-n{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:#777}
  .hw-mz-modes{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px}
  .hw-mz-mode{border:1.5px solid #D0D0D0;border-radius:999px;background:#fff !important;color:#222 !important;padding:6px 12px;font:inherit;font-size:13px;cursor:pointer}
  .hw-mz-mode[aria-pressed="true"]{border-color:#111;background:#111 !important;color:#fff !important}
  .hw-mz-searchwrap{position:relative}
  .hw-mz-sugg{position:absolute;z-index:30;left:0;right:0;top:100%;margin-top:4px;background:#fff;border:1px solid #D0D0D0;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.14);overflow:hidden;max-height:340px;overflow-y:auto}
  .hw-mz-sugg button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;background:#fff;padding:8px 12px;font:inherit;font-size:14px;color:#222;cursor:pointer;border-bottom:1px solid #F0F0F0}
  .hw-mz-sugg button:last-child{border-bottom:0}
  .hw-mz-sugg button:hover,.hw-mz-sugg button:focus{background:#F5F5F5;outline:0}
  .hw-mz-sugg img{width:40px;height:40px;border-radius:4px;object-fit:cover;flex:none}
  .hw-mz-sugg small{display:block;color:#777;font-size:12px}
  .hw-mz-linkbtn{border:0;background:none;color:#555;text-decoration:underline;font:inherit;font-size:13px;padding:6px 0;cursor:pointer}
  .hw-mz-holders{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
  .hw-mz-holder{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;border:1.5px solid #D0D0D0;border-radius:14px;background:#fff !important;color:#222 !important;padding:10px 8px;font:inherit;font-size:12.5px;line-height:1.3;cursor:pointer}
  .hw-mz-holder img{width:100%;max-width:96px;aspect-ratio:1/1;object-fit:cover;border-radius:10px;background:#f4f4f4}
  .hw-mz-holder .hw-mz-none{width:100%;max-width:96px;aspect-ratio:1/1;border-radius:10px;background:#f4f4f4;display:flex;align-items:center;justify-content:center;font-size:26px;color:#999}
  .hw-mz-sizes{grid-template-columns:repeat(auto-fit,minmax(110px,1fr))}
  .hw-mz-size{min-width:0;box-sizing:border-box;overflow:hidden;overflow-wrap:anywhere;hyphens:auto;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:4px;text-align:center;min-height:78px;border:1.5px solid #D0D0D0;border-radius:14px;background:#fff !important;color:#222 !important;padding:10px 8px;font:inherit;font-size:12.5px;line-height:1.3;cursor:pointer}
  .hw-mz-size b{font-weight:600;font-size:14px}
  .hw-mz-size small{color:#666;font-size:12px;max-width:100%;overflow-wrap:anywhere;hyphens:auto}
  .hw-mz-size small:last-child{margin-top:auto}
  .hw-mz-size[aria-pressed="true"]{border-color:#111;box-shadow:0 0 0 1px #111}
  .hw-mz-holder b{font-weight:600}
  .hw-mz-holder small{color:#666;font-size:12px}
  .hw-mz-holder[aria-pressed="true"]{border-color:#111;box-shadow:0 0 0 1px #111}
  .hw-mz-status{margin-top:14px;font-size:13px;color:#555;min-height:18px}
  .hw-mz-status.err{color:#b3261e}
</style>

<script>
(function () {
  var FONT_CSS = 'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap';
  var PX = 4;                               // pixels per mm op het canvas (200x300 mm => 800x1200)
  var PT = 0.352778 * PX;                   // 1 punt in canvas-pixels (de icoon-paden staan in punten)
  var ZONE = { x: 20, top: 15.6, size: 160 };
  var RED = '#de2638';

  function loadFontsCss() {
    if (document.getElementById('hw-mz-fonts')) return;
    var l = document.createElement('link'); l.id = 'hw-mz-fonts'; l.rel = 'stylesheet'; l.href = FONT_CSS; document.head.appendChild(l);
  }
  function fontsReady() {
    if (!(document.fonts && document.fonts.load)) return Promise.resolve();
    return Promise.all([document.fonts.load('700 40px Montserrat'), document.fonts.load('400 40px Montserrat')]);
  }

  function initOne(root) {
    if (root.dataset.hwMzInit) return; root.dataset.hwMzInit = '1';
    loadFontsCss();
    var API = (root.dataset.api || '').replace(/\/$/, '');
    var $ = function (s) { return root.querySelector(s); };
    var canvas = $('[data-mz-canvas]'), ctx = canvas.getContext('2d', { colorSpace: 'display-p3' });
    var stageEl = canvas.parentNode;
    var statusEl = $('[data-mz-status]'), suggEl = $('[data-mz-sugg]'), searchEl = $('[data-mz-search]');
    var r1El = $('[data-mz-r1]'), r2El = $('[data-mz-r2]'), t0El = $('[data-mz-t0]'), t1El = $('[data-mz-t1]'), dotEl = $('[data-mz-dot]');
    var linkEl = $('[data-mz-link]'), qrLinkEl = $('[data-mz-qrlink]'), zoomEl = $('[data-mz-zoom]');

    var S = { filter: 'Kleur', tekst: 'Zwarte tekst', code: 'geen', bg: 'Transparant', heart: 'Rood', track: null,

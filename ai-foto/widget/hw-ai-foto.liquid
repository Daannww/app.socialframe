{%- if product.metafields.custom.ai_stijlen.value != blank -%}
{%- assign hw_ai_api = 'https://ai-foto-production.up.railway.app' -%}
{%- assign hw_ai_profile = 'tegel' -%}
{%- if product.metafields.custom.ai_formaat.value != blank -%}
  {%- assign hw_ai_profile = product.metafields.custom.ai_formaat.value -%}
{%- endif -%}

<div class="hw-ai" data-hw-ai data-api="{{ hw_ai_api }}" data-profile="{{ hw_ai_profile }}" data-product="{{ product.handle }}" data-styles="{{ product.metafields.custom.ai_stijlen.value | escape }}">
  <div class="hw-ai-heading">Personaliseren</div>

  <div class="hw-ai-history" data-hw-ai-history hidden>
    <div class="hw-ai-label">Herbestelling? Gebruik je ontwerp opnieuw</div>
    <div class="hw-ai-hist-list" data-hw-ai-histlist></div>
  </div>

  <div class="hw-ai-label">Selecteer stijl:</div>
  <div class="hw-ai-designs" data-hw-ai-designs></div>

  <div class="hw-ai-textwrap" data-hw-ai-textwrap hidden>
    <label class="hw-ai-label"><span data-hw-ai-textlabel>Eigen tekst</span> <span class="hw-ai-opt" data-hw-ai-opt>(optioneel)</span></label>
    <input type="text" class="hw-ai-text" data-hw-ai-text maxlength="40" autocomplete="off" placeholder="Vul je tekst in">
    <div class="hw-ai-count" data-hw-ai-count></div>
  </div>

  <div class="hw-ai-orient" data-hw-ai-orient hidden>
    <label><input type="radio" name="hw-ai-orient" value="landscape" checked> Liggend</label>
    <label><input type="radio" name="hw-ai-orient" value="portrait"> Staand</label>
  </div>

  <label class="hw-ai-upload" data-hw-ai-upload>
    <input type="file" accept="image/*" data-hw-ai-file hidden>
    <img class="hw-ai-thumb" data-hw-ai-thumb alt="" hidden>
    <span class="hw-ai-plus" data-hw-ai-plus>+</span>
    <span class="hw-ai-uptext" data-hw-ai-filelabel>Klik hier om je foto te uploaden</span>
  </label>

  <div class="hw-ai-cropstage" data-hw-ai-cropstage hidden>
    <div class="hw-ai-cropwrap" data-hw-ai-cropwrap>
      <img data-hw-ai-cropimg alt="">
      <div class="hw-ai-cropbox" data-hw-ai-cropbox><i data-h="nw"></i><i data-h="ne"></i><i data-h="sw"></i><i data-h="se"></i><i data-h="n"></i><i data-h="s"></i><i data-h="w"></i><i data-h="e"></i></div>
    </div>
    <div class="hw-ai-croptip">Wil je maar een deel van je foto? Sleep over de foto om dat deel te kiezen. <button type="button" class="hw-ai-cropreset" data-hw-ai-cropreset>Hele foto gebruiken</button></div>
  </div>

  <button type="button" class="hw-ai-btn" data-hw-ai-go disabled>Maak mijn tegeltje</button>
  <div class="hw-ai-loader" data-hw-ai-loader hidden><div class="hw-ai-bar"><i></i></div><div class="hw-ai-loadtext">Je afbeelding wordt gemaakt… dit duurt ongeveer 20 tot 60 seconden</div></div>
  <div class="hw-ai-status" data-hw-ai-status role="status" aria-live="polite"></div>
  <div class="hw-ai-choose" data-hw-ai-choose hidden>
    <div class="hw-ai-label">Kies je favoriet:</div>
    <div class="hw-ai-choose-list" data-hw-ai-chooselist></div>
  </div>
  <div class="hw-ai-result" data-hw-ai-result hidden>
    <img data-hw-ai-img alt="Jouw AI-afbeelding">
    <div class="hw-ai-ok">Mooi! Deze afbeelding wordt op je product gedrukt.</div>
  </div>
</div>

<style>
  .hw-ai-heading{font-family:inherit;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#111;margin:0 0 16px}
  .hw-ai{font-family:inherit;font-size:15px;color:#333;border:1.5px solid #E2E2E2;border-radius:24px;background:#fff;padding:22px 18px 20px;margin:1.75rem 0 1rem;box-sizing:border-box}
  .hw-ai *{box-sizing:border-box}
  .hw-ai [hidden]{display:none !important}
  .hw-ai-label{font-size:16px;letter-spacing:.02em;color:#444;margin:0 0 10px;display:block}
  .hw-ai-opt{font-size:14px;color:#999}
  .hw-ai-designs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:22px;align-items:start}
  .hw-ai-design{border:3px solid transparent;border-radius:14px;background:#fff;padding:3px;cursor:pointer;text-align:center;font:inherit;color:#333;min-width:0}
  .hw-ai-design img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;display:block;background:#f0f0f0}
  .hw-ai-design span{display:block;margin-top:6px;font-size:14px;line-height:1.25}
  .hw-ai-design[aria-pressed="true"]{border-color:#5B9BD5}
  .hw-ai-history{margin-bottom:20px}
  .hw-ai-hist-list{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px}
  .hw-ai-histwrap{flex:0 0 96px;text-align:center}
  .hw-ai-histwrap .hw-ai-hist{width:100%}
  .hw-ai-histbtns{display:flex;gap:6px;justify-content:center;margin-top:6px}
  .hw-ai-ico{min-width:34px;height:34px;padding:0 8px;border:1px solid #E2E2E2;border-radius:10px;background:#F3F4F6;color:#111;display:inline-flex;align-items:center;justify-content:center;font:inherit;font-size:12px;font-weight:600;cursor:pointer}
  .hw-ai-ico:hover{border-color:#999}
  .hw-ai-del{background:#FBE4E4;border-color:#F0C8C8;color:#111}
  .hw-ai-del.sure{background:#c62828;border-color:#c62828;color:#fff}
  .hw-ai-hist{flex:0 0 84px;border:2px solid #E2E2E2;border-radius:14px;background:#fff;padding:4px;cursor:pointer;font:inherit;color:#333;text-align:center}
  .hw-ai-hist:hover{border-color:#5B9BD5}
  .hw-ai-hist img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;display:block}
  .hw-ai-hist span{display:block;font-size:11px;margin-top:4px;line-height:1.2}
  .hw-ai-textwrap{margin-bottom:0}
  .hw-ai-text{width:100%;padding:15px 16px;border:1.5px solid #8A8A8A;border-radius:14px;font:inherit;font-size:17px;color:#222;background:#fff}
  .hw-ai-text::placeholder{color:#bbb}
  .hw-ai-count{text-align:right;font-size:13px;color:#aaa;margin:4px 0 6px}
  .hw-ai-orient{display:flex;gap:18px;margin:0 0 18px}
  .hw-ai-upload{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:10px;min-height:48px;border:1.5px dashed #CFCFCF;border-radius:999px;padding:8px 14px;text-align:center;cursor:pointer;background:#fff;margin-bottom:12px;margin-top:6px;color:#777;overflow:hidden}
  .hw-ai-upload:hover{border-color:#999}
  .hw-ai-plus{font-size:22px;line-height:1;color:#999;font-weight:300}
  .hw-ai-uptext{font-size:14px}
  .hw-ai-uptext{display:flex;flex-direction:column;align-items:flex-start;min-width:0;text-align:left}
  .hw-ai-fname{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#333;font-size:14px}
  .hw-ai-change{font-size:13px;font-weight:600;color:#111;text-decoration:underline}
  .hw-ai-thumb{width:34px;height:34px;object-fit:cover;border-radius:8px;display:block}
  .hw-ai-btn{width:100%;border:1.5px solid #111;border-radius:999px;background:#fff;color:#111;padding:11px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
  .hw-ai .hw-ai-btn:hover:not(:disabled),.hw-ai .hw-ai-btn:focus-visible:not(:disabled){background:#111 !important;color:#fff !important;border-color:#111 !important}
  .hw-ai-btn:disabled{opacity:.4;cursor:not-allowed}
  .hw-ai-choose{margin-top:16px}
  .hw-ai-choose-list{display:block}
  .hw-ai-group{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:16px}
  .hw-ai-group:first-child{margin-top:0}
  .hw-ai-grouptitle{grid-column:1/-1;font-size:13px;opacity:.65;text-align:left}
  .hw-ai-group:only-child .hw-ai-grouptitle{display:none}
  .hw-ai-choicewrap{min-width:0;text-align:center}
  .hw-ai-zoombtn{margin-top:4px;background:none;border:0;padding:4px;font:inherit;font-size:13px;font-weight:600;color:#111;text-decoration:underline;cursor:pointer}
  .hw-ai img,.hw-ai-zoomimg{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
  .hw-ai-result img{cursor:zoom-in}
  .hw-ai-zoom{position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.88);display:none;align-items:center;justify-content:center;padding:16px;box-sizing:border-box;cursor:zoom-out}
  .hw-ai-zoomimg{width:min(94vw,94vh);height:min(94vw,94vh);max-width:100%;background-size:contain;background-repeat:no-repeat;background-position:center}
  .hw-ai-zoomclose{position:absolute;top:10px;right:14px;background:none;border:0;color:#fff;font-size:38px;line-height:1;cursor:pointer}
  .hw-ai-choice{border:3px solid transparent;border-radius:16px;padding:3px;background:#fff;cursor:pointer;min-width:0}
  .hw-ai-choice img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:13px;display:block;background:#f0f0f0}
  .hw-ai-choice span{display:block;margin-top:6px;font-size:13px;color:#444}
  .hw-ai-choice[aria-pressed="true"]{border-color:#5B9BD5}
  .hw-ai-croptoggle{display:flex;align-items:center;gap:8px;margin:2px 0 12px;font-size:14px;color:#333;cursor:pointer}
  .hw-ai-croptoggle input{width:18px;height:18px;margin:0}
  .hw-ai-cropstage{margin:0 0 14px;text-align:center}
  .hw-ai-cropwrap{cursor:crosshair;position:relative;display:inline-block;max-width:100%;line-height:0;touch-action:none;-webkit-user-select:none;user-select:none}
  .hw-ai-cropwrap img{max-width:100%;max-height:340px;display:block;border-radius:10px;-webkit-user-drag:none}
  .hw-ai-cropbox{position:absolute;border:2px solid #fff;box-shadow:0 0 0 9999px rgba(0,0,0,.5);cursor:move;box-sizing:border-box;outline:1px solid rgba(0,0,0,.4)}
  .hw-ai-cropbox i{position:absolute;width:20px;height:20px;background:#fff;border:2px solid #111;border-radius:50%;box-sizing:border-box}
  .hw-ai-cropbox i[data-h=nw]{left:2px;top:2px;cursor:nwse-resize}
  .hw-ai-cropbox i[data-h=ne]{right:2px;top:2px;cursor:nesw-resize}
  .hw-ai-cropbox i[data-h=sw]{left:2px;bottom:2px;cursor:nesw-resize}
  .hw-ai-cropbox i[data-h=se]{right:2px;bottom:2px;cursor:nwse-resize}
  .hw-ai-cropbox i[data-h=n]{left:50%;top:2px;margin-left:-10px;cursor:ns-resize}
  .hw-ai-cropbox i[data-h=s]{left:50%;bottom:2px;margin-left:-10px;cursor:ns-resize}
  .hw-ai-cropbox i[data-h=w]{top:50%;left:2px;margin-top:-10px;cursor:ew-resize}
  .hw-ai-cropbox i[data-h=e]{top:50%;right:2px;margin-top:-10px;cursor:ew-resize}
  .hw-ai-cropwrap{overflow:hidden;border-radius:10px}
  .hw-ai-cropbox{touch-action:none}
  .hw-ai-cropreset{background:none;border:0;padding:0;font:inherit;font-weight:600;color:#111;text-decoration:underline;cursor:pointer}
  .hw-ai-croptip{margin-top:8px;font-size:13px;color:#666}
  .hw-ai-loader{margin-top:14px;text-align:center}
  .hw-ai-bar{height:8px;border-radius:99px;background:#EEE;overflow:hidden;position:relative}
  .hw-ai-bar i{position:absolute;top:0;bottom:0;width:40%;border-radius:99px;background:#222;animation:hwai 1.2s ease-in-out infinite}
  @keyframes hwai{0%{left:-40%}100%{left:100%}}
  .hw-ai-loadtext{margin-top:8px;font-size:14px;color:#555}
  .hw-ai-help{margin-top:14px;padding:12px 16px;border-radius:14px;background:#F7F5F2;text-align:center;font-size:13px;line-height:1.5;color:#666}
  .hw-ai-help-title{display:block;margin-bottom:2px;font-size:14px;font-weight:600;color:#111;letter-spacing:.01em}
  .hw-ai-left{margin-top:8px;text-align:center;font-size:.9em;opacity:.8}
  .hw-ai-left.out{font-size:16px;font-weight:700;padding:12px;border-radius:12px;background:#fdecea;margin-top:10px}
  .hw-ai-left.low{color:#b00020;opacity:1}
  .hw-ai-status{margin-top:12px;min-height:1em;text-align:center}
  .hw-ai-status.err{color:#b00020}
  .hw-ai-result{margin-top:16px;text-align:center}
  .hw-ai-result img{max-width:100%;border-radius:16px;display:block;margin:0 auto 8px}
  .hw-ai-ok{color:#666}
  @media(max-width:480px){.hw-ai{padding:20px 14px 16px}.hw-ai-design span{font-size:13px}}
</style>

<script>
(function () {
  // Het thema kan dit blok twee keer op de pagina zetten (bv. een versie voor mobiel en een voor desktop).
  // Daarom starten we elk blok apart, en slaan we blokken die al draaien over.
  function initOne(root, idx) {
  if (root.dataset.hwAiInit) return;
  root.dataset.hwAiInit = '1';
  var API = (root.dataset.api || '').replace(/\/$/, '');
  var PROFILE = root.dataset.profile === 'poster' ? 'poster' : 'tegel';
  var STYLES = (root.dataset.styles || '').trim();
  var $ = function (s) { return root.querySelector(s); };
  var designsEl = $('[data-hw-ai-designs]'), fileEl = $('[data-hw-ai-file]'), fileLabel = $('[data-hw-ai-filelabel]');
  var loaderEl = $('[data-hw-ai-loader]'), loadText = $('.hw-ai-loadtext');
  var leftEl = document.createElement('div'); leftEl.hidden = true;
  var goBtn = $('[data-hw-ai-go]'), statusEl = $('[data-hw-ai-status]'), resultEl = $('[data-hw-ai-result]');
  var imgEl = $('[data-hw-ai-img]'), orientEl = $('[data-hw-ai-orient]');
  var textWrap = $('[data-hw-ai-textwrap]'), textEl = $('[data-hw-ai-text]'), textLabel = $('[data-hw-ai-textlabel]');
  var histBox = $('[data-hw-ai-history]'), histList = $('[data-hw-ai-histlist]');
  var chooseBox = $('[data-hw-ai-choose]'), chooseList = $('[data-hw-ai-chooselist]');
  var optEl = $('[data-hw-ai-opt]'), countEl = $('[data-hw-ai-count]'), thumbEl = $('[data-hw-ai-thumb]'), plusEl = $('[data-hw-ai-plus]');
  // design: gekozen ontwerp; result: afbeelding die bij de bestelling hoort (nieuw of hergebruikt)
  var state = { pending: null, design: null, designName: '', allowsText: false, textRequired: false, result: null, busy: false, left: null };
  if (PROFILE === 'poster') orientEl.hidden = false;
  root.querySelectorAll('input[type="radio"]').forEach(function (r) { r.name = 'hw-ai-orient-' + idx; });

  var clientId;
  try { clientId = localStorage.getItem('hw_ai_client'); } catch (e) {}
  if (!clientId) {
    clientId = 'c' + Math.random().toString(36).slice(2) + Date.now().toString(36);
    try { localStorage.setItem('hw_ai_client', clientId); } catch (e) {}
  }

  goBtn.parentNode.insertBefore(leftEl, goBtn.nextSibling);
  var helpEl = document.createElement('div'); helpEl.className = 'hw-ai-help'; helpEl.hidden = true;
  helpEl.innerHTML = '<span class="hw-ai-help-title">Lukt het niet helemaal?</span>Geen zorgen, wij denken graag met je mee. Bestel het ontwerp dat je het mooiste vindt en stuur ons een berichtje via de chat met je bestelnummer, dan stellen we je ontwerp persoonlijk voor je bij.';
  leftEl.parentNode.insertBefore(helpEl, leftEl.nextSibling);
  function hideAll() {
    root.hidden = true;
  }
  function say(t, err) { statusEl.textContent = t || ''; statusEl.className = 'hw-ai-status' + (err ? ' err' : ''); }
  function refresh() {
    helpEl.hidden = !(typeof state.left === 'number' && (state.left === 0 || (state.max || 0) - state.left >= 4));
    loaderEl.hidden = !state.busy;
    if (typeof state.left === 'number') {
      leftEl.hidden = false;
      leftEl.textContent = state.left > 0 ? 'Nog ' + state.left + (state.left === 1 ? ' poging' : ' pogingen') + ' beschikbaar' : 'Je credits zijn op. Probeer het morgen weer.';
      leftEl.className = 'hw-ai-left' + (state.left <= 1 ? ' low' : '') + (state.left === 0 ? ' out' : '');
    }
    var needText = state.allowsText && state.textRequired && !textEl.value.trim();
    goBtn.disabled = state.busy || !state.design || !fileEl.files[0] || state.left === 0 || needText;
  }
  function fmtDate(iso) {
    var d = new Date(String(iso).replace(' ', 'T') + 'Z');
    return isNaN(d) ? '' : d.getDate() + '-' + (d.getMonth() + 1) + '-' + d.getFullYear();
  }

  function getForms() {
    var f = document.querySelectorAll('.product-form .form');
    if (f.length) return f;
    var fb = document.querySelector('form[data-type="add-to-cart-form"]');
    return fb ? [fb] : [];
  }
  // Gegevens die bij de bestelling komen. "AI herbestelling" staat er alleen bij een hergebruikte afbeelding.
  function setProps(on) {
    getForms().forEach(function (form) {
      form.querySelectorAll('[data-hw-ai-prop]').forEach(function (el) { el.remove(); });
      if (!on) return;
      var r = state.result;
      var props = {
        'properties[Uw personalisatie]': r.preview_url,
        'properties[Stijl]': r.design,
        'properties[_AI drukbestand]': r.print_url,
        'properties[_AI job]': r.job_id
      };
      if (r.text) props['properties[AI tekst]'] = r.text;
      if (r.reused) props['properties[AI herbestelling]'] = 'Ja, bestaande afbeelding van ' + fmtDate(r.created_at) + ' (job ' + r.job_id.slice(0, 8) + ')';
      Object.keys(props).forEach(function (name) {
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = name; i.value = props[name];
        i.setAttribute('data-hw-ai-prop', '');
        form.appendChild(i);
      });
    });
  }

  function showResult(r) {
    state.result = r; state.pending = null;
    if (r.reused) { chooseBox.hidden = true; chooseList.replaceChildren(); }
    imgEl.src = r.preview_url; resultEl.hidden = false; setProps(true);
    resultEl.querySelector('.hw-ai-ok').textContent = r.reused
      ? 'Deze eerder gemaakte afbeelding wordt opnieuw gebruikt. Zo krijg je precies hetzelfde tegeltje.'
      : 'Mooi! Deze afbeelding wordt op je product gedrukt.';
  }

  function loadHistory() {
    fetch(API + '/api/history?client_id=' + encodeURIComponent(clientId) + '&profile=' + PROFILE)
      .then(function (r) { return r.json(); })
      .then(function (d) {
        histList.replaceChildren();
        (d.items || []).forEach(function (it) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'hw-ai-hist';
          var im = document.createElement('img'); im.src = it.preview_url; im.alt = ''; im.loading = 'lazy';
          var sp = document.createElement('span'); sp.textContent = (it.text || it.design || '') + ' · ' + fmtDate(it.created_at);
          b.appendChild(im); b.appendChild(sp); protect(im);
          b.addEventListener('click', function () { reuse(it.job_id); });
          var wrap = document.createElement('div'); wrap.className = 'hw-ai-histwrap';
          var row = document.createElement('div'); row.className = 'hw-ai-histbtns';
          var zoom = document.createElement('button'); zoom.type = 'button'; zoom.className = 'hw-ai-ico'; zoom.setAttribute('aria-label', 'Vergroten');
          zoom.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>';
          zoom.addEventListener('click', function () { openZoom(it.preview_url); });
          var del = document.createElement('button'); del.type = 'button'; del.className = 'hw-ai-ico hw-ai-del'; del.setAttribute('aria-label', 'Verwijderen');
          var trash = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>';
          del.innerHTML = trash;
          var sure = false, t = null;
          del.addEventListener('click', function () {
            if (!sure) { sure = true; del.classList.add('sure'); del.textContent = 'Zeker?'; clearTimeout(t); t = setTimeout(function () { sure = false; del.classList.remove('sure'); del.innerHTML = trash; }, 3000); return; }
            clearTimeout(t); del.disabled = true;
            fetch(API + '/api/jobs/' + it.job_id + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId }) })
              .then(function (r) { if (!r.ok) throw new Error(); wrap.remove(); if (!histList.children.length) histBox.hidden = true; })
              .catch(function () { del.disabled = false; sure = false; del.classList.remove('sure'); del.innerHTML = trash; say('Verwijderen is niet gelukt, probeer het opnieuw.', true); });
          });
          row.appendChild(zoom); row.appendChild(del);
          wrap.appendChild(b); wrap.appendChild(row);
          histList.appendChild(wrap);
        });
        histBox.hidden = !(d.items || []).length;
      })
      .catch(function () {});
  }

  function reuse(jobId) {
    if (state.busy) return;
    say('Even laden…');
    fetch(API + '/api/reuse', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ job_id: jobId, client_id: clientId }) })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (!x.ok) { say(x.j.error || 'Niet beschikbaar.', true); return; }
        x.j.reused = true; showResult(x.j); say('');
      })
      .catch(function () { say('Geen verbinding, probeer het opnieuw.', true); });
  }

  var q = '?product=' + encodeURIComponent(root.dataset.product || '') + (STYLES ? '&styles=' + encodeURIComponent(STYLES) : '');
  fetch(API + '/api/designs' + q + '&client_id=' + encodeURIComponent(clientId))
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.attempts_left !== undefined) state.left = d.attempts_left;
      if (d.max_attempts) state.max = d.max_attempts;
      if (d.text_max) textEl.maxLength = d.text_max;
      count();
      (d.designs || []).forEach(function (x) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'hw-ai-design'; b.setAttribute('aria-pressed', 'false');
        if (x.example_url) { var im = document.createElement('img'); im.src = x.example_url; im.alt = ''; im.loading = 'lazy'; b.appendChild(im); }
        var s = document.createElement('span'); s.textContent = x.name; b.appendChild(s);
        b.addEventListener('click', function () {
          designsEl.querySelectorAll('.hw-ai-design').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });
          b.setAttribute('aria-pressed', 'true');
          state.design = x.id; state.designName = x.name; state.allowsText = !!x.allows_text; state.textRequired = !!x.text_required;
          optEl.textContent = x.text_required ? '(verplicht)' : '(optioneel)';
          textWrap.hidden = !x.allows_text; textLabel.textContent = x.text_label || 'Eigen tekst';
          if (!x.allows_text) textEl.value = '';
          count();
          refresh();
        });
        designsEl.appendChild(b);
      });
      if (!(d.designs || []).length) hideAll(); else { loadHistory(); loadRecent((d.designs || []).map(function (x) { return x.id; })); }
    })
    .catch(function () { hideAll(); });

  // Uitsnede: direct na het uploaden zichtbaar. Standaard de hele foto; de klant kan overal over de foto slepen om een deel te kiezen,
  // en het vak daarna verplaatsen of aan de randen/hoeken aanpassen. Niet aan een vaste verhouding gebonden.
  var cropStage = $('[data-hw-ai-cropstage]'), cropReset = $('[data-hw-ai-cropreset]');
  var cropWrap = $('[data-hw-ai-cropwrap]'), cropImg = $('[data-hw-ai-cropimg]'), cropBox = $('[data-hw-ai-cropbox]');
  var crop = { x: 0, y: 0, w: 1, h: 1 };
  function cropActive() { return crop.w < 0.985 || crop.h < 0.985; }
  function drawCrop() {
    cropBox.style.left = (crop.x * 100) + '%'; cropBox.style.top = (crop.y * 100) + '%';
    cropBox.style.width = (crop.w * 100) + '%'; cropBox.style.height = (crop.h * 100) + '%';
    cropReset.hidden = !cropActive();
    cropBox.style.display = cropActive() ? 'block' : 'none';
  }
  var clamp01 = function (v) { return Math.min(1, Math.max(0, v)); };
  var drag = null, MINC = 0.08;
  function pt(e, r) { return { x: clamp01((e.clientX - r.left) / r.width), y: clamp01((e.clientY - r.top) / r.height) }; }
  cropWrap.addEventListener('pointerdown', function (e) {
    var h = e.target.getAttribute && e.target.getAttribute('data-h');
    var r = cropWrap.getBoundingClientRect();
    var onBox = e.target === cropBox;
    if (h) drag = { mode: h, c: { x: crop.x, y: crop.y, w: crop.w, h: crop.h }, sx: e.clientX, sy: e.clientY, r: r };
    else if (onBox && cropActive()) drag = { mode: 'move', c: { x: crop.x, y: crop.y, w: crop.w, h: crop.h }, sx: e.clientX, sy: e.clientY, r: r };
    else { var p0 = pt(e, r); drag = { mode: 'new', p0: p0, r: r }; }
    try { cropWrap.setPointerCapture(e.pointerId); } catch (x) {}
    e.preventDefault();
  });
  cropWrap.addEventListener('pointermove', function (e) {
    if (!drag) return;
    var r = drag.r;
    if (drag.mode === 'new') {
      var p1 = pt(e, r), x0 = Math.min(drag.p0.x, p1.x), y0 = Math.min(drag.p0.y, p1.y);
      var w = Math.abs(p1.x - drag.p0.x), h = Math.abs(p1.y - drag.p0.y);
      if (w < 0.02 && h < 0.02) return;
      crop = { x: x0, y: y0, w: Math.max(w, MINC), h: Math.max(h, MINC) };
      if (crop.x + crop.w > 1) crop.x = 1 - crop.w; if (crop.y + crop.h > 1) crop.y = 1 - crop.h;
      drawCrop(); return;
    }
    var dx = (e.clientX - drag.sx) / r.width, dy = (e.clientY - drag.sy) / r.height, c = drag.c;
    var x = c.x, y = c.y, w = c.w, h = c.h, m = drag.mode;
    if (m === 'move') {
      x = Math.min(1 - w, Math.max(0, c.x + dx)); y = Math.min(1 - h, Math.max(0, c.y + dy));
    } else {
      if (m.indexOf('w') > -1) { x = Math.min(c.x + c.w - MINC, Math.max(0, c.x + dx)); w = c.x + c.w - x; }
      if (m.indexOf('e') > -1) { w = Math.min(1 - c.x, Math.max(MINC, c.w + dx)); }
      if (m.indexOf('n') > -1) { y = Math.min(c.y + c.h - MINC, Math.max(0, c.y + dy)); h = c.y + c.h - y; }
      if (m.indexOf('s') > -1) { h = Math.min(1 - c.y, Math.max(MINC, c.h + dy)); }
    }
    crop = { x: x, y: y, w: w, h: h }; drawCrop();
  });
  function endDrag() { drag = null; }
  cropWrap.addEventListener('pointerup', endDrag); cropWrap.addEventListener('pointercancel', endDrag);
  cropReset.addEventListener('click', function () { crop = { x: 0, y: 0, w: 1, h: 1 }; drawCrop(); });
  function resetCrop(f) {
    crop = { x: 0, y: 0, w: 1, h: 1 };
    cropStage.hidden = !f;
    if (f) { try { cropImg.src = URL.createObjectURL(f); } catch (e) {} }
    drawCrop();
  }

  fileEl.addEventListener('change', function () {
    var f = fileEl.files[0];
    resetCrop(f);
    if (f) {
      try { thumbEl.src = URL.createObjectURL(f); thumbEl.hidden = false; plusEl.hidden = true; } catch (e) {}
      fileLabel.textContent = '';
      var nm = document.createElement('span'); nm.className = 'hw-ai-fname'; nm.textContent = f.name;
      var ch = document.createElement('span'); ch.className = 'hw-ai-change'; ch.textContent = 'Andere foto kiezen';
      fileLabel.appendChild(nm); fileLabel.appendChild(ch);
    } else {
      thumbEl.hidden = true; plusEl.hidden = false; fileLabel.textContent = 'Klik hier om je foto te uploaden';
    }
    refresh();
  });
  function count() {
    var left = (textEl.maxLength > 0 ? textEl.maxLength : 40) - textEl.value.length;
    countEl.textContent = left + ' tekens over';
  }
  textEl.addEventListener('input', function () { count(); refresh(); });


  // Voorbeelden: geen slepen/rechtsklik/lang indrukken. Volledig kopieerbaar voorkomen kan een website niet (printscreen), daarom staat er ook een watermerk in het voorbeeld.
  function protect(el) {
    el.draggable = false;
    el.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    el.addEventListener('dragstart', function (e) { e.preventDefault(); });
  }
  var zoomEl = null;
  function openZoom(url) {
    if (!zoomEl) {
      zoomEl = document.createElement('div');
      zoomEl.className = 'hw-ai-zoom';
      zoomEl.innerHTML = '<div class="hw-ai-zoomimg"></div><button type="button" class="hw-ai-zoomclose" aria-label="Sluiten">&times;</button>';
      zoomEl.addEventListener('contextmenu', function (e) { e.preventDefault(); });
      zoomEl.addEventListener('click', function () { zoomEl.style.display = 'none'; });
      document.body.appendChild(zoomEl);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && zoomEl) zoomEl.style.display = 'none'; });
    }
    zoomEl.querySelector('.hw-ai-zoomimg').style.backgroundImage = 'url("' + url + '")';
    zoomEl.style.display = 'flex';
  }
  imgEl.addEventListener('click', function () { if (imgEl.src) openZoom(imgEl.src); });
  protect(imgEl);

  // Meerdere varianten: de klant moet er eerst één kiezen, pas daarna kan er besteld worden.
  function showChoices(j, restore) {
    if (!restore) { state.pending = j.job_id; state.result = null; setProps(false); resultEl.hidden = true; }
    chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });
    var group = document.createElement('div'); group.className = 'hw-ai-group';
    var gt = document.createElement('div'); gt.className = 'hw-ai-grouptitle';
    gt.textContent = 'Poging ' + (chooseList.children.length + 1); group.appendChild(gt);
    j.variants.forEach(function (v, idx) {
      if (v.deleted || !v.preview_url) return;
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'hw-ai-choice'; b.setAttribute('aria-pressed', 'false');
      var im = document.createElement('img'); im.src = v.preview_url; im.alt = 'Variant ' + (idx + 1);
      var sp = document.createElement('span'); sp.textContent = 'Variant ' + (idx + 1);
      b.appendChild(im); b.appendChild(sp); protect(im);
      var wrapB = document.createElement('div'); wrapB.className = 'hw-ai-choicewrap';
      var zb = document.createElement('button'); zb.type = 'button'; zb.className = 'hw-ai-zoombtn'; zb.textContent = 'Vergroten';
      zb.addEventListener('click', function () { openZoom(v.preview_url); });
      var vrow = document.createElement('div'); vrow.className = 'hw-ai-histbtns'; zb.className = 'hw-ai-ico';
      zb.setAttribute('aria-label', 'Vergroten');
      zb.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>';
      var vdel = document.createElement('button'); vdel.type = 'button'; vdel.className = 'hw-ai-ico hw-ai-del'; vdel.setAttribute('aria-label', 'Verwijderen');
      var vtrash = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>';
      vdel.innerHTML = vtrash;
      var vsure = false, vt = null;
      vdel.addEventListener('click', function () {
        if (state.busy) return;
        if (!vsure) { vsure = true; vdel.classList.add('sure'); vdel.textContent = 'Zeker?'; clearTimeout(vt); vt = setTimeout(function () { vsure = false; vdel.classList.remove('sure'); vdel.innerHTML = vtrash; }, 3000); return; }
        clearTimeout(vt); vdel.disabled = true;
        fetch(API + '/api/jobs/' + j.job_id + '/variants/' + idx + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId }) })
          .then(function (r) { return r.json().then(function (x) { if (!r.ok) throw new Error(); return x; }); })
          .then(function (x) {
            if (b.getAttribute('aria-pressed') === 'true') { state.result = null; setProps(false); resultEl.hidden = true; }
            wrapB.remove();
            if (!group.querySelector('.hw-ai-choicewrap')) group.remove();
            if (!chooseList.querySelector('.hw-ai-choicewrap')) { chooseBox.hidden = true; state.pending = null; say('Ontwerp verwijderd. Maak een nieuw ontwerp om verder te gaan.'); refresh(); }
          })
          .catch(function () { vdel.disabled = false; vsure = false; vdel.classList.remove('sure'); vdel.innerHTML = vtrash; say('Verwijderen is niet gelukt, probeer het opnieuw.', true); });
      });
      vrow.appendChild(zb); if (j.chosen === undefined || j.chosen === null) vrow.appendChild(vdel);
      b.addEventListener('click', function () {
        if (state.busy) return;
        state.busy = true; loadText.textContent = 'Je gekozen afbeelding wordt scherp gemaakt voor het drukken…'; refresh(); say('');
        fetch(API + '/api/jobs/' + j.job_id + '/choose', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: clientId, index: idx }) })
          .then(function (r) { return r.json().then(function (x) { return { ok: r.ok, x: x }; }); })
          .then(function (res) {
            state.busy = false; refresh();
            if (!res.ok) { say(res.x.error || 'Mislukt, probeer het opnieuw.', true); return; }
            chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });
            b.setAttribute('aria-pressed', 'true');
            group.querySelectorAll('.hw-ai-del').forEach(function (d) { d.remove(); });
            var keep = state.pending;
            showResult({ job_id: res.x.job_id, design: res.x.design || state.designName, text: res.x.text || '', preview_url: res.x.preview_url, print_url: res.x.print_url, created_at: res.x.created_at, reused: false });
            state.pending = keep; resultEl.hidden = true; loadHistory();
            say('Mooi! Deze afbeelding wordt op je product gedrukt.' + (state.left > 0 ? ' Niet tevreden? Je kunt het nog ' + state.left + ' keer opnieuw proberen.' : ''));
          })
          .catch(function () { state.busy = false; refresh(); say('Geen verbinding, probeer het opnieuw.', true); });
      });
      wrapB.appendChild(b); wrapB.appendChild(vrow); group.appendChild(wrapB);
    });
    chooseList.appendChild(group);
    chooseBox.hidden = false;
    if (restore) return;
    say('Kies hierboven de variant die je het mooiste vindt. Daarna kun je bestellen.');
    group.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Eerdere pogingen blijven ook na een refresh van de pagina staan.
  function loadRecent(designIds) {
    fetch(API + '/api/recent?client_id=' + encodeURIComponent(clientId) + '&profile=' + PROFILE)
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (state.busy || chooseList.children.length) return;
        (d.items || []).forEach(function (it) {
          if (designIds.indexOf(it.design_id) < 0) return;
          showChoices(it, true);
        });
        if (chooseList.children.length) { chooseBox.hidden = false; say('Kies hierboven de variant die je het mooiste vindt. Daarna kun je bestellen.'); }
      })
      .catch(function () {});
  }

  function poll(id) {
    fetch(API + '/api/jobs/' + id).then(function (r) { return r.json(); }).then(function (j) {
      if (j.attempts_left !== undefined) state.left = j.attempts_left;
      if (j.status === 'done') {
        state.busy = false;
        if (j.variants && j.variants.length > 1) {
          showChoices(j);
        } else {
          showResult({ job_id: j.job_id, design: state.designName, text: j.text || '', preview_url: j.preview_url, print_url: j.print_url, reused: false });
          say(state.left > 0 ? 'Niet tevreden? Je kunt het nog ' + state.left + ' keer opnieuw proberen.' : '');
        }
        refresh(); loadHistory();
      } else if (j.status === 'error') {
        state.busy = false; say(j.error || 'Mislukt, probeer het opnieuw.', true); refresh();
      } else { setTimeout(function () { poll(id); }, 2000); }
    }).catch(function (err) { if (window.console) console.error('[hw-ai poll]', err); setTimeout(function () { poll(id); }, 3000); });
  }

  goBtn.addEventListener('click', function () {
    if (state.busy || !fileEl.files[0] || !state.design) return;
    if (state.allowsText && state.textRequired && !textEl.value.trim()) { say('Vul eerst een tekst in.', true); textEl.focus(); return; }
    loadText.textContent = 'Je afbeelding wordt gemaakt… dit duurt ongeveer 20 tot 60 seconden';
    state.busy = true; state.result = null; state.pending = null; resultEl.hidden = true; setProps(false); refresh();
    chooseList.querySelectorAll('.hw-ai-choice').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });
    var o = root.querySelector('input[type="radio"]:checked');
    var fd = new FormData();
    fd.append('photo', fileEl.files[0]); fd.append('design_id', state.design);
    fd.append('profile', PROFILE); fd.append('orientation', o ? o.value : 'landscape'); fd.append('client_id', clientId);
    if (state.allowsText) fd.append('text', textEl.value);
    if (cropActive()) { fd.append('crop_x', crop.x); fd.append('crop_y', crop.y); fd.append('crop_w', crop.w); fd.append('crop_h', crop.h); }
    fetch(API + '/api/generate', { method: 'POST', body: fd })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (!x.ok) { state.busy = false; if (x.j.attempts_left === 0) state.left = 0; say(x.j.error || 'Mislukt', true); refresh(); return; }
        state.left = x.j.attempts_left; refresh(); poll(x.j.job_id);
      })
      .catch(function () { state.busy = false; say('Geen verbinding, probeer het opnieuw.', true); refresh(); });
  });

  // Zonder gekozen afbeelding niet in de winkelwagen: anders krijgen we een bestelling zonder afbeelding.
  function blockIfNoResult(e, target) {
    if (root.hidden || root.offsetParent === null || state.result) return;
    if (!target || !target.closest || !target.closest('.product-form, form[data-type="add-to-cart-form"]')) return;
    e.preventDefault(); e.stopImmediatePropagation();
    var msg = (state.pending || chooseList.children.length) ? 'Kies eerst een van de varianten' : (!fileEl.files[0] ? 'Upload en selecteer eerst een afbeelding' : 'Klik eerst op "' + goBtn.textContent.trim() + '"');
    var anchor = target.matches && target.matches('button, input') ? target : (target.querySelector && target.querySelector('button[type="submit"], button[name="add"]')) || target;
    toast(anchor, msg);
  }
  var toastEl = null, toastTimer = null;
  function toast(anchor, msg) {
    if (!toastEl) {
      toastEl = document.createElement('div');
      toastEl.setAttribute('role', 'alert');
      toastEl.style.cssText = 'position:fixed;z-index:99999;background:#fff;color:#444;font:500 15px/1.3 inherit;font-family:inherit;padding:14px 20px;border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.22);text-align:center;max-width:90vw;pointer-events:none;transform:translate(-50%,-50%);transition:opacity .25s';
      document.body.appendChild(toastEl);
    }
    var r = anchor.getBoundingClientRect();
    toastEl.textContent = msg;
    toastEl.style.left = (r.left + r.width / 2) + 'px';
    toastEl.style.top = (r.top + r.height / 2) + 'px';
    toastEl.style.opacity = '1'; toastEl.style.display = 'block';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () {
      toastEl.style.opacity = '0';
      setTimeout(function () { toastEl.style.display = 'none'; }, 260);
    }, 2500);
  }
  document.addEventListener('submit', function (e) { blockIfNoResult(e, e.target); }, true);
  // Veel thema's versturen via een klik op de knop (zonder gewone submit); die vangen we ook af.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('button[type="submit"], button[name="add"], input[type="submit"]');
    if (btn) blockIfNoResult(e, btn);
  }, true);
  }
  document.querySelectorAll('[data-hw-ai]').forEach(function (r, i) { initOne(r, i); });
})();
</script>
{%- endif -%}

{%- comment -%}
  AI-foto blok voor de productpagina (Custom Liquid).
  Pas alleen de twee regels hieronder aan:
    hw_ai_api     = het adres van jullie AI-foto service
    hw_ai_profile = 'tegel' (vierkant) of 'poster' (7:5, klant kiest liggend/staand)
{%- endcomment -%}
{%- assign hw_ai_api = 'https://ai-foto.JOUWDOMEIN.nl' -%}
{%- assign hw_ai_profile = 'tegel' -%}

<div class="hw-ai" data-hw-ai data-api="{{ hw_ai_api }}" data-profile="{{ hw_ai_profile }}" data-product="{{ product.handle }}">
  <div class="hw-ai-title">Maak er een kunstwerk van met AI</div>
  <div class="hw-ai-sub">Upload je foto, kies een ontwerp en bekijk meteen het resultaat.</div>

  <div class="hw-ai-designs" data-hw-ai-designs></div>

  <div class="hw-ai-orient" data-hw-ai-orient hidden>
    <label><input type="radio" name="hw-ai-orient" value="landscape" checked> Liggend</label>
    <label><input type="radio" name="hw-ai-orient" value="portrait"> Staand</label>
  </div>

  <label class="hw-ai-upload">
    <input type="file" accept="image/*" data-hw-ai-file hidden>
    <span data-hw-ai-filelabel>Kies een foto</span>
  </label>

  <button type="button" class="hw-ai-btn" data-hw-ai-go disabled>Maak mijn afbeelding</button>
  <div class="hw-ai-status" data-hw-ai-status role="status" aria-live="polite"></div>
  <div class="hw-ai-result" data-hw-ai-result hidden>
    <img data-hw-ai-img alt="Jouw AI-afbeelding">
    <div class="hw-ai-ok">Mooi! Deze afbeelding wordt op je product gedrukt.</div>
  </div>
</div>

<style>
  .hw-ai{font-family:inherit;font-size:12px;color:#000;border:1px solid #D7D7D7;border-radius:20px;background:#F6F6F6;padding:12px;margin:0 0 .5rem}
  .hw-ai-title{font-size:14px;font-weight:600}
  .hw-ai-sub{opacity:.75;margin:2px 0 10px}
  .hw-ai-designs{display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:8px;margin-bottom:10px}
  .hw-ai-design{border:2px solid transparent;border-radius:12px;background:#fff;padding:4px;cursor:pointer;text-align:center;font:inherit;color:inherit}
  .hw-ai-design img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;display:block;background:#eaeaea}
  .hw-ai-design span{display:block;margin-top:4px;font-size:11px;line-height:1.2}
  .hw-ai-design[aria-pressed="true"]{border-color:#000}
  .hw-ai-orient{display:flex;gap:14px;margin-bottom:10px}
  .hw-ai-upload{display:block;border:1px dashed #999;border-radius:12px;padding:12px;text-align:center;cursor:pointer;background:#fff;margin-bottom:10px}
  .hw-ai-btn{width:100%;border:0;border-radius:999px;background:#000;color:#fff;padding:11px;font:inherit;font-weight:600;cursor:pointer}
  .hw-ai-btn:disabled{opacity:.4;cursor:not-allowed}
  .hw-ai-status{margin-top:8px;min-height:1em}
  .hw-ai-status.err{color:#b00020}
  .hw-ai-result{margin-top:10px;text-align:center}
  .hw-ai-result img{max-width:100%;border-radius:12px;display:block;margin:0 auto 6px}
  .hw-ai-ok{opacity:.75}
</style>

<script>
(function () {
  var root = document.querySelector('[data-hw-ai]');
  if (!root) return;
  var API = (root.dataset.api || '').replace(/\/$/, '');
  var PROFILE = root.dataset.profile === 'poster' ? 'poster' : 'tegel';
  var $ = function (s) { return root.querySelector(s); };
  var designsEl = $('[data-hw-ai-designs]'), fileEl = $('[data-hw-ai-file]'), fileLabel = $('[data-hw-ai-filelabel]');
  var goBtn = $('[data-hw-ai-go]'), statusEl = $('[data-hw-ai-status]'), resultEl = $('[data-hw-ai-result]');
  var imgEl = $('[data-hw-ai-img]'), orientEl = $('[data-hw-ai-orient]');
  var state = { design: null, designName: '', result: null, busy: false, left: null };
  if (PROFILE === 'poster') orientEl.hidden = false;

  var clientId;
  try { clientId = localStorage.getItem('hw_ai_client'); } catch (e) {}
  if (!clientId) {
    clientId = 'c' + Math.random().toString(36).slice(2) + Date.now().toString(36);
    try { localStorage.setItem('hw_ai_client', clientId); } catch (e) {}
  }

  function say(t, err) { statusEl.textContent = t || ''; statusEl.className = 'hw-ai-status' + (err ? ' err' : ''); }
  function refresh() { goBtn.disabled = state.busy || !state.design || !fileEl.files[0] || state.left === 0; }

  function getForms() {
    var f = document.querySelectorAll('.product-form .form');
    if (f.length) return f;
    var fb = document.querySelector('form[data-type="add-to-cart-form"]');
    return fb ? [fb] : [];
  }
  function setProps(on) {
    getForms().forEach(function (form) {
      form.querySelectorAll('[data-hw-ai-prop]').forEach(function (el) { el.remove(); });
      if (!on) return;
      var props = {
        'properties[AI afbeelding]': state.result.preview_url,
        'properties[AI ontwerp]': state.designName,
        'properties[_AI drukbestand]': state.result.print_url
      };
      Object.keys(props).forEach(function (name) {
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = name; i.value = props[name];
        i.setAttribute('data-hw-ai-prop', '');
        form.appendChild(i);
      });
    });
  }

  fetch(API + '/api/designs?product=' + encodeURIComponent(root.dataset.product || ''))
    .then(function (r) { return r.json(); })
    .then(function (d) {
      state.left = null;
      (d.designs || []).forEach(function (x) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'hw-ai-design'; b.setAttribute('aria-pressed', 'false');
        if (x.example_url) { var im = document.createElement('img'); im.src = x.example_url; im.alt = ''; im.loading = 'lazy'; b.appendChild(im); }
        var s = document.createElement('span'); s.textContent = x.name; b.appendChild(s);
        b.addEventListener('click', function () {
          designsEl.querySelectorAll('.hw-ai-design').forEach(function (o) { o.setAttribute('aria-pressed', 'false'); });
          b.setAttribute('aria-pressed', 'true');
          state.design = x.id; state.designName = x.name; refresh();
        });
        designsEl.appendChild(b);
      });
      if (!(d.designs || []).length) root.hidden = true;
    })
    .catch(function () { root.hidden = true; });

  fileEl.addEventListener('change', function () {
    fileLabel.textContent = fileEl.files[0] ? fileEl.files[0].name : 'Kies een foto';
    refresh();
  });

  function poll(id) {
    fetch(API + '/api/jobs/' + id).then(function (r) { return r.json(); }).then(function (j) {
      if (j.attempts_left !== undefined) state.left = j.attempts_left;
      if (j.status === 'done') {
        state.busy = false;
        state.result = { preview_url: j.preview_url, print_url: j.print_url };
        imgEl.src = j.preview_url; resultEl.hidden = false; setProps(true);
        say(state.left > 0 ? 'Niet tevreden? Je kunt het nog ' + state.left + ' keer opnieuw proberen.' : '');
        refresh();
      } else if (j.status === 'error') {
        state.busy = false; say(j.error || 'Mislukt, probeer het opnieuw.', true); refresh();
      } else { setTimeout(function () { poll(id); }, 2000); }
    }).catch(function () { setTimeout(function () { poll(id); }, 3000); });
  }

  goBtn.addEventListener('click', function () {
    if (state.busy || !fileEl.files[0] || !state.design) return;
    state.busy = true; state.result = null; resultEl.hidden = true; setProps(false); refresh();
    say('Je afbeelding wordt gemaakt… dit duurt ongeveer 20 tot 60 seconden.');
    var o = root.querySelector('input[name="hw-ai-orient"]:checked');
    var fd = new FormData();
    fd.append('photo', fileEl.files[0]); fd.append('design_id', state.design);
    fd.append('profile', PROFILE); fd.append('orientation', o ? o.value : 'landscape'); fd.append('client_id', clientId);
    fetch(API + '/api/generate', { method: 'POST', body: fd })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (!x.ok) { state.busy = false; if (x.j.attempts_left === 0) state.left = 0; say(x.j.error || 'Mislukt', true); refresh(); return; }
        state.left = x.j.attempts_left; poll(x.j.job_id);
      })
      .catch(function () { state.busy = false; say('Geen verbinding, probeer het opnieuw.', true); refresh(); });
  });

  // Zonder resultaat niet in de winkelwagen: anders krijgen we een bestelling zonder afbeelding.
  document.addEventListener('submit', function (e) {
    if (root.hidden || state.result) return;
    if (!e.target.closest || !e.target.closest('.product-form, form[data-type="add-to-cart-form"]')) return;
    e.preventDefault(); e.stopImmediatePropagation();
    say('Maak eerst je afbeelding voordat je bestelt.', true);
    root.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, true);
})();
</script>
